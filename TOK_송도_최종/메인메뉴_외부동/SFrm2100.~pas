unit SFrm2100;

interface

uses
  Windows, Messages, SysUtils, Classes, Graphics, Controls, Forms,
  Dialogs, StdCtrls, Mask, Buttons, ExtCtrls, DB, ADODB, ComCtrls, DBTables;

type
  TSFrm_2100 = class(TForm)
    Panel1: TPanel;
    Shape1: TShape;
    TitleLbl: TLabel;
    Panel2: TPanel;
    Label2: TLabel;
    Label8: TLabel;
    MesgStsBar: TStatusBar;
    NameEdit: TEdit;
    MastUpdateQuery: TADOQuery;
    Label4: TLabel;
    Label5: TLabel;
    Label6: TLabel;
    CaseEdit: TEdit;
    ConfirmBitBtn: TBitBtn;
    Label1: TLabel;
    GubnCB: TComboBox;
    Label3: TLabel;
    MaterCB: TComboBox;
    Label9: TLabel;
    Label10: TLabel;
    HotCB: TComboBox;
    BigoEdit: TEdit;
    ExitBitBtn: TBitBtn;
    PieEdit: TEdit;
    Query1: TADOQuery;
    CodeEdit: TMaskEdit;
    UnitCB: TComboBox;

    procedure ConfirmBitBtnClick(Sender: TObject);
    procedure ExitBitBtnClick(Sender: TObject);
    procedure FormClose(Sender: TObject; var Action: TCloseAction);
    procedure FormDestroy(Sender: TObject);
    procedure FormCreate(Sender: TObject);
    procedure GubnCBChange(Sender: TObject);
    procedure MaterCBChange(Sender: TObject);
    procedure PieEditChange(Sender: TObject);
    procedure HotCBChange(Sender: TObject);

  private
    { Private declarations }
    procedure Insert_Code;
    procedure Cntl_MaterSelect_proc;

  public
    { Public declarations }
    Bol_insert : Boolean;
    Bol_Update : Boolean;
    Bol_Delete : Boolean;
  end;

var
  SFrm_2100: TSFrm_2100;
  var_sql, s_user : String;
  sys_datetime  : string[14];
  s_date : string[8];
  s_time : string[6];


implementation

uses DBSet,WinLib, FrmPrompt, FrmError, Frm2100;

{$R *.dfm}


procedure TSFrm_2100.FormCreate(Sender: TObject);
begin
   Cntl_MaterSelect_proc;
   MaterCB.ItemIndex := -1;
end;

procedure TSFrm_2100.Cntl_MaterSelect_proc;
begin
  MaterCB.Items.Clear;
  Query1.Close;
  Query1.SQL.Clear;
  Query1.SQL.Add(' select Matter_code, Matter_Name from MatterKind ');
  Query1.Open;
  Query1.First;

  While True do
  begin
    if Query1.Eof = True then break;
    MaterCB.Items.Add(Query1.Fields[0].AsString + '-' + Query1.Fields[1].AsString);
    Query1.Next;
  end;
end;

procedure TSFrm_2100.ConfirmBitBtnClick(Sender: TObject);
var
  var_Msg : String;
begin
   var_Msg := ' 정말로 확정 합니까.?';
  if WinLib_ConfirmForm( var_Msg ) then
  begin

      IF CodeEdit.Text = '' then
      Begin
         WinLib_ErrorForm('제품코드를 입력 하십시요.');
         CodeEdit.SetFocus;
         Exit;
      End;

      IF Length(CodeEdit.Text) < 11 then
      Begin
         WinLib_ErrorForm('제품코드를 다시 입력 하십시요.');
         CodeEdit.SetFocus;
         Exit;
      End;

      IF GubnCB.Text = '' then
      Begin
         WinLib_ErrorForm('종류를 입력 하십시요.');
         GubnCB.SetFocus;
         Exit;
      End;

      IF MaterCB.Text = '' then
      Begin
         WinLib_ErrorForm('재질을 입력 하십시요.');
         MaterCB.SetFocus;
         Exit;
      End;

      IF PieEdit.Text = '' then
      Begin
         WinLib_ErrorForm('소재경을 입력 하십시요.');
         PieEdit.SetFocus;
         Exit;
      End;

      IF Length(PieEdit.Text) < 4 then
      Begin
         WinLib_ErrorForm('소재경 4자리를 입력 하십시요.');
         PieEdit.SetFocus;
         Exit;
      End;

      IF HotCB.Text = '' then
      Begin
         WinLib_ErrorForm('열처리를 입력 하십시요.');
         HotCB.SetFocus;
         Exit;
      End;

      IF NameEdit.Text = '' then
      Begin
         WinLib_ErrorForm(' 품명을 입력 하십시요.');
         NameEdit.SetFocus;
         Exit;
      End;

      IF UnitCB.Text = '' then
      Begin
         WinLib_ErrorForm(' 단위를 입력 하십시요.');
         UnitCB.SetFocus;
         Exit;
      End; 

    Insert_Code;
    Close;
  end;
end;

procedure TSFrm_2100.Insert_Code;
var
   ls_gubn, ls_mater, ls_hot : String;
begin
   ls_gubn  := Trim(copy(GubnCB.Text,3,18));
   ls_mater := Trim(copy(MaterCB.Text,4,17));
   ls_hot   := Trim(copy(HotCB.Text,3,18));


  var_sql := ' Insert Into MIMAST(MAST_CODE, MAST_GUBN, MAST_NAME, MAST_SPEC, ';
  var_sql := var_sql + '   MAST_UNIT, MAST_MATER, MAST_CASE, MAST_PIE, ';
  var_sql := var_sql + '   MAST_HOT, MAST_BIGO, MAST_DATE )';
  var_sql := var_sql + ' Values('''+CodeEdit.Text+''', '''+ls_gubn+''', '''+NameEdit.Text+''', ';
  var_sql := var_sql + '  '''', '''+UnitCB.Text+''', '''+ls_mater+''', '''+CaseEdit.Text+''', ';
  var_sql := var_sql + '        '''+PieEdit.Text+''', '''+ls_hot+''', '''+BigoEdit.Text+''', ';
  var_sql := var_sql + '        getdate() )';
  With MastUpdateQuery Do
    Try
      Close;
      SQL.Clear;
      SQL.Add( var_sql );
      ExecSql;
    Except
      Begin
         WinLib_ErrorForm('제품 코드 ' + CodeEdit.Text + ' 등록 에러!!!! ');
         Exit;
      End;
    End;
    MesgStsBar.SimpleText := '제품 코드 ' + CodeEdit.Text + '를 등록 하였습니다...';
end;

procedure TSFrm_2100.ExitBitBtnClick(Sender: TObject);
begin
  Close;
end;

procedure TSFrm_2100.FormClose(Sender: TObject; var Action: TCloseAction);
begin
  Action := caFree;
end;

procedure TSFrm_2100.FormDestroy(Sender: TObject);
begin
  SFrm_2100 := Nil;
end;


procedure TSFrm_2100.GubnCBChange(Sender: TObject);
var
   ls_code : String;
begin
    ls_code :=  copy(GubnCB.Text,1,1);
    CodeEdit.Text := ls_code;
end;

procedure TSFrm_2100.MaterCBChange(Sender: TObject);
var
   ls_code : String;
begin
    ls_code :=  copy(GubnCB.Text,1,1);
    ls_code :=  ls_code + copy(MaterCB.Text,1,2);
    CodeEdit.Text := ls_code;
    NameEdit.Text := copy(MaterCB.Text,4,9);
end;

procedure TSFrm_2100.PieEditChange(Sender: TObject);
var
   ls_code : String;
begin
   ls_code :=  copy(GubnCB.Text,1,1);
   ls_code :=  ls_code + copy(MaterCB.Text,1,2);
   ls_code :=  ls_code + copy(PieEdit.Text,1,4);
   CodeEdit.Text := ls_code;
end;

procedure TSFrm_2100.HotCBChange(Sender: TObject);
var
   ls_code : String;
begin
   ls_code :=  copy(GubnCB.Text,1,1);
   ls_code :=  ls_code + copy(MaterCB.Text,1,2);
   ls_code :=  ls_code + copy(PieEdit.Text,1,4);
   ls_code :=  ls_code + copy(HotCB.Text,1,1);
   CodeEdit.Text := ls_code;
end;

end.

