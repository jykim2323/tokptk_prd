       // sStatus는 '0'으로 두어 ReservedSBClick에서 (Update or Insert) 분기 처리하도록 함
       sStatus := '0'; 
    end
    else
    begin
       // [차단] 그리드가 비어있거나 다른 PLTNO인데, DB에 있는 PLTNO를 입력함 (덮어쓰기 위험)
