  StrQry := 'SELECT MAST_NAME FROM MIMAST (NOLOCK) WHERE MAST_CODE = ''' + Trim(ItnbrEdit.Text) + ''' ';
  With Query2 Do Begin
    Close;
    SQL.Clear;
