    sDbLoca := Trim(FieldByName('LOCA').AsString);
  End;

  // [Case A] DB에 데이터가 존재하는 경우
  if li_cnt > 0 then 
  begin
    // A-1. 이미 랙에 적재된 경우 -> 무조건 차단
