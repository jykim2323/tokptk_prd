   // 1. 에디트 박스 채우기 (기존 동일)
   pltNoEdit.Text   := Query1.FieldByName('OUPT_PLTNO').AsString;
   ItnbrEdit.Text   := Query1.FieldByName('OUPT_CODE').AsString;
   NameEdit.Text    := Query1.FieldByName('MAST_NAME').AsString;
