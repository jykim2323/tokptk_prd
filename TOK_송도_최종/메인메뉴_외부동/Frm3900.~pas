procedure TFrm_3900.InResGrid_Clear_Proc;
var
  IntCnt, i : Integer;
begin
  With InResGrid Do Begin
    // 1행부터 마지막 행까지
    For IntCnt := 1 to RowCount - 1 do Begin
      // 모든 컬럼(0~ColCount-1) 데이터 삭제
