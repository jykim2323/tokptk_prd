procedure TFrm_3400.FormCreate(Sender: TObject);
begin

  if (jj_kind <> '50') then
  begin
    DeleteBitBtn.Visible    := False;   
  end;

  Top  := (Screen.Height - Self.Height) div 2;
  Left := (Screen.Width - Self.Width) div 2;

  FromDate.Date := Now;   ToDate.Date := Now;

  SeltCB.ItemIndex := 0;
  StartBitBtnClick(Self);
end;

procedure TFrm_3400.StartBitBtnClick(Sender: TObject);
begin
  StrDate1 := FormatDateTime('yyyymmdd', FromDate.Date);
  StrDate2 := FormatDateTime('yyyymmdd', ToDate.Date);

  var_Sql := ' Select INPT_INDATE, INPT_INDEX,  INPT_CODE, MAST_NAME, INPT_LOTNO,  ';
  var_Sql := var_Sql + ' INPT_WEIGHT,  INPT_LOCA,  INPT_STATION, INPT_REMARK, INPT_BOXNO,';
  var_Sql := var_Sql + ' INPT_STIME,  INPT_ETIME,  INPT_HOGI, INPT_JOB_FLAG,  INPT_RFLAG, INPT_RDATE, INPT_RTIME, INPT_OINDEX, INPT_ID, INPT_PLTNO   ';
  var_Sql := var_Sql + ' From T2MIINPT (NOLOCK) ';
  var_Sql := var_Sql + ' LEFT OUTER JOIN MIMAST (NOLOCK) ON MAST_CODE = INPT_CODE '; 
  var_Sql := var_Sql + ' Where INPT_JOB_FLAG <> ''0'' And INPT_CODE <> ''EMPTY''  ';
  var_Sql := var_Sql + '   And  INPT_INDATE >= '''+StrDate1+'''  And INPT_INDATE <= '''+StrDate2+''' ';

  if (SelRg.ItemIndex  = 1) then  var_Sql := var_Sql + '  And INPT_RFLAG   = ''N'' '  
  else if (SelRg.ItemIndex  = 2) then var_Sql := var_Sql + '  And INPT_RFLAG   = ''R''';

  if  SeltCB.ItemIndex = 1      then   begin
      var_Sql := var_Sql + '  And INPT_HOGI  = '''+itemCB.Text+''' ';
      var_Sql := var_Sql + '   Order by  INPT_CODE,  INPT_INDEX    '
  end
  else if  SeltCB.ItemIndex = 2      then   begin
      //var_Sql := var_Sql + '  And INPT_CODE  LIKE '''+itemCB.Text+'%'' ';
      var_Sql := var_Sql + '  And INPT_CODE = '''+Trim(itemCB.Text)+''' ';
      var_Sql := var_Sql + '   Order by  INPT_CODE,  INPT_INDEX    '
  end
  else if  SeltCB.ItemIndex = 3      then   begin
      var_Sql := var_Sql + '  And MAST_NAME  LIKE ''%'+itemCB.Text+'%'' ';
      var_Sql := var_Sql + '   Order by  INPT_CODE,  INPT_INDEX    '
  end
  else if SeltCB.ItemIndex = 4  then   begin
      var_Sql := var_Sql + '  And INPT_LOTNO   = '''+itemCB.Text+''' ';
      var_Sql := var_Sql + '   Order by  INPT_LOTNO,  INPT_INDEX    '
  end
  else if SeltCB.ItemIndex = 5 then begin
      var_Sql := var_Sql + ' And INPT_PLTNO = '''+itemCB.Text+''' ';
      var_Sql := var_Sql + '   Order by INPT_PLTNO, INPT_INDEX      '
  end
  else
  begin
      var_Sql := var_Sql + '   Order by  INPT_INDEX,  INPT_CODE  ';
  end;
  
  with Query1 Do Begin
    Close;
    SQL.Clear;
    SQL.Add(var_Sql);
    Open;
  end;
  RecNoEdit.Text := Format('%d',[Query1.RecordCount]);
end;

