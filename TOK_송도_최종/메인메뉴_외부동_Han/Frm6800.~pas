procedure TFrm_6800.StockSGGetAlignment(Sender: TObject; ARow,
  ACol: Integer; var HAlign: TAlignment; var VAlign: TVAlignment);
begin
    if ARow = 0 then // Title부분은 전부 중앙정렬한다.
        HAlign := taCenter
    else begin

    if ACol in [3..33] then // 숫자값이 들어있는 번 Field의 데이터는 오른쪽으로 정렬한다.
        HAlign := taRightJustify
    else if ACol in [1] then HAlign := taCenter
    else // 나머지는 왼쪽으로 정렬한다.
        HAlign := taLeftJustify;
    end;
end;

