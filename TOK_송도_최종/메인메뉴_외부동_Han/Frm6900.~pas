        DrawFrameControl(AdvSGrid.Canvas.Handle, CheckRect, DFC_BUTTON, DFCS_BUTTONCHECK or DFCS_CHECKED)
      else
        DrawFrameControl(AdvSGrid.Canvas.Handle, CheckRect, DFC_BUTTON, DFCS_BUTTONCHECK);
