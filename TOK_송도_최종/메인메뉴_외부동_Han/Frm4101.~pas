procedure TFrm_4101.ExlBtnClick(Sender: TObject);
var
 v : Variant ;
 iRow, iCol, eRow : integer ;
 CNT : integer;
 lf_time, lf_Min  : Real;
 ls_time, ls_min, ls_hhmm : String;

 ss_time, ls_seq : String;

 li_line, li_Seqno, li_model, li_VehNum, li_Ocn, li_Nation : Integer;
 li_Grade, li_Seat, li_Date, li_Time, li_Line2 : Integer;

begin

  If StringGrid1.Cells[1, 1] <> '' Then Exit;

  if Length(Trim(LineEd.Text)) = 0   then  exit;
  li_line   := StrToInt(Trim(LineEd.Text));

  try
      v:= CreateOleObject('Excel.application');
  except
     ShowMessage('Excel Not Install');
     Exit;
 end;

 IF OpenDialog1.Execute then
 begin
 v.WorkBooks.open(OpenDialog1.FileName);
 end
 else Exit;

 cnt := strToint(v.ActiveSheet.UsedRange.Rows.Count);

// SHOWMESSAGE(intTostr(cnt));

 StringGrid1.RowCount := cnt;

 For iRow := 1 to cnt do
 begin

     eRow := iRow + li_line;


     If Trim(v.cells[eRow, 3]) = '' Then
     begin
       Break;
     end
     else StringGrid1.Cells[2 , iRow] := Trim(v.cells[eRow, 3]);


     StringGrid1.Cells[1 , iRow] := IntToStr(iRow);
//     StringGrid1.Cells[2, iRow] := '2222';
//     StringGrid1.Cells[2 , iRow] := Trim(v.cells[eRow, 3]);
     StringGrid1.Cells[3 , iRow] := Trim(v.cells[eRow, 4]);
     StringGrid1.Cells[4 , iRow] := Trim(v.cells[eRow, 8]);
     StringGrid1.Cells[5 , iRow] := Trim(v.cells[eRow, 5]);
     StringGrid1.Cells[6 , iRow] := Trim(v.cells[eRow, 11]);
     StringGrid1.Cells[7 , iRow] := Trim(v.cells[eRow, 14]);
     StringGrid1.Cells[8 , iRow] := Trim(v.cells[eRow, 15]);
 end;

// Edit1.Text:= ('Total = ' + IntTostr(Cnt - 1) + ' 엑셀 데이터.');
  Edit1.Text:= ('Total = ' + IntToStr(iRow -1) + ' 엑셀 데이터.');

 V.WorkBooks.Close;
 V.quit ;
 V:=unassigned;
// ShowMessage('Load Complited To Excel.');
end;

procedure TFrm_4101.UpdateBitBtnClick(Sender: TObject);
var
 MRow, i_seq, i, int_cnt, Plt_Qty, j, k : integer ;
 var_sql, sys_date, ls_Seq, StrChasu, stat_date : String;
 ls_Qty, ls_item, ls_jdate, ls_seqno, ls_lotno, ls_date, ls_time : String;
 ls_cust, ls_boxno, ls_remark : String;
begin

 if MessageDlg('출고 지시에 등록합니까  ?', mtConfirmation, [mbYes, mbNo], 0) = mrNo then  Exit;

 if MessageDlg('기존출고지시 데이터는 전부 삭제 됩니다..  ?', mtConfirmation, [mbYes, mbNo], 0) = mrNo then  Exit;

  //   Var_Sql := ' TRUNCATE TABLE T2HHOUPT ';
   Var_Sql := ' DELETE  FROM T2HHOUPT ';
   Try
        UpdtQuery.Close;
        UpdtQuery.SQL.Clear;
        UpdtQuery.SQL.Add(Var_Sql);
        UpdtQuery.ExecSQL;
   Except
       ShowMessage('출고지시데이터 삭제에러 = ' + Var_Sql );   exit;
   End;


 int_cnt := 0;       

 sys_date := f_get_sysdate_time1();
 ls_date := Copy(sys_date,1,8);
 ls_time := Copy(sys_date,9,6);


  var_sql := ' Select STAT_CDATE, STAT_CINDX  From T2TBSTAT (NOLOCK) Where STAT_PSWD = ''JPLS'' ';
  Query2.Close;
  Query2.SQL.Clear;
  Query2.SQL.Add(var_sql);
  Query2.Open;

  stat_date  :=  Query2.FieldByName('STAT_CDATE').AsString;

  if  (ls_date = stat_date)  then
  begin
     StrChasu :=  Format('%3.3d', [Query2.FieldByName('Stat_CINDX').AsInteger]);
     if Query2.FieldByName('STAT_CINDX').AsInteger >= 998 Then Begin
           var_sql := ' Update T2TBSTAT Set STAT_CINDX = convert(Numeric,''1'') ';
     End Else Begin
         var_sql := ' Update T2TBSTAT Set STAT_CINDX = STAT_CINDX + 1 ';
     End;
     var_sql := var_sql + ' Where STAT_PSWD = ''JPLS'' ';
  end
  else
  begin
      StrChasu :=  Format('%3.3d', [1]);
      var_sql := ' Update T2TBSTAT Set STAT_CDATE = '''+ls_date+''', STAT_CINDX = convert(Numeric,''2'') ';
      var_sql := var_sql + ' Where STAT_PSWD = ''JPLS'' ';
  end;

  UpdtQuery.Close;
  UpdtQuery.SQL.Clear;
  UpdtQuery.SQL.Add(var_sql);
  UpdtQuery.ExecSQL;     


 For MRow := 1 to StringGrid1.RowCount  do
 begin
     If StringGrid1.Cells[2, MRow] = '' Then Break;

     ls_Seq     := Trim(StringGrid1.cells[1, MRow]);
     ls_item    := Trim(StringGrid1.cells[2, MRow]);
     ls_lotno   := Trim(StringGrid1.cells[4, MRow]);
     ls_Qty     := Trim(StringGrid1.cells[5, MRow]);
     While Pos(',', ls_Qty) > 0  Do Begin Delete(ls_Qty, Pos(',', ls_Qty), 1); End;
     if Length(trim(ls_Qty)) = 0  then  ls_Qty := '0';

     ls_cust     := Trim(StringGrid1.cells[6, MRow]);
     ls_boxno    := Trim(StringGrid1.cells[7, MRow]);
     ls_remark   := Trim(StringGrid1.cells[8, MRow]);

     Try

        var_sql := ' Select * from T2HHOUPT (NOLOCK) Where HO_DATE = '''+ls_date+''' And HO_CODE = '''+ls_item+''' ';
        var_sql := var_sql + '   And HO_LOTNO     =  '''+ls_lotno+''' And HO_CUST   =  '''+ls_cust+''' ';

        Query2.Close;
        Query2.SQL.Clear;
        Query2.SQL.Add(var_sql);
        Query2.Open;
        if  Query2.RecordCount = 0  then
       begin
           var_sql :=  'Insert Into T2HHOUPT( HO_DATE, HO_CHASU, HO_CODE, HO_LOTNO, HO_CUST,  HO_QTY,  HO_BOXNO, HO_REMARK, HO_TIME   ) ';
           var_sql := var_sql +  ' Values(  '''+ls_date+''', '''+StrChasu+''',   '''+ls_item+''', '''+ls_lotno+''', '''+ls_cust+''', ';
           var_sql := var_sql +  '           '''+ls_qty+''', '''+ls_boxno+''', '''+ls_remark+''', '''+ls_time+''' ) ';
       end
       else
       begin
          var_sql := ' Update T2HHOUPT Set HO_QTY  = ISNULL(HO_QTY,0) +  Convert(Numeric,'''+ls_Qty+''')  ';
          var_sql := var_sql + ' Where HO_DATE = '''+ls_date+'''  ';
          var_sql := var_sql + '   And HO_CODE  = '''+ls_item+''' And HO_LOTNO = '''+ls_lotno+''' And HO_CUST  =  '''+ls_cust+''' ';
       end;

       with Query2 do
       begin
              Close;
              Sql.Clear;
              Sql.Add(var_sql);
              ExecSql;
              INC(int_cnt);
        end;
     Except
         Edit1.Text:= ('등록에러 = ' +  ls_lotno);
         Memo1.Lines.Add(var_sql);        
     End;
 end; //Row For End
 DeleteBitBtnClick(Self);
 ShowMessage('출고지시 등록 건수 ' + '[' + StrChasu + ']' + '= ' + IntToStr(int_cnt));
 Memo1.Lines.Add('출고지시 등록 건수 ' + '  차수  [' + StrChasu + ']' + '= ' + IntToStr(int_cnt));
end;


