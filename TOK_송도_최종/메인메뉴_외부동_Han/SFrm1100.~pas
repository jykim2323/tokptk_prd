function TSFrm_1100.StringConvert(str: string): string;
var
 I: Integer;
 stemp : string;
begin
 stemp := str;
 for I := Length(stemp) downto 1 do
 if stemp[I] = '''' then Insert('''', stemp, I);
 Result := stemp;
end;



