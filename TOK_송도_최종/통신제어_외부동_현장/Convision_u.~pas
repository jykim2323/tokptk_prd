function Con_Read(Buf: String): String;
var
  li_data, li_data1, li_data2 : Integer;
  ls_data1, ls_data2 : String[1];
begin

 if  buf = '0000'   then  begin Con_Read := '0000';  exit;  end; 

 ls_data1 := Copy(buf, 3, 1);
 ls_data2 := Copy(buf, 4, 1);  

 if         ls_data1 = '0' then   li_data1 := 0
 else if    ls_data1 = '1' then   li_data1 := 1
 else if    ls_data1 = '2' then   li_data1 := 2
 else if    ls_data1 = '3' then   li_data1 := 3
 else if    ls_data1 = '4' then   li_data1 := 4
 else if    ls_data1 = '5' then   li_data1 := 5
 else if    ls_data1 = '6' then   li_data1 := 6
 else if    ls_data1 = '7' then   li_data1 := 7
 else if    ls_data1 = '8' then   li_data1 := 8
 else if    ls_data1 = '9' then   li_data1 := 9
 else if    ls_data1 = 'A' then   li_data1 := 10
 else if    ls_data1 = 'B' then   li_data1 := 11
 else if    ls_data1 = 'C' then   li_data1 := 12
 else if    ls_data1 = 'D' then   li_data1 := 13
 else if    ls_data1 = 'E' then   li_data1 := 14
 else if    ls_data1 = 'F' then   li_data1 := 15
 else li_data1 := 0;

 li_data1 := li_data1 * 16;

 if         ls_data2 = '0' then   li_data2 := 0
 else if    ls_data2 = '1' then   li_data2 := 1
 else if    ls_data2 = '2' then   li_data2 := 2
 else if    ls_data2 = '3' then   li_data2 := 3
 else if    ls_data2 = '4' then   li_data2 := 4
 else if    ls_data2 = '5' then   li_data2 := 5
 else if    ls_data2 = '6' then   li_data2 := 6
 else if    ls_data2 = '7' then   li_data2 := 7
 else if    ls_data2 = '8' then   li_data2 := 8
 else if    ls_data2 = '9' then   li_data2 := 9
 else if    ls_data2 = 'A' then   li_data2 := 10
 else if    ls_data2 = 'B' then   li_data2 := 11
 else if    ls_data2 = 'C' then   li_data2 := 12
 else if    ls_data2 = 'D' then   li_data2 := 13
 else if    ls_data2 = 'E' then   li_data2 := 14
 else if    ls_data2 = 'F' then   li_data2 := 15
 else li_data2 := 0;

 li_data := li_data1 + li_data2;

 Con_Read := Format('%4.4d', [li_data]);

end;  {* The End of  *}
