// 8,4,2,1
function StrToAscDigit(Buf: PChar; PSource: PChar; Count: Integer): Integer;
var
  Value: Char;
  Str: String[4];
  i, j: Integer;
begin
  if Count < 1 then
  begin
    StrToAscDigit := 1;
    exit;
  end;

  for i := 1 to Count do
  begin
    Str := '0000';
    Value  := PSource^;

    case Value of
      '0': Str := '0000';
      '1': Str := '0001';
      '2': Str := '0010';
      '3': Str := '0011';
      '4': Str := '1000';
      '5': Str := '0101';
      '6': Str := '0110';
      '7': Str := '0111';
      '8': Str := '1000';
      '9': Str := '1001';
      'A': Str := '1010';
      'B': Str := '1011';
      'C': Str := '1100';
      'D': Str := '1101';
      'E': Str := '1110';
      'F': Str := '1111';
    else
      begin
        Str := '0000';
        StrToAscDigit := 1;
        exit;
      end;
    end;

    for j := 1 to 4 do
    begin
      Buf^ := Str[j];
      Inc(Buf);
    end;
    Inc(PSource);
  end;

  StrToAscDigit := 0;
end;  {* The End of StrToAscDigit() *}

