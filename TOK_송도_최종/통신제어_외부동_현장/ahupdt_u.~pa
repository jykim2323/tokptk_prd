    cv_no := '84'; //출고 WS/NO Tracking Data Select
    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select trak_boxid from tbtrak where trak_no = '''+cv_no+''' ');
    ahcomm_f.Query2.Open;
    o_trk6 := ahcomm_f.Query2.Fields[0].AsString;

    cv_no := '47'; //출고 WS/NO Tracking Data Select
    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select trak_boxid from tbtrak where trak_no = '''+cv_no+''' ');
    ahcomm_f.Query2.Open;
    o_trk5 := ahcomm_f.Query2.Fields[0].AsString;

    cv_no := '85'; //출고 WS/NO Tracking Data Select
    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select trak_boxid from tbtrak where trak_no = '''+cv_no+''' ');
    ahcomm_f.Query2.Open;
    o_trk4 := ahcomm_f.Query2.Fields[0].AsString;

    cv_no := '41'; //입고 WS/NO Tracking Data Select
    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select trak_boxid from tbtrak where trak_no = '''+cv_no+''' ');
    ahcomm_f.Query2.Open;
    i_trk1 := ahcomm_f.Query2.Fields[0].AsString;

    cv_no := '85'; //입고 WS/NO Tracking Data Select
    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select trak_boxid from tbtrak where trak_no = '''+cv_no+''' ');
    ahcomm_f.Query2.Open;
    i_trk4 := ahcomm_f.Query2.Fields[0].AsString;
  except
