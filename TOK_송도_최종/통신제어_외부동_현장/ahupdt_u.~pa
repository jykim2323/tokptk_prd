procedure ahsrc2_T.main_send_proc;
var
  ls_s_bk: String[01];
  ls_s_bylv: String[05];
begin
  src2_step := 20;
  send_buff := '';
  if init_start = 0 then //기동지시
  begin
    send_buff := sstart.stx + sstart.serial + sstart.mode + '00000000000000000' + sstart.etx;
    seq_no := 1;
    send_ok := 0;
    sleep(3000);
  end
  else if (init_start = 2) and (send_ok > 5) then //입출고 송신후 Rerty
  begin
    ahcomm_f.src2Edit.Text := 'SRC2->HOST Send ack not received.!!';
    send_ok := 1;

    ls_s_bk   := Copy(siojob.loc, 1, 1);
    ls_s_bylv := Copy(siojob.loc, 2, 5);
    if      (ls_s_bk = '3') then ls_s_bk := '1'
    else if (ls_s_bk = '4') then ls_s_bk := '2';

    send_buff := siojob.stx + siojob.serial + siojob.mode + siojob.scc + siojob.wsno + ls_s_bk + ls_s_bylv + '00000000' + siojob.etx;
    sleep(3000);
  end
  else if (init_start = 2) and (send_check = 2) then //입출고 송신
  begin
    send_ok := send_ok +1;

    ls_s_bk   := Copy(siojob.loc, 1, 1);
    ls_s_bylv := Copy(siojob.loc, 2, 5);
    if      (ls_s_bk = '3') then ls_s_bk := '1'
    else if (ls_s_bk = '4') then ls_s_bk := '2';
    send_buff := siojob.stx + siojob.serial + siojob.mode + siojob.scc + siojob.wsno + ls_s_bk + ls_s_bylv + '00000000' + siojob.etx;
  end
  else //작업 없을경우
  begin
    send_ok := 0;
    exit;
  end;

  send_check := 0;
  send_seq := copy(send_buff,2,2);
  send_action_proc;
end;

procedure ahsrc2_T.send_action_proc;
begin
  src2_step := 21;
  ahcomm_f.CommSrc2.Write(send_buff[1], length(send_buff));
end;

