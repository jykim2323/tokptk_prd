procedure ahsrc2_T.scrc_select_proc;
var
  s_cycle  : string;
begin
  l_step := src2_step;
  src2_step := 3;
  try
    ahcomm_f.Query2.Close; //SCRC Table Select
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select * from tbscrc where scrc_no = '''+sc_no+''' ');
    ahcomm_f.Query2.Open;
    s_scno   := ahcomm_f.Query2.Fields[0].AsString;  s_cycle   := ahcomm_f.Query2.Fields[1].AsString;
    s_ack    := ahcomm_f.Query2.Fields[2].AsString;  s_load    := ahcomm_f.Query2.Fields[3].AsString;
    s_unload := ahcomm_f.Query2.Fields[4].AsString;  s_loc     := ahcomm_f.Query2.Fields[5].AsString;
    s_wsno   := ahcomm_f.Query2.Fields[6].AsString;  s_boxid   := ahcomm_f.Query2.Fields[7].AsString;
    s_onoff  := ahcomm_f.Query2.Fields[8].AsString;  s_scplt   := ahcomm_f.Query2.Fields[9].AsString;
    s_scpos  := ahcomm_f.Query2.Fields[10].AsString; s_error   := ahcomm_f.Query2.Fields[11].AsString;
    s_reset  := ahcomm_f.Query2.Fields[12].AsString; s_errcode := ahcomm_f.Query2.Fields[13].AsString;
    s_cycle1 := copy(s_cycle,1,1);
    s_cycle2 := copy(s_cycle,2,1);
  except
    ahcomm_f.src2Edit.Text := 'STEP:3 TBSCRC Select error.!!';
  end;
  src2_step := l_step;
end;

procedure ahsrc2_T.scrc_update_proc;
var
  s_cycle : string;
begin
  l_step := src2_step;
  src2_step := 4;
  s_cycle := s_cycle1 + s_cycle2;
  try
    src2_ok := 0;
    ahcomm_f.Query2.Close; //SCRC Table Update
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add(' update tbscrc set ');
    ahcomm_f.Query2.SQL.Add(' scrc_cycle   = '''+s_cycle+''',  scrc_ack    = '''+s_ack+''', ');
    ahcomm_f.Query2.SQL.Add(' scrc_load    = '''+s_load+''',   scrc_unload = '''+s_unload+''', ');
    ahcomm_f.Query2.SQL.Add(' scrc_loc     = '''+s_loc+''',    scrc_wsno   = '''+s_wsno+''', ');
    ahcomm_f.Query2.SQL.Add(' scrc_boxid   = '''+s_boxid+''',  scrc_onoff  = '''+s_onoff+''', ');
    ahcomm_f.Query2.SQL.Add(' scrc_scplt   = '''+s_scplt+''',  scrc_scpos  = '''+s_scpos+''', ');
    ahcomm_f.Query2.SQL.Add(' scrc_error   = '''+s_error+''',  scrc_reset  = '''+s_reset+''', ');
    ahcomm_f.Query2.SQL.Add(' scrc_errcode = '''+s_errcode+''' ');
    ahcomm_f.Query2.SQL.Add(' where scrc_no = '''+sc_no+''' ');
    ahcomm_f.Query2.ExecSQL;
    ahcomm_f.src2_db.Commit;
    src2_ok := 1;
  except
    ahcomm_f.src2Edit.Text := 'STEP:4 TBSCRC Update error.!!';
  end;
  src2_step := l_step;
end;

procedure ahsrc2_T.trak_update_proc;
var
  l_boxid, l_se, l_cntl, l_iodest : string;
  l_jobqty : integer;
begin
  l_step := src2_step;
  src2_step := 5;
  if ((s_cycle1 = 'I') and (s_wsno = '01') and (s_boxid <> i_trk1)) or
     ((s_cycle1 = 'I') and (s_wsno = '04') and (s_boxid <> i_trk4)) then  //입고 Loading 완료시 Data불일치
  begin
    src2_step := l_step;
    exit;
  end;
  if (s_cycle1 = 'I') then //입고 Loading, UnLoading 완료
  begin
    if (s_wsno = '01') then cv_no := '41';
    if (s_wsno = '04') then cv_no := '85';
    l_boxid := ''; l_se := ''; l_cntl := '';
  end;

  if (s_cycle1 = 'O') then  //출고 UnLoading 완료
  begin
    if      (s_wsno = '03') then cv_no := '44'  // 세정기 1-6 출고
    else if (s_wsno = '06') then cv_no := '84'  // 공BOX 출고
    else if (s_wsno = '05') then cv_no := '47'  // 세정기 7-12 출고
    else if (s_wsno = '04') then cv_no := '85'; // 비상출고
    l_boxid := s_boxid; l_se := 'E'; l_cntl := '';

    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add (' select boxm_jobqty, boxm_iodest from miboxm where boxm_boxid = '''+s_boxid+''' ');
    ahcomm_f.Query2.Open;
    l_jobqty  := ahcomm_f.Query2.Fields[0].AsInteger;
    l_iodest  := ahcomm_f.Query2.Fields[1].AsString;
    ps_iodest := l_iodest;

    if (l_jobqty > 0) then l_se := 'S'; //출고시 실Box 일경우
    if (s_wsno = '04') or (l_iodest = '2EM') then l_cntl := 'B'; // 비상Line 출고시 후진명령
  end;

  try
    src2_ok := 0;
    ahcomm_f.Query2.Close;
    ahcomm_f.Query2.SQL.Clear;
    ahcomm_f.Query2.SQL.Add(' update tbtrak set trak_boxid = '''+l_boxid+''', ');
    ahcomm_f.Query2.SQL.Add(' trak_se = '''+l_se+''', trak_cntl = '''+l_cntl+''' ');
    ahcomm_f.Query2.SQL.Add(' where trak_no = '''+cv_no+''' ');
    ahcomm_f.Query2.ExecSQL;
    ahcomm_f.src2_db.Commit;
    src2_ok := 1;
  except
    ahcomm_f.src2Edit.Text := 'STEP:5 TBTRAK Update error.!!';
  end;
  src2_step := l_step;
end;

procedure ahsrc2_T.lstk_update_proc;
var
  l_stat : string;
begin
  l_step := src2_step;
  src2_step := 6;
  try
    if (l_step = 33) and (s_cycle1 = 'O') then //출고완료
    begin
      src2_ok := 0;
      ahcomm_f.Query2.Close;
      ahcomm_f.Query2.SQL.Clear;
      ahcomm_f.Query2.SQL.Add(' update milstk set lstk_stat = ''0'', ');
      ahcomm_f.Query2.SQL.Add(' lstk_boxid = null, lstk_date = null ');
      ahcomm_f.Query2.SQL.Add(' where lstk_loc = '''+s_loc+''' ');
      ahcomm_f.Query2.ExecSQL;
      ahcomm_f.src2_db.Commit;
      src2_ok := 1;
    end

    else if (l_step = 15) or (l_step = 33) then //입고완료, 이중격납 Error 발생
    begin
      if (l_step = 15) then l_stat := e_code;
      if (l_step = 33) then l_stat := '1';
      src2_ok := 0;
      ahcomm_f.Query2.Close;
      ahcomm_f.Query2.SQL.Clear;
      ahcomm_f.Query2.SQL.Add(' update milstk set lstk_stat = '''+l_stat+''', ');
      ahcomm_f.Query2.SQL.Add(' lstk_date = sysdate ');
      ahcomm_f.Query2.SQL.Add(' where lstk_loc = '''+s_loc+''' ');
      ahcomm_f.Query2.ExecSQL;
      ahcomm_f.src2_db.Commit;
      src2_ok := 1;
    end

    else if (l_step = 37) or (l_step = 38) then //입고예약, 이중격납 재할당
    begin
      src2_ok := 0;
      ahcomm_f.Query2.Close;
      ahcomm_f.Query2.SQL.Clear;
      ahcomm_f.Query2.SQL.Add(' update milstk set lstk_stat = ''%'', ');
      ahcomm_f.Query2.SQL.Add(' lstk_boxid = '''+s_boxid+''', lstk_date = sysdate ');
      ahcomm_f.Query2.SQL.Add(' where lstk_loc = '''+s_loc+''' ');
      ahcomm_f.Query2.ExecSQL;
      ahcomm_f.src2_db.Commit;
      src2_ok := 1;
    end;
  except
    ahcomm_f.src2Edit.Text := 'STEP:6 MILSTK Update error.!!';
  end;
  src2_step := l_step;
end;

procedure ahsrc2_T.boxm_update_proc;
var
  l_stat, l_kind, l_cposi : string;
begin
  l_step := src2_step;
  src2_step := 7;
  try
    if (s_cycle1 = 'O') then //출고완료
    begin
      l_stat := '20';

      if      (s_wsno = '03') then l_cposi := '2B5'  // 세정기 1-6 출고
      else if (s_wsno = '06') then l_cposi := '2OT'  // 공BOX 출고
      else if (s_wsno = '05') then l_cposi := '2B6'  // 세정기 7-12 출고
      else if (s_wsno = '04') then l_cposi := '2EM'; // 비상출고

      ahcomm_f.Query2.Close;
      ahcomm_f.Query2.SQL.Clear;
      ahcomm_f.Query2.SQL.Add (' select boxm_sposi, boxm_kind from miboxm where boxm_boxid = '''+s_boxid+''' ');
      ahcomm_f.Query2.Open;
      ps_kind   := ahcomm_f.Query2.Fields[1].AsString;

      if (s_wsno = '04') then // 비상출고
      begin
        ps_iodest := l_cposi;

        ahcomm_f.Query2.Close;
        ahcomm_f.Query2.SQL.Clear;
        ahcomm_f.Query2.SQL.Add(' delete from miboxm ');
        ahcomm_f.Query2.SQL.Add(' where boxm_boxid = '''+s_boxid+''' ');
        ahcomm_f.Query2.ExecSQL;
        ahcomm_f.src2_db.Commit;
      end
      else
      begin
        ahcomm_f.Query2.Close;
        ahcomm_f.Query2.SQL.Clear;
        ahcomm_f.Query2.SQL.Add(' update miboxm set boxm_stat = '''+l_stat+''', ');
        ahcomm_f.Query2.SQL.Add(' boxm_cposi = '''+l_cposi+''', boxm_order = ''*'', ');
        ahcomm_f.Query2.SQL.Add(' boxm_curr_date = sysdate ');
        ahcomm_f.Query2.SQL.Add(' where boxm_boxid = '''+s_boxid+''' ');
        ahcomm_f.Query2.ExecSQL;
        ahcomm_f.src2_db.Commit;
      end;

      ps_cposi  := l_cposi;
      ps_sposi  := '2RK';
      Cntl_HistSettingProc;
    end

    else if (s_cycle1 = 'I') then //입고완료
    begin
      l_stat := '21';  l_cposi := '2RK';

      ahcomm_f.Query2.Close;
      ahcomm_f.Query2.SQL.Clear;
      ahcomm_f.Query2.SQL.Add (' select boxm_sposi, boxm_kind from miboxm where boxm_boxid = '''+s_boxid+''' ');
      ahcomm_f.Query2.Open;
      ps_sposi := ahcomm_f.Query2.Fields[0].AsString;
      l_kind   := ahcomm_f.Query2.Fields[1].AsString;

      if (l_kind <> 'RR') then l_kind := '00';

      ahcomm_f.Query2.Close;
      ahcomm_f.Query2.SQL.Clear;
      ahcomm_f.Query2.SQL.Add(' update miboxm set boxm_stat = '''+l_stat+''', boxm_kind = '''+l_kind+''', ');
      ahcomm_f.Query2.SQL.Add(' boxm_cposi = '''+l_cposi+''', boxm_order = boxm_fact, ');
      ahcomm_f.Query2.SQL.Add(' boxm_curr_date = sysdate ');
      ahcomm_f.Query2.SQL.Add(' where boxm_boxid = '''+s_boxid+''' ');
      ahcomm_f.Query2.ExecSQL;
      ahcomm_f.src2_db.Commit;

      ps_cposi  := l_cposi;
      ps_iodest := '2RK';
      ps_kind := l_kind;
      Cntl_HistSettingProc;
    end;
  except
    ahcomm_f.src2Edit.Text := 'STEP:7 MIBOXM Update error.!!';
  end;
  src2_step := l_step;
end;

procedure ahsrc2_T.Cntl_HistSettingProc;
var
  ls_fact: String[01];
  ls_qty: String[02];
begin
  ls_fact  := Copy(s_boxid,  1, 1);
  ls_qty   := Copy(s_boxid, 14, 2);

  if ls_fact = 'X' then exit;

  with ahcomm_f do
  begin
    try
      Query2.SQL.Clear;
      Query2.SQL.Add(' insert into mihist ');
      Query2.SQL.Add(' (hist_w_date,   hist_boxid,       hist_stat,       hist_order,     hist_kind, ');
      Query2.SQL.Add('  hist_jobqty,   hist_loc,         hist_cposi,      hist_iodest, ');
      Query2.SQL.Add('  hist_sposi,    hist_init_date,   hist_curr_date,  hist_date) ');
      Query2.SQL.Add(' values (sysdate, '''+s_boxid+''', ''21'', '''+ls_fact+''', '''+ps_kind+''', ');
      Query2.SQL.Add(' to_number('''+ls_qty+'''), '''+s_loc+''', '''+ps_cposi+''', '''+ps_iodest+''', ');
      Query2.SQL.Add(' '''+ps_sposi+''', sysdate, sysdate, NULL) ');

      Query2.ExecSQL;
      src2_db.Commit;
    except
    end;
  end;
end;

