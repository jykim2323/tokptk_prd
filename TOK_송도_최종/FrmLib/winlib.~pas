FUNCTION WinLib_ChkSpace( var_Data : String ) : String;
var
  var_Result : String;
Begin
  var_Result := TRim( var_Data );
  IF var_Result = '' Then Begin
      WinLib_ErrorForm('    ◁ 필수 입력입니다. 값을 입력하여 주세요! ▷    ');
      var_Result := '';
  End;
  Result := var_Result;
