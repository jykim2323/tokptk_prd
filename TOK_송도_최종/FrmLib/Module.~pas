  TMilChk = packed record
        LOCA   : String[10];   // 장치 위치 정보
        STATE  : String[1];    // 장치의 현상태 ( 
                                  {*
                                      1 : 비어있음 ( 기본값 )
                                      2 : 저장가능
                                      3 : FULL
                                      9 : 불량
                                      X : 장치가 존재하지 않음
                                      N : 장치위치 제한 사용하지 않음
                                      E : 장치위치 조회중 Query Error
                                  *}
        MAX_WEIGHT : Double;  // Max 중량
        MAX_QTY    : Integer; // MAX 수량
        USE_WEIGHT : Double;  // 사용 중량
        USE_QTY    : Integer; // 사용 수량
  end;

