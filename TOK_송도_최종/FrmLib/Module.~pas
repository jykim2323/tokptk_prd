  TMiLoc = packed record
        Code   : String[3];    // 창고종류
        Sel    : integer;      // 콤보박스 위치
        BK     : String[3];    // 자치위치
        BY     : String[3];    // 연  <-- 사용안함
        LV     : String[2];    // 단  <-- 사용안함
  end;

