<Window x:Class="TOK.WMS.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="https://github.com/Dirkster99/AvalonDock"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TOK.WMS.UI.ViewModels"
        
        xmlns:vmStd="clr-namespace:TOK.WMS.UI.ViewModels.MainMenus.Standards"
        xmlns:viewsStd="clr-namespace:TOK.WMS.UI.Views.MainMenus.Standards"
        
        xmlns:vmOut="clr-namespace:TOK.WMS.UI.ViewModels.MainMenus.Outbounds"
        xmlns:viewsOut="clr-namespace:TOK.WMS.UI.Views.MainMenus.Outbounds"
        
        xmlns:vmIn="clr-namespace:TOK.WMS.UI.ViewModels.MainMenus.Inbounds"
        xmlns:viewsIn="clr-namespace:TOK.WMS.UI.Views.MainMenus.Inbounds"
        
        xmlns:vmInv="clr-namespace:TOK.WMS.UI.ViewModels.MainMenus.Inventory"
        xmlns:viewsInv="clr-namespace:TOK.WMS.UI.Views.MainMenus.Inventory"

        xmlns:view="clr-namespace:TOK.WMS.UI.Views"
        xmlns:adctrl="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:models="clr-namespace:TOK.WMS.UI.Models.MainMenus"
        Icon="app.ico"
        WindowState="Maximized"
        Title="MainWindow" Height="960" Width="1600"
        FontFamily="{StaticResource AppFont}"
        FontWeight="Medium"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>

        <!-- 기준 정보 관리 -->
        <DataTemplate DataType="{x:Type vmStd:Frm1100ViewModel}">
            <viewsStd:Frm1100View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmStd:Frm1300ViewModel}">
            <viewsStd:Frm1300View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmStd:Frm1500ViewModel}">
            <viewsStd:Frm1500View/>
        </DataTemplate>


        <!-- 입고 관리 -->
        <DataTemplate DataType="{x:Type vmIn:Frm3100ViewModel}">
            <viewsIn:Frm3100View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmIn:Frm3130ViewModel}">
            <viewsIn:Frm3130View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmIn:Frm3300ViewModel}">
            <viewsIn:Frm3300View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmIn:Frm3400ViewModel}">
            <viewsIn:Frm3400View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmIn:Frm3700ViewModel}">
            <viewsIn:Frm3700View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmIn:Frm3900ViewModel}">
            <viewsIn:Frm3900View/>
        </DataTemplate>


        <!-- 출고 관리 -->
        <DataTemplate DataType="{x:Type vmOut:Frm4100ViewModel}">
            <viewsOut:Frm4100View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOut:Frm4101ViewModel}">
            <viewsOut:Frm4101View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOut:Frm4102ViewModel}">
            <viewsOut:Frm4102View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOut:Frm4103ViewModel}">
            <viewsOut:Frm4103View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOut:Frm4300ViewModel}">
            <viewsOut:Frm4300View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOut:Frm4400ViewModel}">
            <viewsOut:Frm4400View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmOut:Frm4500ViewModel}">
            <viewsOut:Frm4500View/>
        </DataTemplate>


        <!-- 재고 관리 -->
        <DataTemplate DataType="{x:Type vmInv:Frm6100ViewModel}">
            <viewsInv:Frm6100View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:Frm6200ViewModel}">
            <viewsInv:Frm6200View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:Frm6300ViewModel}">
            <viewsInv:Frm6300View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:Frm6450ViewModel}">
            <viewsInv:Frm6450View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:Frm6550ViewModel}">
            <viewsInv:Frm6550View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:Frm6700ViewModel}">
            <viewsInv:Frm6700View/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmInv:Frm6900ViewModel}">
            <viewsInv:Frm6900View/>
        </DataTemplate>



        <!-- 모니터링 -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <view:HomeView/>
        </DataTemplate>

        <!-- 사이드바 메뉴 버튼 스타일 -->
        <Style x:Key="SideMenuBtnStyle" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="Padding"      Value="0"/>
            <Setter Property="Margin"       Value="0,1"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="4" Margin="4,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource SidebarHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                Value="{DynamicResource SidebarActiveBrush}"/>
                                <Setter Property="Foreground"
                                Value="{DynamicResource SidebarActiveTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 헤더 아이콘 버튼 스타일 -->
        <Style x:Key="HeaderBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F3D8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>


        </Style>


        <!-- 원료/제품 창고 선택 컨트롤 스타일 -->
        <Style x:Key="WarehouseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background"
            Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground"
            Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <!-- 헤더 -->
            <RowDefinition Height="*"/>
            <!-- 본문 -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════
       헤더 바 (TOK 그라디언트)
       ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}">
            <Grid Cursor="">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 햄버거 + 로고 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 페이지 타이틀 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 상태 + 테마 -->
                </Grid.ColumnDefinitions>

                <!-- 햄버거 + 로고 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HamburgerBtn"
                      Style="{StaticResource HeaderBtnStyle}"
                      Click="HamburgerBtn_Click"
                      Width="46" Height="46" Padding="0"
                      ToolTip="메뉴 열기/닫기">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0">
                            <Rectangle Width="18" Height="2" Fill="White" Margin="0,2"/>
                            <Rectangle Width="18" Height="2" Fill="White" Margin="0,2"/>
                            <Rectangle Width="18" Height="2" Fill="White" Margin="0,2"/>
                        </StackPanel>
                    </Button>
                    <!-- TOK 로고 이미지 -->
                    <Button Command="{Binding OpenHomeCommand}"
                      ToolTip="모니터링 이동 / 새로고침"
                      Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                      Margin="6,0,12,0" VerticalAlignment="Center" Height="35" Width="68">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="/Assets/tok-logo.png"
                     Height="41"
                     RenderOptions.BitmapScalingMode="HighQuality" Width="65"/>
                    </Button>

                    <TextBlock Text="자동창고 메인메뉴" FontSize="17" FontWeight="Bold"
                         Foreground="White" VerticalAlignment="Center"
                         Margin="0,0,24,0"/>
                </StackPanel>

                <!-- 페이지 타이틀 -->
                <TextBlock Grid.Column="1"
                     Text="{Binding ActiveDocument.Title}"
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="#B0C4E8"
                     VerticalAlignment="Center" HorizontalAlignment="Left"
                     Margin="8,0"/>

                <!-- 연결 상태 + 다크모드 토글 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="0,0,12,0">
                    <!-- 연결 상태 표시 -->
                    <Border CornerRadius="10" Width="30" Padding="10,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#166534"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#4B5563"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#4ADE80"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ConnectionStatus}"
                                 Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 다크모드 토글 버튼 -->
                    <Button x:Name="ThemeToggleBtn"
                      Style="{StaticResource HeaderBtnStyle}"
                      Command="{Binding ToggleThemeCommand}"
                      Width="42" Height="42" Padding="0"
                      ToolTip="{DynamicResource ThemeToggleTip}">
                        <TextBlock Text="{DynamicResource ThemeToggleIcon}"
                             FontSize="17" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════
     본문 (사이드바 + 컨텐츠)
     ══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- 사이드바 -->
                <ColumnDefinition Width="*"/>
                <!-- 컨텐츠 -->
            </Grid.ColumnDefinitions>

            <!-- ── 사이드바 ─────────────────────────────── -->
            <Border x:Name="SidebarPanel"
            Grid.Column="0"
            Width="230"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,1,0">
                
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom"
                       Text="260728.v1 TOK 평택"
                       FontSize="10" Foreground="{DynamicResource AppTextSubBrush}"
                       HorizontalAlignment="Center" Margin="0,0,120,10"/>

                    <Border DockPanel.Dock="Top"
                            Margin="8,8,8,10"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid>
                            <!--<Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="원료창고"
                                    Command="{Binding SelectRawWarehouseCommand}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                            BasedOn="{StaticResource WarehouseButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedWarehouse}" Value="Raw">
                                                <Setter Property="Background" Value="{DynamicResource BtnPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="1"
                                    Content="제품창고"
                                    Command="{Binding SelectProductWarehouseCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WarehouseButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedWarehouse}" Value="Product">
                                                <Setter Property="Background" Value="{DynamicResource BtnPrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>-->
                        </Grid>
                    </Border>

                    <!-- 데이터 기반 메뉴 (MenuGroups → Expander → 하위 항목 버튼) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding MenuGroups}" Margin="0,8">
                            <!-- DataContext = MenuGroup -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="True"
                                      Margin="2,2"
                                      Foreground="{DynamicResource SidebarTextBrush}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IconKey}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Expander.Header>

                                        <!-- 하위 항목 -->
                                        <ItemsControl ItemsSource="{Binding Items}" Margin="6,2,0,6">
                                            <ItemsControl.ItemTemplate>
                                                <!-- DataContext = MenuLeaf -->
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SideMenuBtnStyle}"
                                                    Command="{Binding DataContext.OpenDocumentCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding MenuKey}"
                                                    ToolTip="{Binding Title}">
                                                        <Grid Height="34">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="·" FontSize="14"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Opacity="0.6"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ── 메인 컨텐츠 ──────────────────────────── -->
            <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <ad:DockingManager x:Name="Dock"
                           DocumentsSource="{Binding Documents}"
                           ActiveContent="{Binding ActiveDocument, Mode=TwoWay}"
                           DocumentClosed="Dock_DocumentClosed">

                    <ad:DockingManager.Resources>
                        <Style TargetType="{x:Type adctrl:LayoutDocumentTabItem}">
                            <Setter Property="FontSize" Value="13"/>
                            <!--<Setter Property="Padding" Value="10,5"/> -->
                        </Style>
                    </ad:DockingManager.Resources>

                    <ad:DockingManager.DocumentContextMenu>
                        <ContextMenu>
                            <MenuItem Header="닫기" Command="{Binding CloseCommand}"/>
                            <MenuItem Header="다른 탭 닫기" Command="{Binding CloseAllButThisCommand}"/>
                            <Separator/>
                            <MenuItem Header="모든 탭 닫기" Command="{Binding CloseAllCommand}"/>
                        </ContextMenu>
                    </ad:DockingManager.DocumentContextMenu>

                    <ad:DockingManager.LayoutItemContainerStyle>
                        <Style TargetType="{x:Type adctrl:LayoutItem}">
                            <Setter Property="Title" Value="{Binding Model.Title}"/>
                            <Setter Property="ContentId" Value="{Binding Model.ContentId}"/>
                            <Setter Property="CanClose" Value="{Binding Model.CanClose}"/>
                            <Setter Property="IsActive" Value="{Binding Model.IsActive, Mode=TwoWay}"/>
                            <Setter Property="IsSelected" Value="{Binding Model.IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </ad:DockingManager.LayoutItemContainerStyle>

                    <ad:LayoutRoot>
                        <ad:LayoutPanel>
                            <ad:LayoutDocumentPaneGroup>
                                <ad:LayoutDocumentPane/>
                            </ad:LayoutDocumentPaneGroup>
                        </ad:LayoutPanel>
                    </ad:LayoutRoot>
                </ad:DockingManager>
            </Border>
        </Grid>

    </Grid>
</Window>
