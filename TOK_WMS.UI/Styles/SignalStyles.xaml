<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="ScSignalTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            MinWidth="116" Height="44"
                            Padding="16,0"
                            Background="Transparent"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="0,0,1,0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background"
                                    Value="{DynamicResource AppSurface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#E6F1FA"/>
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="#5D89B7"/>
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,3"/>
                            <Setter Property="Foreground" Value="#315F8B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScSignalSectionCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="ScSignalInnerPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="8"/>
    </Style>

    <!-- 왼쪽 열 BIT 00~07, 오른쪽 열 BIT 08~15 순서로 배치 -->
    <!-- 모든 설비의 16 BIT를 왼쪽 00~07, 오른쪽 08~15로 동일하게 배치 -->
    <Style x:Key="SignalBitGridStyle" TargetType="ItemsControl">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Grid.Row" Value="{Binding LayoutRow}"/>
                    <Setter Property="Grid.Column" Value="{Binding LayoutColumn}"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SignalBitRowTemplate">
        <Border Margin="2,1" Padding="6,2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="3"
                ToolTip="{Binding DisplayIndex}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#E3F5E9"/>
                            <Setter Property="BorderBrush" Value="#71BE8A"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <!-- 빈 신호는 Content가 빈 문자열이므로 CheckBox만 표시된다. -->
            <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Content="{Binding Label}"
                      FontSize="11.5"
                      Foreground="{DynamicResource AppTextBrush}"
                      VerticalAlignment="Center"
                      HorizontalContentAlignment="Left"/>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="ScSignalWordCardTemplate">
        <Border Margin="4" Padding="10,8"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Channel}" FontFamily="Consolas"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#315F8B"/>
                    <TextBlock Text="{Binding Description}" Margin="0,2,0,0"
                               FontSize="11" Foreground="{DynamicResource AppTextSubBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Height="34" CornerRadius="4"
                        Background="#162C43" BorderBrush="#5D89B7" BorderThickness="1">
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="4"
                             Background="Transparent" BorderThickness="0" Padding="2,0"
                             FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                             Foreground="#E9F4FF" CaretBrush="White"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="ScSignalRefreshButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background"
                                    Value="{DynamicResource AppSurface2Brush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScSignalModifyButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Background" Value="#315F8B"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#254E75"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#3E739F"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#244B70"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
