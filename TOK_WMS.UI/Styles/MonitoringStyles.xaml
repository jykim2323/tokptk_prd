<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:monitoringModels="clr-namespace:TOK.WMS.UI.Views.Monitoring.Models">

    
    <!--  #Region 트래킹 색상 관리 -->
    <!--<Setter Property="Background" Value="#A8DDCE"/>-->
    <SolidColorBrush x:Key="OutboundTrackingEmptyBrush" Color="#C0DCC0"/>
    <!--<Setter Property="Background" Value="#BDCAF3"/>-->
    <SolidColorBrush x:Key="InboundTrackingEmptyBrush" Color="#C0DCC0"/>
    <SolidColorBrush x:Key="TrackingPalletOnlyBrush" Color="#BDCAF3"/>
    <SolidColorBrush x:Key="TrackingDataOnlyBrush" Color="#6B5BA4"/>
    <SolidColorBrush x:Key="TrackingPalletAndDataBrush" Color="#0000FF"/>
    <SolidColorBrush x:Key="TrackingDarkForegroundBrush" Color="#172B4D"/>
    <SolidColorBrush x:Key="TrackingLightForegroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SpecialTrackingBorderBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="RgvReadyBrush" Color="#00FF00"/>
    <SolidColorBrush x:Key="RgvWorkingBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="RgvErrorBrush" Color="#FF0000"/>
    <!--#Endregion-->
    
    <!-- #Region 스태커/RGV 가운데 번호판: PLT무 흰색, PLT유 살구색 -->
    <SolidColorBrush x:Key="EmptyPalletPlateBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LoadedPalletPlateBrush" Color="#F4B183"/>
    <!--Endregion-->
    

    <!-- 트래킹 공통 입체 셀 -->
    <Style x:Key="RaisedCellBaseStyle" TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{DynamicResource MonitoringCellBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringRaisedCellBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MonitoringTextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Margin="2,2,0,0" Background="{DynamicResource MonitoringRaisedCellShadowBrush}" CornerRadius="3"/>
                        <Border Margin="0,0,2,2" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <Grid>
                                <Border BorderBrush="{DynamicResource MonitoringRaisedCellHighlightBrush}" BorderThickness="1.5,1.5,0,0" CornerRadius="2" IsHitTestVisible="False"/>
                                <Border BorderBrush="{DynamicResource MonitoringRaisedCellShadeBrush}" BorderThickness="0,0,1.5,1.5" CornerRadius="2" IsHitTestVisible="False"/>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 상·하부 트래킹 구간 공통 스타일 -->
    <Style x:Key="TrackingSectionStyle" TargetType="{x:Type Label}"
           BasedOn="{StaticResource RaisedCellBaseStyle}">
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringTitleBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TrackingDarkForegroundBrush}"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <!-- 아직 데이터를 조회하지 않은 구간만 살짝 흐리게 표시 -->
            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:TrackingVisualState.Unknown}">
                <Setter Property="Opacity" Value="0.65"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:TrackingVisualState.PalletOnly}">
                <Setter Property="Background" Value="{StaticResource TrackingPalletOnlyBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingDarkForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:TrackingVisualState.DataOnly}">
                <Setter Property="Background" Value="{StaticResource TrackingDataOnlyBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingLightForegroundBrush}"/>
            </DataTrigger>

            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:TrackingVisualState.PalletAndData}">
                <Setter Property="Background" Value="{StaticResource TrackingPalletAndDataBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingLightForegroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 출고용 트래킹 구간 -->
    <Style x:Key="OutboundTrackingSectionStyle" TargetType="{x:Type Label}"
           BasedOn="{StaticResource TrackingSectionStyle}">
        <Setter Property="Background" Value="{StaticResource OutboundTrackingEmptyBrush}"/>
    </Style>

    <!-- 입고용 트래킹 구간 -->
    <Style x:Key="InboundTrackingSectionStyle" TargetType="{x:Type Label}"
           BasedOn="{StaticResource TrackingSectionStyle}">
        <Setter Property="Background" Value="{StaticResource InboundTrackingEmptyBrush}"/>
    </Style>

    <!-- 24번 특수 트래킹 구간: 상태색은 유지하고 위치만 주황색 테두리로 강조 -->
    <Style x:Key="SpecialOutboundTrackingSectionStyle" TargetType="{x:Type Label}"
           BasedOn="{StaticResource OutboundTrackingSectionStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource SpecialTrackingBorderBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- 트래킹 구간 좌측 상단의 소형 상태 표시기
         기본(IsChecked=False)은 소등, 추후 상태값을 IsChecked에 바인딩하면 초록색으로 점등한다. -->
    <Style x:Key="TrackingCornerIndicatorStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="7"/>
        <Setter Property="Background" Value="{DynamicResource MonitoringIndicatorOffBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringIndicatorBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="IsChecked" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="{DynamicResource MonitoringIndicatorFrameBrush}">
                        <!-- 위·왼쪽의 어두운 선: 패널 안으로 들어간 그림자 -->
                        <Border BorderBrush="{DynamicResource MonitoringIndicatorInsetBrush}"
                                BorderThickness="1,1,0,0"
                                IsHitTestVisible="False"/>

                        <!-- 아래·오른쪽의 밝은 선: 바깥 테두리의 반사광 -->
                        <Border BorderBrush="{DynamicResource MonitoringIndicatorHighlightBrush}"
                                BorderThickness="0,0,1,1"
                                IsHitTestVisible="False"/>

                        <!-- 실제 표시 면을 테두리보다 한 단계 안쪽에 배치 -->
                        <Border Margin="2,2,1,1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                IsHitTestVisible="False"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="#39FF14"/>
                <Setter Property="BorderBrush" Value="#00A81A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 스테커 크레인 스타일 -->
    <Style x:Key="StackerCraneStyle"
           TargetType="{x:Type Label}">

        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="#32D43F"/>
        <Setter Property="Foreground" Value="BLACK"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>

        <Setter Property="RenderTransform">
            <Setter.Value>
                <!-- 반시계 방향 90도 -->
                <RotateTransform Angle="-90"/>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Label}">
                    <Canvas Background="Transparent"
                            ClipToBounds="False"
                            SnapsToDevicePixels="True">

                        <!-- 화면 상단의 큰 사각 헤드 -->
                        <Border x:Name="UpperHead"
                                Canvas.Left="48"
                                Canvas.Top="-2"
                                Width="30"
                                Height="29"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2.5"
                                Panel.ZIndex="100">
                        </Border>

                        <!-- 상부 헤드와 롤러 사이의 짧은 목 -->
                        <Border x:Name="UpperHeadNeck"
                                Canvas.Left="42"
                                Canvas.Top="1"
                                Width="8"
                                Height="23"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2"
                                Panel.ZIndex="100"/>

                        <!-- 상부 가이드 롤러 -->
                        <Border x:Name="UpperRoller"
                                Canvas.Left="32"
                                Canvas.Top="-2"
                                Width="12"
                                Height="30"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2"
                                Panel.ZIndex="120">
                            <Border Margin="2,3"
                                    CornerRadius="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#171717"
                                    BorderThickness="1"/>
                        </Border>

                        <!-- 상부 롤러와 번호판 사이의 연결부 -->
                        <Border x:Name="UpperCarriageNeck"
                                Canvas.Left="27"
                                Canvas.Top="2"
                                Width="8"
                                Height="23"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2.5"
                                Panel.ZIndex="100"/>

                        <!-- 팔레트가 올라오는 캐리지: 기존 크기와 번호 방향 유지 -->
                        <Border x:Name="Carriage"
                                Canvas.Left="-4"
                                Canvas.Top="-2"
                                Width="31"
                                Height="30"
                                Background="{StaticResource EmptyPalletPlateBrush}"
                                BorderBrush="#1A1A1A"
                                BorderThickness="1.5"
                                Panel.ZIndex="200">
                            <!-- 호기 번호는 팔레트 캐리지에 표시 -->
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <!-- 크레인 전체 회전을 상쇄하여 번호는 똑바로 표시 -->
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="90"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Border>

                        <!-- 번호판과 하부 롤러 사이의 연결부 -->
                        <Border x:Name="LowerCarriageNeck"
                                Canvas.Left="-9"
                                Canvas.Top="2"
                                Width="8"
                                Height="23"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2.5"
                                Panel.ZIndex="4"/>

                        <!-- 하부 가이드 롤러 -->
                        <Border x:Name="LowerRoller"
                                Canvas.Left="-19"
                                Canvas.Top="-2"
                                Width="12"
                                Height="30"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2"
                                Panel.ZIndex="6">
                            <Border Margin="2,3"
                                    CornerRadius="0"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#171717"
                                    BorderThickness="1"/>
                        </Border>

                        <!-- 하부 롤러와 받침 사이의 짧은 목 -->
                        <Border x:Name="LowerBaseNeck"
                                Canvas.Left="-24"
                                Canvas.Top="2"
                                Width="8"
                                Height="23"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#171717"
                                BorderThickness="2.5"
                                Panel.ZIndex="4"/>
                    </Canvas>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag.HasLoadedPallet, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="Carriage"
                                    Property="Background"
                                    Value="{StaticResource LoadedPalletPlateBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 파란색 상태 램프: 화면에서는 이름과 위치만 지정하여 재사용 -->
    <Style x:Key="StatusLampStyle"
           TargetType="{x:Type Control}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="#1717ED"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Grid>
                        <Ellipse Stroke="#172B4D"
                                 StrokeThickness="1.5"
                                 Fill="{TemplateBinding Background}"/>

                        <!-- 램프의 반사광 -->
                        <Ellipse Width="2"
                                 Height="1"
                                 Fill="#CCFFFFFF"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="7,6,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BCR 청색 신호 표시기: 회색 케이스 안에 청색 표시부만 사용 -->
    <Style x:Key="BcrSignalStyle"
           TargetType="{x:Type Control}">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Background" Value="#1616EF"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border Background="{DynamicResource MonitoringSignalCaseBrush}"
                            BorderBrush="{DynamicResource MonitoringSignalCaseBorderBrush}"
                            BorderThickness="0.5"
                            CornerRadius="0.5">
                        <Border Margin="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource MonitoringSignalInsetBorderBrush}"
                                BorderThickness="0.75"
                                CornerRadius="0.5"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 도면의 BCR 이름: 원래 라벨 모양을 유지하면서 상태 문구 전환을 지원 -->
    <Style x:Key="BcrCanvasLabelStyle"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MonitoringTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontFamily" Value="Noto Sans KR"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="HoverSurface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverSurface" Property="Background" Value="{DynamicResource MonitoringLabelHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.Foreground.Color, RelativeSource={RelativeSource Self}}" Value="Blue">
                <Setter Property="Foreground" Value="{DynamicResource MonitoringBcrEnabledTextBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag.Foreground.Color, RelativeSource={RelativeSource Self}}" Value="Red">
                <Setter Property="Foreground" Value="{DynamicResource MonitoringBcrDisabledTextBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- BCR 상태 문구 박스 -->
    <Style x:Key="BcrTextBoxStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="Width" Value="80"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="#0616C9"/>
        <Setter Property="Foreground" Value="#FFF200"/>
        <Setter Property="BorderBrush" Value="#172B4D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- PCK 상태 문구 박스: BCR과 별도로 수정할 수 있도록 독립 스타일로 관리 -->
    <Style x:Key="PckTextBoxStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="Width" Value="60"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="#0616C9"/>
        <Setter Property="Foreground" Value="#FFF200"/>
        <Setter Property="BorderBrush" Value="#172B4D"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- 하단 BCR 상태 패널의 BCR 번호 영역 -->
    <Style x:Key="BcrMonitorNameStyle"
           TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{DynamicResource MonitoringBcrHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnPrimBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringPanelHeaderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- 하단 BCR 상태 패널의 메시지 영역 -->
    <Style x:Key="BcrMonitorMessageStyle"
           TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource MonitoringStatusPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MonitoringStatusTextBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <!-- 설비 상태표의 왼쪽 설비명 -->
    <Style x:Key="MonitorLegendNameStyle"
           TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{DynamicResource MonitoringPanelHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnPrimBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringPanelHeaderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- 설비 상태표의 색상 한 칸 -->
    <Style x:Key="MonitorLegendItemStyle"
           TargetType="{x:Type ContentControl}">
        <Setter Property="Foreground" Value="{DynamicResource MonitoringStatusTextBrush}"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border Background="{DynamicResource MonitoringStatusPanelBrush}"
                            BorderBrush="{DynamicResource MonitoringPanelHeaderBorderBrush}"
                            BorderThickness="0,0,1,1">
                        <Grid Margin="3,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="7"
                                    Height="12"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding BorderBrush}"
                                    BorderBrush="{DynamicResource MonitoringLegendBorderBrush}"
                                    BorderThickness="0.5"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="3,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 적재 현황 표 머리글 및 행 이름 -->
    <Style x:Key="MonitorTableHeaderStyle"
           TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{DynamicResource MonitoringPanelHeaderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextOnPrimBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringPanelHeaderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="1,0"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- 적재 현황 숫자 셀 -->
    <Style x:Key="MonitorTableCellStyle"
           TargetType="{x:Type Label}">
        <Setter Property="Background" Value="{DynamicResource MonitoringTableBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MonitoringStatusTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringTableBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="1,0"/>
        <Setter Property="FontSize" Value="9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>

    <!-- 우측 현황 영역의 제목 바 -->
    <Style x:Key="MonitorRightSectionTitleStyle"
           TargetType="{x:Type Border}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Background" Value="{DynamicResource MonitoringRightTitleBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringRightTitleBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="10,0"/>
    </Style>

    <!-- 우측 예약/트래킹 현황 공통 데이터 표 -->
    <Style x:Key="MonitorDataGridStyle"
           TargetType="{x:Type DataGrid}">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserReorderColumns" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource MonitoringTableBorderBrush}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource MonitoringTableBorderBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringPanelHeaderBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource MonitoringTableBackgroundBrush}"/>
        <Setter Property="RowBackground" Value="{DynamicResource GridRowBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource MonitoringStatusPanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource MonitoringStatusTextBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="RowHeight" Value="27"/>
        <Setter Property="ColumnHeaderHeight" Value="29"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="{DynamicResource MonitoringPanelHeaderBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextOnPrimBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MonitoringPanelHeaderBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="3,0"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="{x:Type DataGridCell}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource MonitoringTableBorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="Padding" Value="4,0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RGV 대차: 가운데 번호판 + 양쪽 프레임 + 왼쪽 구동부 -->
    <Style x:Key="RgvCarrierStyle"
           TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="58"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource RgvUnknownBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource MonitoringCarrierRailBrush}"/>
        <Setter Property="Foreground" Value="#102038"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                        </Grid.ColumnDefinitions>

                        <!-- 좌우 대차 프레임도 유피케미컬 화면처럼 장비 상태색을 함께 사용 -->
                        <Border x:Name="LeftCarrierFrame"
                                Grid.Column="0"
                                Margin="0,5,0,5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"/>
                        <Border x:Name="RightCarrierFrame"
                                Grid.Column="2"
                                Margin="0,5,0,5"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"/>

                        <!-- 왼쪽 구동부 -->
                        <Border x:Name="DriveUnit"
                                Grid.Column="0"
                                Width="8"
                                Height="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="2">
                            <Rectangle Width="2"
                                       Margin="0,3"
                                       Fill="#4F555B"/>
                        </Border>

                        <!-- 가운데 RGV 번호판: 본체 운전 상태색과 분리하여 PLT 탑재 상태만 표시 -->
                        <Border x:Name="CarrierNumberPlate"
                                Grid.Column="1"
                                Background="{StaticResource EmptyPalletPlateBrush}"
                                BorderBrush="#20252A"
                                BorderThickness="3.1">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                TextElement.Foreground="{StaticResource TrackingDarkForegroundBrush}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Border>

                        <!-- 장비 상태색과 섞지 않고 별도로 보여 주는 탑재 팔레트 표시 -->
                        <Ellipse x:Name="PalletIndicator"
                                 Grid.Column="2"
                                 Width="7"
                                 Height="7"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,9,0,0"
                                 Fill="#FFFFFF"
                                 Stroke="#20252A"
                                 StrokeThickness="1"
                                 Panel.ZIndex="5"/>

                        <Ellipse x:Name="DataIndicator"
                                 Grid.Column="2"
                                 Width="7"
                                 Height="7"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Bottom"
                                 Margin="0,0,0,9"
                                 Fill="#FFFFFF"
                                 Stroke="#20252A"
                                 StrokeThickness="1"
                                 Panel.ZIndex="5"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag.HasLoadedPallet, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="CarrierNumberPlate"
                                    Property="Background"
                                    Value="{StaticResource LoadedPalletPlateBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag.HasPallet, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="PalletIndicator"
                                    Property="Fill"
                                    Value="{StaticResource TrackingPalletOnlyBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag.HasTrackingData, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter TargetName="DataIndicator"
                                    Property="Fill"
                                    Value="{StaticResource TrackingDataOnlyBrush}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:RgvVisualState.Unknown}">
                <Setter Property="Background" Value="{DynamicResource RgvUnknownBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingDarkForegroundBrush}"/>
                <Setter Property="Opacity" Value="0.7"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:RgvVisualState.Manual}">
                <Setter Property="Background" Value="{DynamicResource RgvManualBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingDarkForegroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:RgvVisualState.Ready}">
                <Setter Property="Background" Value="{StaticResource RgvReadyBrush}"/>
                <Setter Property="BorderBrush" Value="#20252A"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingDarkForegroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:RgvVisualState.Working}">
                <Setter Property="Background" Value="{StaticResource RgvWorkingBrush}"/>
                <Setter Property="BorderBrush" Value="#20252A"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingDarkForegroundBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag.VisualState, RelativeSource={RelativeSource Self}}"
                         Value="{x:Static monitoringModels:RgvVisualState.Error}">
                <Setter Property="Background" Value="{StaticResource RgvErrorBrush}"/>
                <Setter Property="BorderBrush" Value="#20252A"/>
                <Setter Property="Foreground" Value="{StaticResource TrackingLightForegroundBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 상향 화살표 -->
    <Style x:Key="UpArrowStyle"
           TargetType="{x:Type Control}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Path Data="M 12,1 L23,17 L17,17 L17,29 L7,29 L7,17 L1,17 Z"
                          Fill="#19B7B8"
                          Stroke="#172B4D"
                          StrokeThickness="1"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Margin="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 하향 화살표: 상향 화살표를 180도 회전하여 같은 디자인 재사용 -->
    <Style x:Key="DownArrowStyle"
           TargetType="{x:Type Control}"
           BasedOn="{StaticResource UpArrowStyle}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="180"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
