<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/Frm3300Styles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 입고관리 화면에서만 사용하는 공통 디자인. -->
    <Geometry x:Key="InboundSearchIconGeometry">M 10,3 A 7,7 0 1 1 10,17 A 7,7 0 1 1 10,3 M 15,15 L 21,21</Geometry>
    <Geometry x:Key="InboundExcelIconGeometry">M 6,3 L 16,3 L 21,8 L 21,21 L 6,21 Z M 16,3 L 16,8 L 21,8 M 2,8 L 14,8 L 14,18 L 2,18 Z M 5,11 L 11,15 M 11,11 L 5,15</Geometry>
    <Geometry x:Key="InboundPrinterIconGeometry">M 6,9 L 6,3 L 18,3 L 18,9 M 6,18 L 3,18 L 3,9 L 21,9 L 21,18 L 18,18 M 6,14 L 18,14 L 18,21 L 6,21 Z M 17,11.5 L 18,11.5</Geometry>
    <Geometry x:Key="InboundDeleteIconGeometry">M 3,6 L 21,6 M 9,6 L 9,3 L 15,3 L 15,6 M 5,6 L 6,21 L 18,21 L 19,6 M 10,10 L 10,17 M 14,10 L 14,17</Geometry>
    <Geometry x:Key="InboundPowerIconGeometry">M 12,2 L 12,11 M 6,5 A 9,9 0 1 0 18,5</Geometry>
    <Geometry x:Key="InboundPackageIconGeometry">M 12,2 L 22,7 L 22,17 L 12,22 L 2,17 L 2,7 Z M 2,7 L 12,12 L 22,7 M 12,12 L 12,22 M 7,4.5 L 17,9.5</Geometry>
    <Geometry x:Key="InboundConfirmIconGeometry">M 4,12 L 9,17 L 20,6</Geometry>
    <Geometry x:Key="InboundPlusIconGeometry">M 12,3 L 12,21 M 3,12 L 21,12</Geometry>
    <Geometry x:Key="InboundRefreshIconGeometry">M 20,8 A 9,9 0 1 0 21,15 M 20,3 L 20,8 L 15,8</Geometry>
    <Geometry x:Key="InboundModifyIconGeometry">M 4,16 L 4,21 L 9,20 L 21,8 L 16,3 Z M 13,6 L 18,11</Geometry>

    <Style x:Key="InboundToolbarIconStyle" TargetType="Path" BasedOn="{StaticResource Frm3300ToolbarIconStyle}"/>
    <Style x:Key="InboundPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Frm3300PrimaryButtonStyle}"/>
    <Style x:Key="InboundExcelButtonStyle" TargetType="Button" BasedOn="{StaticResource Frm3300ExcelButtonStyle}"/>
    <Style x:Key="InboundSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource Frm3300SecondaryButtonStyle}"/>

    <Style x:Key="InboundTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InboundSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InboundCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
    </Style>
    <Style x:Key="InboundSectionTitleStyle" TargetType="Border" BasedOn="{StaticResource SectionTitleStyle}"/>
    <Style x:Key="InboundCellTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="InboundLeftCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource InboundCellTextStyle}">
        <Setter Property="TextAlignment" Value="Left"/>
    </Style>
    <Style x:Key="InboundRightCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource InboundCellTextStyle}">
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <Style x:Key="InboundHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListColumnHeaderStyle}">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="InboundCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ListCellStyle}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <Border x:Name="SelectionAccent" Width="3" HorizontalAlignment="Left"
                                Background="{StaticResource Frm3300PrimaryBrush}" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                <Condition Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="InboundDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ListDataGridStyle}">
        <Setter Property="RowHeight" Value="36"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CellStyle" Value="{StaticResource InboundCellStyle}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource InboundHeaderStyle}"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
</ResourceDictionary>
