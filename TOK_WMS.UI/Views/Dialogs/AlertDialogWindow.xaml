<Window x:Class="TOK.WMS.UI.Views.Dialogs.AlertDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:TOK.WMS.UI.Models.Dialogs"
        Title="{Binding Title}"
        Width="520"
        MinWidth="360"
        MaxHeight="680"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{DynamicResource AppFont}"
        FontWeight="Medium"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="AlertButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Border x:Name="FocusBorder"
                                    Margin="2"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusBorder" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AlertPrimaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource AlertButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource BtnPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
            <Setter Property="IsDefault" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                    <Setter Property="IsDefault" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertSecondaryButtonStyle" TargetType="Button"
               BasedOn="{StaticResource AlertButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsDefault" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="IsDefault" Value="True"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AllowCancel}" Value="True">
                    <Setter Property="IsDefault" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertCancelButtonStyle" TargetType="Button"
               BasedOn="{StaticResource AlertButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="IsCancel" Value="True"/>
            <Setter Property="IsDefault" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AllowCancel}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="IsDefault" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextOnPrimBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertIconPathStyle" TargetType="Path">
            <Setter Property="Data" Value="M 12,8 L 12,20"/>
            <Setter Property="Stroke" Value="#2383B3"/>
            <Setter Property="StrokeThickness" Value="2.4"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs:AlertKind.Warning}">
                    <Setter Property="Data" Value="M 12,4 L 12,15.8"/>
                    <Setter Property="Stroke" Value="#B86C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs:AlertKind.Confirmation}">
                    <Setter Property="Data" Value="M 7.5,8.2 C 7.5,5.5 9.2,4 12,4 C 14.8,4 16.5,5.6 16.5,8 C 16.5,10.2 15.1,11.4 13.6,12.3 C 12.5,13 12,14 12,15.8"/>
                    <Setter Property="Stroke" Value="{DynamicResource BtnPrimaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AlertIconDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="2.4"/>
            <Setter Property="Height" Value="2.4"/>
            <Setter Property="Canvas.Left" Value="10.8"/>
            <Setter Property="Canvas.Top" Value="2.8"/>
            <Setter Property="Fill" Value="{Binding Stroke, ElementName=AlertIconPath}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs:AlertKind.Warning}">
                    <Setter Property="Canvas.Top" Value="18.8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static dialogs:AlertKind.Confirmation}">
                    <Setter Property="Canvas.Top" Value="18.8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="3" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBrush}"
                    CornerRadius="7,7,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid MinHeight="52" Margin="18,4,6,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}"
                               TextWrapping="Wrap"
                               Margin="0,4,12,4"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextOnPrimBrush}"
                               VerticalAlignment="Center"/>
                    <Button x:Name="HeaderCloseButton"
                            Grid.Column="1"
                            Width="36" Height="36"
                            Content="×"
                            Style="{StaticResource AlertCloseButtonStyle}"
                            Command="{Binding CancelCommand}"
                            IsTabStop="False"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="닫기"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,24,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="AlertIcon" Width="36" Height="36"
                      VerticalAlignment="Top"
                      IsHitTestVisible="False">
                    <Ellipse Fill="{DynamicResource AppBackgroundBrush}"
                             Stroke="{Binding Stroke, ElementName=AlertIconPath}"
                             StrokeThickness="1.5"/>
                    <!-- 벡터의 실제 표시 영역을 원 중심에 맞춰 글꼴 기준선 영향을 없앤다. -->
                    <Canvas x:Name="AlertIconGlyph" Width="24" Height="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            UseLayoutRounding="False">
                        <Path x:Name="AlertIconPath" Style="{StaticResource AlertIconPathStyle}"/>
                        <Ellipse Style="{StaticResource AlertIconDotStyle}"/>
                    </Canvas>
                </Grid>
                <ScrollViewer x:Name="MessageScroll"
                              Grid.Column="2"
                              MaxHeight="420"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="MessageTextBox"
                             Text="{Binding Message, Mode=OneWay}"
                             Background="Transparent"
                             Foreground="{DynamicResource AppTextBrush}"
                             CaretBrush="{DynamicResource AppTextBrush}"
                             BorderThickness="0"
                             Padding="0"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="알림 내용"/>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="24,16,24,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="{Binding CancelButtonText}"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"
                            Style="{StaticResource AlertCancelButtonStyle}"/>
                    <Button x:Name="SecondaryButton"
                            Content="{Binding SecondaryButtonText}"
                            Command="{Binding RejectCommand}"
                            Margin="0,0,8,0"
                            Style="{StaticResource AlertSecondaryButtonStyle}"/>
                    <Button x:Name="PrimaryButton"
                            Content="{Binding PrimaryButtonText}"
                            Command="{Binding AcceptCommand}"
                            Style="{StaticResource AlertPrimaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
