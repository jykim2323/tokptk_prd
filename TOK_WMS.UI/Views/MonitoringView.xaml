                        <DataGridTextColumn Header="지시시간" Width="1*" MinWidth="115" Binding="{Binding InstructionTime}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 컨베어 트랙킹 정보 -->
                <Border Grid.Row="3" Style="{StaticResource MonitorRightSectionTitleStyle}">
                    <TextBlock Text="컨베어 트랙킹 정보" Style="{StaticResource SectionTitleTextStyle}"/>
                </Border>

                <DataGrid x:Name="ConveyorTrackingGrid" Grid.Row="4" Margin="0,4,0,0" ItemsSource="{Binding Sc1TrackingItems}" Style="{StaticResource MonitorDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="순번" Width="0.65*" MinWidth="70" Binding="{Binding Sequence}"/>
                        <DataGridTextColumn Header="저장위치" Width="1.3*" MinWidth="150" Binding="{Binding StorageLocation}"/>
                        <DataGridTextColumn Header="구분" Width="0.7*" MinWidth="80" Binding="{Binding Type}"/>
                        <DataGridTextColumn Header="등록일자" Width="1.15*" MinWidth="150" Binding="{Binding RegisteredDate}"/>
                        <DataGridTextColumn Header="등록시간" Width="1*" MinWidth="150" Binding="{Binding RegisteredTime}"/>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid>
        </Border>

    </Grid>
</UserControl>
