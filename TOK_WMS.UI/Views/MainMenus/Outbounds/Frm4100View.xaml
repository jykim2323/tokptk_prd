<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
    x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4100View"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource AppTextBrush}"
    FontFamily="{StaticResource AppFont}"
    FontWeight="Medium"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="OutboundCloseIconGeometry">M 5,5 L 19,19 M 19,5 L 5,19</Geometry>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="InputBox" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="PopupLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="PopupInputBox" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="StationRadioStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="175"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <Ellipse x:Name="CheckDot"
                                            Width="8"
                                            Height="8"
                                            Fill="{DynamicResource BtnPrimaryBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                                    </Border>
                                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                                    <Setter TargetName="RootBorder" Property="BorderThickness" Value="2"/>
                                    <Setter TargetName="CheckDot" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RootBorder" Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RootBorder" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top"
            Margin="0,0,0,16"
            x:Name="OutboundHeaderGrid"
            behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=OutboundToolbar}"
            behaviors:ResponsiveHeader.StackBelowWidth="850">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}"
                        Style="{StaticResource ScreenToolbarIconStyle}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Stroke="{DynamicResource AppTextBrush}"/>
                </Border>
                <TextBlock Text="재고 출고 등록" VerticalAlignment="Center" Style="{StaticResource ScreenTitleTextStyle}"/>
                <TextBlock Text="Frm4100" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ScreenSubtitleTextStyle}"/>
            </StackPanel>
            <CheckBox Grid.Column="1"
                Content="긴급출고"
                Foreground="{DynamicResource AppTextBrush}"
                IsChecked="{Binding IsEmergency}"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="Bold"
                Margin="0,0,15,0"
                VerticalContentAlignment="Center"
                MinHeight="36"
                x:Name="OutboundToolbar"/>
        </Grid>
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource ScreenCardStyle}">
            <DockPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,-8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품목코드:" Style="{StaticResource FilterLabel}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ItemCodeSrc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            CharacterCasing="Upper"
                            Style="{StaticResource InputBox}"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Padding="8,2"
                            Width="220"
                            Margin="0"
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품명:" Style="{StaticResource FilterLabel}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ItemNameSrc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource InputBox}"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Padding="8,2"
                            Width="220"
                            Margin="0"
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="LOT-NO:" Style="{StaticResource FilterLabel}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding LotNoSrc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            CharacterCasing="Upper"
                            Style="{StaticResource InputBox}"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Padding="8,2"
                            Width="220"
                            Margin="0"
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,0,8" AutomationProperties.Name="조회">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ScreenSearchIconGeometry}"
                                Style="{StaticResource ScreenToolbarIconStyle}"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Margin="0,0,8,0"/>
                            <TextBlock Text="조회" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2.2*"/>
                <RowDefinition Height="1.15*"/>
                <RowDefinition Height="1.3*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource ScreenCardStyle}">
                <DockPanel>
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8" DockPanel.Dock="Top">
                        <Grid MinHeight="36" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="재고 자료 정보" Grid.Column="0" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="※ 행 더블클릭 → 출고 등록"
                                HorizontalAlignment="Right"
                                Grid.Column="2"
                                Margin="0"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="StockGrid"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        Style="{StaticResource ScreenDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        HeadersVisibility="Column"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        GridLinesVisibility="None"
                        MinHeight="96">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="재고위치" Binding="{Binding SubkLoca}" Width="110" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="PLT-NO"
                                Binding="{Binding SubkPltno}"
                                Width="130"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="160" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="품 목 명"
                                Binding="{Binding MastName}"
                                Width="240"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="180"/>
                            <DataGridTextColumn Header="LOT-NO"
                                Binding="{Binding SubkLotno}"
                                Width="180"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="재고중량"
                                Binding="{Binding SubkWgt, StringFormat={}{0:N2}}"
                                Width="110"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90"/>
                            <DataGridTextColumn Header="BOX-NO"
                                Binding="{Binding SubkBoxno}"
                                Width="140"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="비 고"
                                Binding="{Binding SubkRemark}"
                                Width="*"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="150"/>
                        </DataGrid.Columns>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding StockDoubleClickCommand}" CommandParameter="{Binding SelectedItem, ElementName=StockGrid}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource ScreenCardStyle}">
                <DockPanel>
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8" DockPanel.Dock="Top">
                        <TextBlock Text="팔레트 자료 정보" Margin="0" Style="{StaticResource SectionTitleTextStyle}"/>
                    </Border>
                    <DataGrid ItemsSource="{Binding PalletItems}"
                        SelectedItem="{Binding SelectedPalletItem, Mode=TwoWay}"
                        Style="{StaticResource ScreenDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        HeadersVisibility="Column"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        GridLinesVisibility="None"
                        MinHeight="96">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="재고위치" Binding="{Binding SubkLoca}" Width="105" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding SubkFlag}" Width="70" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="60"/>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="150" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="품 목 명"
                                Binding="{Binding MastName}"
                                Width="230"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="180"/>
                            <DataGridTextColumn Header="LOT-NO"
                                Binding="{Binding SubkLotno}"
                                Width="160"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="재고중량"
                                Binding="{Binding SubkWgt, StringFormat={}{0:N2}}"
                                Width="110"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90"/>
                            <DataGridTextColumn Header="예약중량"
                                Binding="{Binding SubkRwgt, StringFormat={}{0:N2}}"
                                Width="110"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90"/>
                            <DataGridTextColumn Header="BOX-NO"
                                Binding="{Binding SubkBoxno}"
                                Width="130"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="입고일자" Binding="{Binding SubkIndate}" Width="110" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="입고시간" Binding="{Binding SubkIntime}" Width="100" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource ScreenCardStyle}">
                <DockPanel>
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8" DockPanel.Dock="Top">
                        <Grid MinHeight="36" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="출고예약 데이터" Grid.Column="0" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}"/>
                        </Grid>
                    </Border>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8" DockPanel.Dock="Top">
                        <Button Margin="8,0,0,8" Command="{Binding ReserveCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" AutomationProperties.Name="출고예약">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ScreenConfirmIconGeometry}"
                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Margin="0,0,8,0"/>
                                <TextBlock Text="출고예약" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,8"
                            Command="{Binding DeleteWorkCommand}"
                            Style="{StaticResource ScreenSecondaryButtonStyle}"
                            AutomationProperties.Name="라인취소">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ScreenDeleteIconGeometry}"
                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Margin="0,0,8,0"/>
                                <TextBlock Text="라인취소" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearWorkCommand}"
                            Style="{StaticResource ScreenSecondaryButtonStyle}"
                            Margin="8,0,0,8"
                            AutomationProperties.Name="전체취소">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ScreenDeleteIconGeometry}"
                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Margin="0,0,8,0"/>
                                <TextBlock Text="전체취소" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <DataGrid ItemsSource="{Binding WorkItems}"
                        SelectedItem="{Binding SelectedWorkItem, Mode=TwoWay}"
                        Style="{StaticResource ScreenDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        HeadersVisibility="Column"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        GridLinesVisibility="None"
                        MinHeight="96">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="저장위치" Binding="{Binding SubkLoca}" Width="100" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="PLT-NO"
                                Binding="{Binding SubkPltno}"
                                Width="120"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="140" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="품 목 명"
                                Binding="{Binding MastName}"
                                Width="200"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="180"/>
                            <DataGridTextColumn Header="LOT-NO"
                                Binding="{Binding SubkLotno}"
                                Width="150"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="BOX-NO"
                                Binding="{Binding SubkBoxno}"
                                Width="120"
                                ElementStyle="{StaticResource ScreenCellTextStyle}"
                                MinWidth="112"/>
                            <DataGridTextColumn Header="비 고"
                                Binding="{Binding SubkRemark}"
                                Width="160"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="150"/>
                            <DataGridTextColumn Header="재고수량"
                                Binding="{Binding StockQty, StringFormat={}{0:N2}}"
                                Width="100"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90"/>
                            <DataGridTextColumn Header="지시수량"
                                Binding="{Binding RequestQty, StringFormat={}{0:N2}}"
                                Width="100"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90"/>
                            <DataGridTextColumn Header="납품처"
                                Binding="{Binding Customer}"
                                Width="180"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="180"/>
                            <DataGridTextColumn Header="출고 BOX" Binding="{Binding OutBoxno}" Width="120" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="98"/>
                            <DataGridTextColumn Header="출고 비고"
                                Binding="{Binding OutRemark}"
                                Width="*"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="150"/>
                            <DataGridTextColumn Header="출고대" Binding="{Binding Wsno}" Width="80" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="90"
                Background="#45000000"
                Visibility="{Binding IsEditPanelVisible, Converter={StaticResource BoolToVisibility}}"/>
            <Border Grid.Row="0"
                Grid.RowSpan="3"
                Panel.ZIndex="100"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding IsEditPanelVisible, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource ScreenCardStyle}"
                MaxWidth="1050"
                MaxHeight="620"
                Margin="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12" MinHeight="42">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource ScreenPackageIconGeometry}"
                                Style="{StaticResource ScreenToolbarIconStyle}"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Stroke="{DynamicResource AppTextBrush}"
                                Margin="0,0,8,0"/>
                            <TextBlock Text="출고 등록" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource ScreenSecondaryButtonStyle}"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="닫기">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource OutboundCloseIconGeometry}"
                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                    Focusable="False"
                                    IsHitTestVisible="False"
                                    Margin="0,0,8,0"/>
                                <TextBlock Text="닫기" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                        <StackPanel>
                            <WrapPanel Orientation="Horizontal" Margin="0,0,-16,0">
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="위치:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding LocaEdit}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PLT-NO:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PltnoEdit}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="품명:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding ItemNameEdit}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="품목코드:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding ItemCodeEdit}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="LOT-NO:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding LotnoEdit}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BOX-NO:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding BoxNoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PopupInputBox}"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="실재고:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding RealStockQty}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="가능수량:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding AvailableQty}"
                                        Style="{StaticResource PopupInputBox}"
                                        IsReadOnly="True"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="지시수량:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding RequestQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PopupInputBox}"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="비고:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding RemarkEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PopupInputBox}"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="납품처:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding CustomerEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PopupInputBox}"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                                <Grid Width="300" Margin="0,0,16,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="출고 BOX:" Style="{StaticResource PopupLabel}" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding OutBoxNoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource PopupInputBox}"
                                        Height="36"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Padding="8,2"
                                        Grid.Column="1"/>
                                </Grid>
                            </WrapPanel>
                            <WrapPanel Orientation="Horizontal">
                                <Border Margin="0,4,16,12"
                                    MinHeight="100"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    Width="440"
                                    Style="{StaticResource ScreenCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,10" Grid.Row="0">
                                            <TextBlock Text="출고 스테이션" Style="{StaticResource SectionTitleTextStyle}"/>
                                        </Border>
                                        <ListBox SelectedValue="{Binding SelectedWsno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Tag"
                                            SelectionMode="Single"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalContentAlignment="Stretch"
                                            Grid.Row="1"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBoxItem Tag="{Binding StationStatus.Station1No}">
                                                <RadioButton GroupName="OutputStation"
                                                    Style="{StaticResource StationRadioStyle}"
                                                    Margin="0,0,8,8"
                                                    IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="출고대 #" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding StationStatus.Station1No}" Margin="4,0,0,0" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding StationStatus.Station1ModeText}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </ListBoxItem>
                                            <ListBoxItem Tag="{Binding StationStatus.Station2No}">
                                                <RadioButton GroupName="OutputStation"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource StationRadioStyle}"
                                                    IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="출고대 #" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding StationStatus.Station2No}" Margin="4,0,0,0" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding StationStatus.Station2ModeText}" Margin="9,0,0,0"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </ListBoxItem>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,4,0,12" Width="440">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="85"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="출고 비고:" Style="{StaticResource PopupLabel}"/>
                                        <TextBox Grid.Column="1"
                                            Height="36"
                                            VerticalAlignment="Center"
                                            Text="{Binding OutRemarkEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource PopupInputBox}"
                                            FontSize="14"
                                            VerticalContentAlignment="Center"
                                            Padding="8,2"/>
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0" Grid.Row="2">
                                        <Button Command="{Binding AddWorkCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="추가">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource ScreenPlusIconGeometry}"
                                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                                    Focusable="False"
                                                    IsHitTestVisible="False"
                                                    Margin="0,0,8,0"/>
                                                <TextBlock Text="추가" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DirectOutputCommand}"
                                            Style="{StaticResource ScreenPrimaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="바로출고">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource ScreenConfirmIconGeometry}"
                                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                                    Focusable="False"
                                                    IsHitTestVisible="False"
                                                    Margin="0,0,8,0"/>
                                                <TextBlock Text="바로출고" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding CancelEditCommand}"
                                            Style="{StaticResource ScreenSecondaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            AutomationProperties.Name="취소">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource ScreenRefreshIconGeometry}"
                                                    Style="{StaticResource ScreenToolbarIconStyle}"
                                                    Focusable="False"
                                                    IsHitTestVisible="False"
                                                    Margin="0,0,8,0"/>
                                                <TextBlock Text="취소" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
