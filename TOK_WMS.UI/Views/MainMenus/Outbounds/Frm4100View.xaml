<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4100View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>


        <!-- ===================================================== -->
        <!-- 검색 Label -->
        <!-- ===================================================== -->

        <Style x:Key="FilterLabel"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

        </Style>


        <!-- ===================================================== -->
        <!-- 검색 TextBox -->
        <!-- ===================================================== -->

        <Style x:Key="InputBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Style.Triggers>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BtnPrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- Popup Label -->
        <!-- ===================================================== -->

        <Style x:Key="PopupLabel"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="HorizontalAlignment"
                    Value="Right"/>

            <!-- 자기 TextBox 바로 옆 -->
            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

        </Style>


        <!-- ===================================================== -->
        <!-- Popup TextBox -->
        <!-- ===================================================== -->

        <Style x:Key="PopupInputBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Style.Triggers>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BtnPrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- 출고 Station Radio -->
        <!-- ===================================================== -->

        <Style x:Key="StationRadioStyle"
               TargetType="RadioButton">

            <Setter Property="MinWidth"
                    Value="175"/>

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AppBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="22"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <!-- 선택 원 -->

                                <Border Width="16"
                                        Height="16"
                                        CornerRadius="8"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                    <Ellipse x:Name="CheckDot"
                                             Width="8"
                                             Height="8"
                                             Fill="{DynamicResource BtnPrimaryBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="Collapsed"/>

                                </Border>


                                <ContentPresenter Grid.Column="1"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"/>

                            </Grid>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked"
                                     Value="True">

                                <Setter TargetName="RootBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BtnPrimaryBrush}"/>

                                <Setter TargetName="RootBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                                <Setter TargetName="CheckDot"
                                        Property="Visibility"
                                        Value="Visible"/>

                            </Trigger>


                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="RootBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource BtnPrimaryBrush}"/>

                            </Trigger>


                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="RootBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- 전체 -->
    <!-- ========================================================= -->

    <DockPanel Margin="12">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid DockPanel.Dock="Top"
              Height="55"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📤"
                           FontSize="20"
                           Margin="0,0,8,0"/>

                <TextBlock Text="재고 출고 등록"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextBrush}"/>
                <TextBlock Text="- Frm4100" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>


            <CheckBox Grid.Column="1"
                      Content="⚠ 긴급출고"
                      IsChecked="{Binding IsEmergency}"
                      VerticalAlignment="Center"
                      FontSize="14"
                      FontWeight="Bold"
                      Margin="0,0,15,0"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- 검색 -->
        <!-- ===================================================== -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="210"/>

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="270"/>

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="190"/>

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- 품목코드 -->

                <TextBlock Grid.Column="0"
                           Text="품목코드:"
                           Style="{StaticResource FilterLabel}"/>


                <TextBox Grid.Column="1"
                         Text="{Binding ItemCodeSrc,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         Style="{StaticResource InputBox}">

                    <TextBox.InputBindings>

                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>

                    </TextBox.InputBindings>

                </TextBox>


                <!-- 품명 -->

                <TextBlock Grid.Column="3"
                           Text="품명:"
                           Style="{StaticResource FilterLabel}"/>


                <TextBox Grid.Column="4"
                         Text="{Binding ItemNameSrc,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputBox}">

                    <TextBox.InputBindings>

                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>

                    </TextBox.InputBindings>

                </TextBox>


                <!-- LOT -->

                <TextBlock Grid.Column="6"
                           Text="LOT-NO:"
                           Style="{StaticResource FilterLabel}"/>


                <TextBox Grid.Column="7"
                         Text="{Binding LotNoSrc,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         Style="{StaticResource InputBox}">

                    <TextBox.InputBindings>

                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>

                    </TextBox.InputBindings>

                </TextBox>


                <!-- 조회 -->

                <Button Grid.Column="9"
                        Content="🔍 조회"
                        Width="95"
                        Height="34"
                        Command="{Binding SearchCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN -->
        <!-- ===================================================== -->

        <Grid>

            <Grid.RowDefinitions>

                <!-- 재고 자료 -->

                <RowDefinition Height="2.2*"/>


                <!-- 팔레트 자료 -->

                <RowDefinition Height="1.15*"/>


                <!-- 출고 예약 -->

                <RowDefinition Height="1.3*"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- 재고 자료 -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    Margin="0,0,0,8">

                <DockPanel>


                    <Grid DockPanel.Dock="Top"
                          Height="38"
                          Margin="0,0,0,7">

                        <TextBlock Text="📦 재고 자료 정보"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>


                        <TextBlock Text="※ 행 더블클릭 → 출고 등록"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextSubBrush}"/>

                    </Grid>


                    <DataGrid x:Name="StockGrid"
                              ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem,
                                                     Mode=TwoWay}"
                              Style="{StaticResource ListDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>


                            <DataGridTextColumn Header="재고위치"
                                                Binding="{Binding SubkLoca}"
                                                Width="110"/>


                            <DataGridTextColumn Header="PLT-NO"
                                                Binding="{Binding SubkPltno}"
                                                Width="130"/>


                            <DataGridTextColumn Header="품목코드"
                                                Binding="{Binding SubkCode}"
                                                Width="160"/>


                            <DataGridTextColumn Header="품 목 명"
                                                Binding="{Binding MastName}"
                                                Width="240"/>


                            <DataGridTextColumn Header="LOT-NO"
                                                Binding="{Binding SubkLotno}"
                                                Width="180"/>


                            <DataGridTextColumn Header="재고중량"
                                                Binding="{Binding SubkWgt,
                                                StringFormat={}{0:N2}}"
                                                Width="110"/>


                            <DataGridTextColumn Header="BOX-NO"
                                                Binding="{Binding SubkBoxno}"
                                                Width="140"/>


                            <DataGridTextColumn Header="비 고"
                                                Binding="{Binding SubkRemark}"
                                                Width="*"/>

                        </DataGrid.Columns>


                        <!-- 더블클릭 -->

                        <i:Interaction.Triggers>

                            <i:EventTrigger EventName="MouseDoubleClick">

                                <i:InvokeCommandAction
                                    Command="{Binding StockDoubleClickCommand}"
                                    CommandParameter="{Binding SelectedItem,
                                    ElementName=StockGrid}"/>

                            </i:EventTrigger>

                        </i:Interaction.Triggers>

                    </DataGrid>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- 팔레트 자료 -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8"
                    Margin="0,0,0,8">

                <DockPanel>


                    <TextBlock DockPanel.Dock="Top"
                               Text="📦 팔레트 자료 정보"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,3,0,8"/>


                    <DataGrid ItemsSource="{Binding PalletItems}"
                              SelectedItem="{Binding SelectedPalletItem,
                                                     Mode=TwoWay}"
                              Style="{StaticResource ListDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>


                            <DataGridTextColumn Header="재고위치"
                                                Binding="{Binding SubkLoca}"
                                                Width="105"/>


                            <DataGridTextColumn Header="상태"
                                                Binding="{Binding SubkFlag}"
                                                Width="70"/>


                            <DataGridTextColumn Header="품목코드"
                                                Binding="{Binding SubkCode}"
                                                Width="150"/>


                            <DataGridTextColumn Header="품 목 명"
                                                Binding="{Binding MastName}"
                                                Width="230"/>


                            <DataGridTextColumn Header="LOT-NO"
                                                Binding="{Binding SubkLotno}"
                                                Width="160"/>


                            <DataGridTextColumn Header="재고중량"
                                                Binding="{Binding SubkWgt,
                                                StringFormat={}{0:N2}}"
                                                Width="110"/>


                            <DataGridTextColumn Header="예약중량"
                                                Binding="{Binding SubkRwgt,
                                                StringFormat={}{0:N2}}"
                                                Width="110"/>


                            <DataGridTextColumn Header="BOX-NO"
                                                Binding="{Binding SubkBoxno}"
                                                Width="130"/>


                            <DataGridTextColumn Header="입고일자"
                                                Binding="{Binding SubkIndate}"
                                                Width="110"/>


                            <DataGridTextColumn Header="입고시간"
                                                Binding="{Binding SubkIntime}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- 출고예약 데이터 -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8">

                <DockPanel>


                    <Grid DockPanel.Dock="Top"
                          Height="42"
                          Margin="0,0,0,8">

                        <TextBlock Text="📌 출고예약 데이터"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>


                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">


                            <Button Content="✅ 출고예약"
                                    Width="110"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Command="{Binding ReserveCommand}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="{DynamicResource BtnPrimaryBrush}"
                                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                            <Button Content="↩ 라인취소"
                                    Width="105"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Command="{Binding DeleteWorkCommand}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="{DynamicResource BtnStadardBrush}"
                                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                            <Button Content="❌ 전체취소"
                                    Width="105"
                                    Height="34"
                                    Command="{Binding ClearWorkCommand}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="{DynamicResource BtnStadardBrush}"
                                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                        </StackPanel>

                    </Grid>


                    <DataGrid ItemsSource="{Binding WorkItems}"
                              SelectedItem="{Binding SelectedWorkItem,
                                                     Mode=TwoWay}"
                              Style="{StaticResource ListDataGridStyle}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>


                            <DataGridTextColumn Header="저장위치"
                                                Binding="{Binding SubkLoca}"
                                                Width="100"/>


                            <DataGridTextColumn Header="PLT-NO"
                                                Binding="{Binding SubkPltno}"
                                                Width="120"/>


                            <DataGridTextColumn Header="품목코드"
                                                Binding="{Binding SubkCode}"
                                                Width="140"/>


                            <DataGridTextColumn Header="품 목 명"
                                                Binding="{Binding MastName}"
                                                Width="200"/>


                            <DataGridTextColumn Header="LOT-NO"
                                                Binding="{Binding SubkLotno}"
                                                Width="150"/>


                            <DataGridTextColumn Header="BOX-NO"
                                                Binding="{Binding SubkBoxno}"
                                                Width="120"/>


                            <DataGridTextColumn Header="비 고"
                                                Binding="{Binding SubkRemark}"
                                                Width="160"/>


                            <DataGridTextColumn Header="재고수량"
                                                Binding="{Binding StockQty,
                                                StringFormat={}{0:N2}}"
                                                Width="100"/>


                            <DataGridTextColumn Header="지시수량"
                                                Binding="{Binding RequestQty,
                                                StringFormat={}{0:N2}}"
                                                Width="100"/>


                            <DataGridTextColumn Header="납품처"
                                                Binding="{Binding Customer}"
                                                Width="140"/>


                            <DataGridTextColumn Header="출고 BOX"
                                                Binding="{Binding OutBoxno}"
                                                Width="120"/>


                            <DataGridTextColumn Header="출고 비고"
                                                Binding="{Binding OutRemark}"
                                                Width="*"/>


                            <DataGridTextColumn Header="출고대"
                                                Binding="{Binding Wsno}"
                                                Width="80"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </DockPanel>

            </Border>


            <!-- ================================================= -->
            <!-- Popup 뒤 Overlay -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Panel.ZIndex="90"
                    Background="#45000000"
                    Visibility="{Binding IsEditPanelVisible,
                                 Converter={StaticResource BoolToVisibility}}"/>


            <!-- ================================================= -->
            <!-- 출고 등록 Popup -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Grid.RowSpan="3"
                    Panel.ZIndex="100"
                    Width="1050"
                    MinHeight="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="#58A6FF"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="18"
                    Visibility="{Binding IsEditPanelVisible,
                                 Converter={StaticResource BoolToVisibility}}">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="18"
                                      ShadowDepth="4"
                                      Opacity="0.35"/>

                </Border.Effect>


                <DockPanel>


                    <!-- ============================================= -->
                    <!-- Popup Header -->
                    <!-- ============================================= -->

                    <Grid DockPanel.Dock="Top"
                          Height="46"
                          Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock Text="📤"
                                       FontSize="20"
                                       Margin="0,0,8,0"/>

                            <TextBlock Text="출고 등록"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>

                        </StackPanel>


                        <Button Grid.Column="1"
                                Content="✕"
                                Width="38"
                                Height="32"
                                Command="{Binding CancelEditCommand}"
                                FontWeight="Bold"
                                Cursor="Hand"
                                BorderThickness="0"
                                Background="{DynamicResource BtnStadardBrush}"
                                Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                    </Grid>


                    <!-- ============================================= -->
                    <!-- Popup Body -->
                    <!-- ============================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <!-- 첫 번째 -->

                            <ColumnDefinition Width="85"/>

                            <ColumnDefinition Width="190"/>


                            <!-- 그룹 간격 -->

                            <ColumnDefinition Width="32"/>


                            <!-- 두 번째 -->

                            <ColumnDefinition Width="85"/>

                            <ColumnDefinition Width="190"/>


                            <!-- 그룹 간격 -->

                            <ColumnDefinition Width="32"/>


                            <!-- 세 번째 -->

                            <ColumnDefinition Width="85"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <Grid.RowDefinitions>

                            <RowDefinition Height="46"/>

                            <RowDefinition Height="46"/>

                            <RowDefinition Height="46"/>

                            <RowDefinition Height="46"/>

                            <!--
                                Station + 출고비고 + Button 크기에
                                자동으로 맞춤
                            -->

                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- ========================================= -->
                        <!-- ROW 0 -->
                        <!-- ========================================= -->

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="위치:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding LocaEdit}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Text="PLT-NO:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="0"
                                 Grid.Column="4"
                                 Text="{Binding PltnoEdit}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <TextBlock Grid.Row="0"
                                   Grid.Column="6"
                                   Text="품명:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="0"
                                 Grid.Column="7"
                                 Text="{Binding ItemNameEdit}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <!-- ========================================= -->
                        <!-- ROW 1 -->
                        <!-- ========================================= -->

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="품목코드:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ItemCodeEdit}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="LOT-NO:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="1"
                                 Grid.Column="4"
                                 Text="{Binding LotnoEdit}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <TextBlock Grid.Row="1"
                                   Grid.Column="6"
                                   Text="BOX-NO:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="1"
                                 Grid.Column="7"
                                 Text="{Binding BoxNoEdit,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PopupInputBox}"/>


                        <!-- ========================================= -->
                        <!-- ROW 2 -->
                        <!-- ========================================= -->

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="실재고:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding RealStockQty}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="가능수량:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="2"
                                 Grid.Column="4"
                                 Text="{Binding AvailableQty}"
                                 Style="{StaticResource PopupInputBox}"
                                 IsReadOnly="True"/>


                        <TextBlock Grid.Row="2"
                                   Grid.Column="6"
                                   Text="지시수량:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="2"
                                 Grid.Column="7"
                                 Text="{Binding RequestQty,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PopupInputBox}"/>


                        <!-- ========================================= -->
                        <!-- ROW 3 -->
                        <!-- ========================================= -->

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="비고:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding RemarkEdit,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PopupInputBox}"/>


                        <TextBlock Grid.Row="3"
                                   Grid.Column="3"
                                   Text="납품처:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="3"
                                 Grid.Column="4"
                                 Text="{Binding CustomerEdit,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PopupInputBox}"/>


                        <TextBlock Grid.Row="3"
                                   Grid.Column="6"
                                   Text="출고 BOX:"
                                   Style="{StaticResource PopupLabel}"/>


                        <TextBox Grid.Row="3"
                                 Grid.Column="7"
                                 Text="{Binding OutBoxNoEdit,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PopupInputBox}"/>


                        <!-- ========================================= -->
                        <!-- ROW 4 LEFT -->
                        <!-- 출고 Station -->
                        <!-- ========================================= -->

                        <Border Grid.Row="4"
                                Grid.Column="0"
                                Grid.ColumnSpan="5"
                                Margin="0,14,14,0"
                                Padding="12"
                                MinHeight="100"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="Auto"/>

                                </Grid.RowDefinitions>


                                <TextBlock Grid.Row="0"
                                           Text="🚚 출고 스테이션"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"
                                           Foreground="{DynamicResource BtnPrimaryBrush}"/>


                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal">


                                    <!-- Station 1 -->

                                    <RadioButton GroupName="OutputStation"
                                                 Style="{StaticResource StationRadioStyle}"
                                                 Command="{Binding SelectStationCommand}"
                                                 CommandParameter="{Binding StationStatus.Station1No}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="출고대 #"
                                                       FontWeight="Bold"/>


                                            <TextBlock Text="{Binding StationStatus.Station1No}"
                                                       Margin="4,0,0,0"
                                                       FontWeight="Bold"/>


                                            <TextBlock Text="{Binding StationStatus.Station1ModeText}"
                                                       Margin="9,0,0,0"/>

                                        </StackPanel>

                                    </RadioButton>


                                    <!-- Station 2 -->

                                    <RadioButton GroupName="OutputStation"
                                                 Margin="12,0,0,0"
                                                 Style="{StaticResource StationRadioStyle}"
                                                 Command="{Binding SelectStationCommand}"
                                                 CommandParameter="{Binding StationStatus.Station2No}">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="출고대 #"
                                                       FontWeight="Bold"/>


                                            <TextBlock Text="{Binding StationStatus.Station2No}"
                                                       Margin="4,0,0,0"
                                                       FontWeight="Bold"/>


                                            <TextBlock Text="{Binding StationStatus.Station2ModeText}"
                                                       Margin="9,0,0,0"/>

                                        </StackPanel>

                                    </RadioButton>

                                </StackPanel>

                            </Grid>

                        </Border>


                        <!-- ========================================= -->
                        <!-- ROW 4 RIGHT -->
                        <!-- 출고 비고 + 버튼 -->
                        <!-- ========================================= -->

                        <Grid Grid.Row="4"
                              Grid.Column="6"
                              Grid.ColumnSpan="2"
                              Margin="0,14,0,0"
                              VerticalAlignment="Top">

                            <Grid.RowDefinitions>

                                <!-- 비고 -->

                                <RowDefinition Height="40"/>


                                <!-- 간격 -->

                                <RowDefinition Height="12"/>


                                <!-- 버튼 -->

                                <RowDefinition Height="40"/>

                            </Grid.RowDefinitions>


                            <!-- ===================================== -->
                            <!-- 출고 비고 -->
                            <!-- ===================================== -->

                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="85"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="출고 비고:"
                                           Style="{StaticResource PopupLabel}"/>


                                <TextBox Grid.Column="1"
                                         Height="34"
                                         VerticalAlignment="Center"
                                         Text="{Binding OutRemarkEdit,
                                                        Mode=TwoWay,
                                                        UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PopupInputBox}"/>

                            </Grid>


                            <!-- ===================================== -->
                            <!-- Buttons -->
                            <!-- ===================================== -->

                            <Grid Grid.Row="2"
                                  Margin="85,0,0,0"
                                  HorizontalAlignment="Left">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="95"/>

                                    <ColumnDefinition Width="10"/>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="10"/>

                                    <ColumnDefinition Width="80"/>

                                </Grid.ColumnDefinitions>


                                <!-- 추가 -->

                                <Button Grid.Column="0"
                                        Content="➕ 추가"
                                        Height="38"
                                        Command="{Binding AddWorkCommand}"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="{DynamicResource BtnPrimaryBrush}"
                                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                                <!-- 바로출고 -->

                                <Button Grid.Column="2"
                                        Content="⚡ 바로출고"
                                        Height="38"
                                        Command="{Binding DirectOutputCommand}"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="{DynamicResource BtnPrimaryBrush}"
                                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                                <!-- 취소 -->

                                <Button Grid.Column="4"
                                        Content="취소"
                                        Height="38"
                                        Command="{Binding CancelEditCommand}"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Background="{DynamicResource BtnStadardBrush}"
                                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                            </Grid>

                        </Grid>

                    </Grid>

                </DockPanel>

            </Border>

        </Grid>

    </DockPanel>

</UserControl>