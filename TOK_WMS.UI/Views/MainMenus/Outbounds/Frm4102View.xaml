<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
    x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4102View"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource AppTextBrush}"
    FontFamily="{StaticResource AppFont}"
    FontWeight="Medium"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="OutboundCloseIconGeometry">M 5,5 L 19,19 M 19,5 L 5,19</Geometry>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top"
            Margin="0,0,0,16"
            x:Name="OutboundHeaderGrid"
            behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=OutboundToolbar}"
            behaviors:ResponsiveHeader.StackBelowWidth="850">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}"
                        Style="{StaticResource ScreenToolbarIconStyle}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Stroke="{DynamicResource AppTextBrush}"/>
                </Border>
                <TextBlock Text="출고지시" VerticalAlignment="Center" Style="{StaticResource ScreenTitleTextStyle}"/>
                <TextBlock Text="Frm4102" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ScreenSubtitleTextStyle}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ItemHeight="50"
                x:Name="OutboundToolbar"
                Grid.Column="1">
                <Button Margin="8,0,0,0"
                    Command="{Binding ExcelCommand}"
                    CommandParameter="{Binding ElementName=ExportDataGrid}"
                    Style="{StaticResource ScreenExcelButtonStyle}"
                    AutomationProperties.Name="엑셀">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenExcelIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"
                            Stroke="{StaticResource Frm3300ExcelAccentBrush}"/>
                        <TextBlock Text="엑셀" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" AutomationProperties.Name="삭제">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenDeleteIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="삭제" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.Name="종료">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="종료" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource ScreenCardStyle}">
            <DockPanel>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,-8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="출고 의뢰일자" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                        <DatePicker SelectedDate="{Binding OutDate, Mode=TwoWay}"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Width="160"
                            Margin="0"
                            VerticalAlignment="Center" Style="{StaticResource ScreenFilterDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품목 코드" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14"/>
                        <TextBox Text="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Height="36"
                            Padding="8,2"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Width="220"
                            Margin="0"
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,0,8" AutomationProperties.Name="조회">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ScreenSearchIconGeometry}"
                                Style="{StaticResource ScreenToolbarIconStyle}"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Margin="0,0,8,0"/>
                            <TextBlock Text="조회" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12" DockPanel.Dock="Top">
            <CheckBox Content="전체선택"
                IsChecked="{Binding IsAllSelected, Mode=TwoWay}"
                Margin="0,0,12,8"
                FontWeight="Bold"
                FontSize="14"
                VerticalContentAlignment="Center"
                MinHeight="36"/>
            <Button Command="{Binding ReserveCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,12,8" AutomationProperties.Name="출고확정">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ScreenConfirmIconGeometry}"
                        Style="{StaticResource ScreenToolbarIconStyle}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Margin="0,0,8,0"/>
                    <TextBlock Text="출고확정" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteAllCommand}"
                Style="{StaticResource ScreenSecondaryButtonStyle}"
                Margin="0,0,12,8"
                AutomationProperties.Name="전체삭제">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource ScreenDeleteIconGeometry}"
                        Style="{StaticResource ScreenToolbarIconStyle}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Margin="0,0,8,0"/>
                    <TextBlock Text="전체삭제" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </WrapPanel>
        <Border Style="{StaticResource ScreenCardStyle}">
            <DataGrid x:Name="ExportDataGrid"
                ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                Style="{StaticResource ScreenDataGridStyle}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                IsReadOnly="True"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                HeadersVisibility="Column"
                RowHeaderWidth="0"
                BorderThickness="0"
                GridLinesVisibility="None"
                MinHeight="96">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="체크" Width="60" MinWidth="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    MinHeight="36"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusName}" Width="80" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="60"/>
                    <DataGridTextColumn Header="차수" Binding="{Binding HoChasu}" Width="80" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="60"/>
                    <DataGridTextColumn Header="수신일자" Binding="{Binding HoDate}" Width="120" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                    <DataGridTextColumn Header="품목코드" Binding="{Binding HoCode}" Width="160" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                    <DataGridTextColumn Header="품목명"
                        Binding="{Binding MastName}"
                        Width="220"
                        ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                        MinWidth="180"/>
                    <DataGridTextColumn Header="LOT-NO" Binding="{Binding HoLotno}" Width="150" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="112"/>
                    <DataGridTextColumn Header="납품처" Binding="{Binding HoCust}" Width="180" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="180"/>
                    <DataGridTextColumn Header="수신수량"
                        Binding="{Binding HoQty, StringFormat={}{0:N0}}"
                        Width="110"
                        ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                        MinWidth="90"/>
                    <DataGridTextColumn Header="출고수량"
                        Binding="{Binding HoOutQty, StringFormat={}{0:N0}}"
                        Width="110"
                        ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                        MinWidth="90"/>
                    <DataGridTextColumn Header="재고수량"
                        Binding="{Binding StokQty, StringFormat={}{0:N0}}"
                        Width="110"
                        ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                        MinWidth="90"/>
                    <DataGridTextColumn Header="BOX NO" Binding="{Binding HoBoxno}" Width="140" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="98"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding HoRemark}" Width="*" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="150"/>
                    <DataGridTextColumn Header="수신시간" Binding="{Binding HoTime}" Width="100" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
