<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4102View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium">

    <DockPanel Margin="12">

        <!-- 상단 -->
        <Grid DockPanel.Dock="Top"
              Height="55"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📤"
                           FontSize="20"
                           Margin="0,0,8,0"/>

                <TextBlock Text="출고지시"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>

            </StackPanel>


            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button Content="📊 엑셀"
                        Width="100"
                        Height="40"
                        Margin="0,0,15,0"
                        Command="{Binding ExcelCommand}"
                        Background="ForestGreen" 
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"/>

                <Button Content="🗑 삭제"
                        Width="100"
                        Height="40"
                        Margin="0,0,15,0"
                        Command="{Binding DeleteCommand}"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"/>

                <Button Content="⏻ 종료"
                        Width="100"
                        Height="40"
                        Command="{Binding EndCommand}"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"/>

            </StackPanel>

        </Grid>


        <!-- 검색 -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="30"/>

                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <TextBlock Text="출고 의뢰일자"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <DatePicker Grid.Column="1"
                            SelectedDate="{Binding OutDate,
                                                  Mode=TwoWay}"
                            Height="35"/>


                <TextBlock Grid.Column="3"
                           Text="품목 코드"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="4"
                         Text="{Binding ItemCode,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Height="35"
                         Padding="8">

                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>

                </TextBox>


                <Button Grid.Column="6"
                        Content="🔍 조회"
                        Height="35"
                        Command="{Binding SearchCommand}"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"/>

            </Grid>

        </Border>


        <!-- 작업버튼 -->
        <Grid DockPanel.Dock="Top"
              Height="50"
              Margin="0,0,0,8">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <CheckBox Content="전체선택"
                          IsChecked="{Binding IsAllSelected,
                                              Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="5,0,30,0"
                          FontWeight="Bold"/>


                <Button Content="✅ 출고확정"
                        Width="120"
                        Height="38"
                        Command="{Binding ReserveCommand}"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"/>

            </StackPanel>


            <Button Content="⚠ 전체삭제"
                    Width="120"
                    Height="38"
                    HorizontalAlignment="Right"
                    Command="{Binding DeleteAllCommand}"
                    Background="{DynamicResource BtnStadardBrush}"
                    Foreground="{DynamicResource BtnPrimaryTextBrush}"
                    BorderThickness="0"
                    FontWeight="Bold"/>

        </Grid>


        <!-- DataGrid -->
        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="5">

            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem,
                                            Mode=TwoWay}"
                      Style="{StaticResource ListDataGridStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="체크"
                                            Width="60">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <CheckBox IsChecked="{Binding IsSelected,
                                                             Mode=TwoWay,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>


                    <DataGridTextColumn Header="상태"
                                        Binding="{Binding StatusName}"
                                        Width="80"/>

                    <DataGridTextColumn Header="차수"
                                        Binding="{Binding HoChasu}"
                                        Width="80"/>

                    <DataGridTextColumn Header="수신일자"
                                        Binding="{Binding HoDate}"
                                        Width="120"/>

                    <DataGridTextColumn Header="품목코드"
                                        Binding="{Binding HoCode}"
                                        Width="160"/>

                    <DataGridTextColumn Header="품목명"
                                        Binding="{Binding MastName}"
                                        Width="220"/>

                    <DataGridTextColumn Header="LOT-NO"
                                        Binding="{Binding HoLotno}"
                                        Width="150"/>

                    <DataGridTextColumn Header="납품처"
                                        Binding="{Binding HoCust}"
                                        Width="160"/>

                    <DataGridTextColumn Header="수신수량"
                                        Binding="{Binding HoQty,
                                                          StringFormat={}{0:N0}}"
                                        Width="110"/>

                    <DataGridTextColumn Header="출고수량"
                                        Binding="{Binding HoOutQty,
                                                          StringFormat={}{0:N0}}"
                                        Width="110"/>

                    <DataGridTextColumn Header="재고수량"
                                        Binding="{Binding StokQty,
                                                          StringFormat={}{0:N0}}"
                                        Width="110"/>

                    <DataGridTextColumn Header="BOX NO"
                                        Binding="{Binding HoBoxno}"
                                        Width="140"/>

                    <DataGridTextColumn Header="비고"
                                        Binding="{Binding HoRemark}"
                                        Width="*"/>

                    <DataGridTextColumn Header="수신시간"
                                        Binding="{Binding HoTime}"
                                        Width="100"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

    </DockPanel>

</UserControl>