<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4103View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium">

    <UserControl.Resources>

        <Style x:Key="FilterLabel"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

        </Style>

    </UserControl.Resources>


    <DockPanel Margin="12">


        <!-- ================================================= -->
        <!-- Header -->
        <!-- ================================================= -->

        <Grid DockPanel.Dock="Top"
              Height="55"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📋"
                           FontSize="20"
                           Margin="0,0,8,0"/>

                <TextBlock Text="피킹리스트 발행"
                           FontSize="20"
                           FontWeight="Bold"/>
                <TextBlock Text="- Frm4103" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="⏻ 종료"
                    Width="100"
                    Height="40"
                    Command="{Binding EndCommand}"
                    Background="{DynamicResource BtnStadardBrush}"
                    Foreground="{DynamicResource BtnPrimaryTextBrush}"
                    BorderThickness="0"
                    FontWeight="Bold"/>

        </Grid>


        <!-- ================================================= -->
        <!-- 검색 -->
        <!-- ================================================= -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="15"
                Margin="0,0,0,10">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="45"/>

                    <RowDefinition Height="45"/>

                </Grid.RowDefinitions>


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="110"/>

                    <ColumnDefinition Width="250"/>

                    <ColumnDefinition Width="30"/>

                    <ColumnDefinition Width="110"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Row="0"
                           Text="출하일자"
                           Style="{StaticResource FilterLabel}"/>


                <DatePicker Grid.Row="0"
                            Grid.Column="1"
                            Height="35"
                            SelectedDate="{Binding OutDate,
                                                  Mode=TwoWay}"/>


                <TextBlock Grid.Row="1"
                           Text="차수"
                           Style="{StaticResource FilterLabel}"/>


                <ComboBox Grid.Row="1"
                          Grid.Column="1"
                          Height="35"
                          ItemsSource="{Binding ChasuItems}"
                          SelectedItem="{Binding SelectedChasu,
                                                Mode=TwoWay}"
                          DisplayMemberPath="Chasu"/>


                <Button Grid.Row="1"
                        Grid.Column="3"
                        Content="🔍 조회"
                        Width="100"
                        Height="35"
                        Command="{Binding SearchCommand}"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"
                        BorderThickness="0"
                        FontWeight="Bold"/>

            </Grid>

        </Border>


        <!-- ================================================= -->
        <!-- 상단 -->
        <!-- ================================================= -->

        <Border DockPanel.Dock="Top"
                Height="220"
                Margin="0,0,0,10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8">

            <DataGrid ItemsSource="{Binding SummaryItems}"
                      SelectedItem="{Binding SelectedSummary,
                                            Mode=TwoWay}"
                      Style="{StaticResource ListDataGridStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="작업차수"
                                        Binding="{Binding OuptChasu}"
                                        Width="180"/>


                    <DataGridTextColumn Header="제품 수"
                                        Binding="{Binding ProductCount}"
                                        Width="180"/>


                    <DataGridTextColumn Header="출고구분"
                                        Binding="{Binding JobStatus}"
                                        Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>


        <!-- ================================================= -->
        <!-- 출고 대기 -->
        <!-- ================================================= -->

        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8">

            <DockPanel>


                <Grid DockPanel.Dock="Top"
                      Height="50"
                      Background="{DynamicResource HeaderBrush}"
                      TextElement.Foreground="{DynamicResource AppTextOnPrimBrush}"
                      Margin="0,0,0,8">

                    <TextBlock Text="📌 출고 대기 현황"
                               FontSize="16"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>


                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <Button Content="🗑 삭제"
                                Width="100"
                                Height="36"
                                Margin="0,0,15,0"
                                Command="{Binding DeleteCommand}"
                                Background="{DynamicResource BtnStadardBrush}"
                                Foreground="{DynamicResource BtnPrimaryTextBrush}"
                                BorderThickness="0"
                                FontWeight="Bold"/>


                        <Button Content="✅ 출고지시"
                                Width="120"
                                Height="36"
                                Command="{Binding ConfirmCommand}"
                                Background="{DynamicResource BtnPrimaryBrush}"
                                Foreground="{DynamicResource BtnPrimaryTextBrush}"
                                BorderThickness="0"
                                FontWeight="Bold"/>

                    </StackPanel>

                </Grid>


                <DataGrid ItemsSource="{Binding ScheduleItems}"
                          SelectedItem="{Binding SelectedSchedule,
                                                Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>


                        <DataGridTextColumn Header="호기"
                                            Binding="{Binding ScheSc}"
                                            Width="80"/>


                        <DataGridTextColumn Header="입출고순번"
                                            Binding="{Binding ScheIndex}"
                                            Width="210"/>


                        <DataGridTextColumn Header="저장위치"
                                            Binding="{Binding ScheLoca}"
                                            Width="130"/>


                        <DataGridTextColumn Header="구분"
                                            Binding="{Binding ScheJobGubun}"
                                            Width="90"/>


                        <DataGridTextColumn Header="출고ST"
                                            Binding="{Binding ScheWsno}"
                                            Width="90"/>


                        <DataGridTextColumn Header="긴급"
                                            Binding="{Binding ScheEmer}"
                                            Width="90"/>


                        <DataGridTextColumn Header="일자"
                                            Binding="{Binding ScheDate}"
                                            Width="140"/>


                        <DataGridTextColumn Header="시간"
                                            Binding="{Binding ScheTime}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>


                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right"
                           Margin="0,8,5,0"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextSubBrush}"/>

            </DockPanel>

        </Border>

    </DockPanel>

</UserControl>
