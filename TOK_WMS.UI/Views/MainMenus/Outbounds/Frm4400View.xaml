<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4400View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:TOK.WMS.UI.Converters"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium">

    <UserControl.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility"/>


        <conv:DateTimeFormatConverter
            x:Key="DateTimeFormatConverter"/>


        <conv:LocaFormatConverter
            x:Key="LocaFormatConverter"/>


        <!-- ===================================================== -->
        <!-- Filter Label -->
        <!-- ===================================================== -->

        <Style x:Key="FilterLabel"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

        </Style>


        <!-- ===================================================== -->
        <!-- Filter TextBox -->
        <!-- ===================================================== -->

        <Style x:Key="FilterBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>


            <Style.Triggers>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BtnPrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>


    <!-- ========================================================= -->
    <!-- Loaded -->
    <!-- ========================================================= -->

    <i:Interaction.Triggers>

        <i:EventTrigger EventName="Loaded">

            <i:InvokeCommandAction
                Command="{Binding LoadedCommand}"/>

        </i:EventTrigger>

    </i:Interaction.Triggers>


    <DockPanel Margin="12">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid DockPanel.Dock="Top"
              Height="55"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- 제목 -->

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📤"
                           FontSize="20"
                           Margin="0,0,8,0"/>


                <TextBlock Text="출고 이력 현황"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextBrush}"/>
                <TextBlock Text="- Frm4400" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>


            <!-- 버튼 -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <!-- Excel -->

                <Button Content="📊 엑셀"
                        Width="100"
                        Height="38"
                        Margin="0,0,12,0"
                        Command="{Binding ExcelCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="ForestGreen" 
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 삭제 -->

                <Button Content="🗑 삭제"
                        Width="100"
                        Height="38"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsAdmin,
                                     Converter={StaticResource BoolToVisibility}}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- 검색 영역 -->
        <!-- ===================================================== -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- 출고일자 -->

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="145"/>

                    <ColumnDefinition Width="30"/>

                    <ColumnDefinition Width="145"/>


                    <!-- 검색조건 -->

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="140"/>

                    <ColumnDefinition Width="240"/>


                    <!-- 납품처 -->

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="180"/>


                    <!-- 조회 -->

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="95"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ============================================= -->
                <!-- 출고일자 -->
                <!-- ============================================= -->

                <TextBlock Grid.Column="0"
                           Text="출고일자:"
                           Style="{StaticResource FilterLabel}"/>


                <DatePicker Grid.Column="1"
                            Height="34"
                            SelectedDate="{Binding FromDate,
                                                 Mode=TwoWay}"/>


                <TextBlock Grid.Column="2"
                           Text="~"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>


                <DatePicker Grid.Column="3"
                            Height="34"
                            SelectedDate="{Binding ToDate,
                                                 Mode=TwoWay}"/>


                <!-- ============================================= -->
                <!-- 검색 종류 -->
                <!-- ============================================= -->

                <ComboBox Grid.Column="5"
                          Height="34"
                          ItemsSource="{Binding SearchTypes}"
                          SelectedItem="{Binding SelectedSearchType,
                                               Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource InputBrush}"
                          Foreground="{DynamicResource AppTextBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}"/>


                <!-- 검색어 -->

                <TextBox Grid.Column="6"
                         Margin="8,0,0,0"
                         Text="{Binding SearchText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilterBox}">

                    <TextBox.InputBindings>

                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>

                    </TextBox.InputBindings>

                </TextBox>


                <!-- ============================================= -->
                <!-- 납품처 -->
                <!-- ============================================= -->

                <ComboBox Grid.Column="8"
                          Height="34"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer,
                                               Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          VerticalContentAlignment="Center"
                          Background="{DynamicResource InputBrush}"
                          Foreground="{DynamicResource AppTextBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}"/>


                <!-- ============================================= -->
                <!-- 조회 -->
                <!-- ============================================= -->

                <Button Grid.Column="10"
                        Content="🔍 조회"
                        Height="34"
                        Command="{Binding SearchCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 건수 -->

                <TextBlock Grid.Column="11"
                           Text="{Binding StatusMessage}"
                           Margin="15,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextSubBrush}"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- 출고 이력 Grid -->
        <!-- ===================================================== -->

        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8">

            <DockPanel>


                <!-- Grid Header -->

                <Grid DockPanel.Dock="Top"
                      Height="40"
                      Background="{DynamicResource HeaderBrush}"
                      TextElement.Foreground="{DynamicResource AppTextOnPrimBrush}"
                      Margin="0,0,0,7">

                    <TextBlock Text="📋 출고 이력"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>


                    <TextBlock Text="{Binding RecordCount,
                                              StringFormat=조회건수 : {0:N0}건}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextOnPrimBrush}"/>

                </Grid>


                <!-- DataGrid -->

                <DataGrid x:Name="DB_Table1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem,
                                                 Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>


                        <!-- 출고일자 -->

                        <DataGridTextColumn Header="출고일자"
                                            Binding="{Binding OuptDate,
                                            Converter={StaticResource DateTimeFormatConverter}}"
                                            Width="115"/>


                        <!-- 출고시간 -->

                        <DataGridTextColumn Header="출고시간"
                                            Binding="{Binding OuptTime,
                                            Converter={StaticResource DateTimeFormatConverter}}"
                                            Width="100"/>


                        <!-- PLT -->

                        <DataGridTextColumn Header="PLT-NO"
                                            Binding="{Binding OuptPltno}"
                                            Width="135"/>


                        <!-- 품목코드 -->

                        <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding OuptCode}"
                                            Width="150"/>


                        <!-- 품명 -->

                        <DataGridTextColumn Header="품 목 명"
                                            Binding="{Binding MastName}"
                                            Width="230"/>


                        <!-- LOT -->

                        <DataGridTextColumn Header="LOT-NO"
                                            Binding="{Binding OuptLotno}"
                                            Width="170"/>


                        <!-- 납품처 -->

                        <DataGridTextColumn Header="납품처"
                                            Binding="{Binding OuptCust}"
                                            Width="150"/>


                        <!-- 재고위치 -->

                        <DataGridTextColumn Header="재고위치"
                                            Binding="{Binding OuptLoca,
                                            Converter={StaticResource LocaFormatConverter}}"
                                            Width="110"/>


                        <!-- 재고중량 -->

                        <DataGridTextColumn Header="재고중량"
                                            Binding="{Binding OuptWgt,
                                            StringFormat={}{0:N2}}"
                                            Width="105"/>


                        <!-- 출고중량 -->

                        <DataGridTextColumn Header="출고중량"
                                            Binding="{Binding OuptOutWgt,
                                            StringFormat={}{0:N2}}"
                                            Width="105"/>


                        <!-- BOX -->

                        <DataGridTextColumn Header="BOX-NO"
                                            Binding="{Binding OuptBoxno}"
                                            Width="130"/>


                        <!-- 출고 BOX -->

                        <DataGridTextColumn Header="출고 BOX"
                                            Binding="{Binding OuptBoxno1}"
                                            Width="130"/>


                        <!-- 비고 -->

                        <DataGridTextColumn Header="비 고"
                                            Binding="{Binding OuptRemark}"
                                            Width="170"/>


                        <!-- 출고 비고 -->

                        <DataGridTextColumn Header="출고 비고"
                                            Binding="{Binding OuptRemark1}"
                                            Width="170"/>


                        <!-- 차수 -->

                        <DataGridTextColumn Header="차수"
                                            Binding="{Binding OuptChasu}"
                                            Width="80"/>


                        <!-- INDEX -->

                        <DataGridTextColumn Header="출고 INDEX"
                                            Binding="{Binding OuptIndex}"
                                            Width="150"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

    </DockPanel>

</UserControl>
