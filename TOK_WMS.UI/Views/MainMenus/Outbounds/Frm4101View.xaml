<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4101View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium"
             Loaded="UserControl_Loaded"
             x:Name="Root">

    <UserControl.Resources>

        <!-- ===================================================== -->
        <!-- Label -->
        <!-- ===================================================== -->

        <Style x:Key="FilterLabel"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

        </Style>


        <!-- ===================================================== -->
        <!-- TextBox -->
        <!-- ===================================================== -->

        <Style x:Key="FilterBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="36"/>

            <Setter Property="Padding"
                    Value="8,4"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>


            <Style.Triggers>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BtnPrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- ===================================================== -->
        <!-- Header -->
        <!-- ===================================================== -->

        <Style x:Key="Header"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#ebf4fc"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource AppBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>

    </UserControl.Resources>


    <DockPanel Margin="12">


        <!-- ===================================================== -->
        <!-- 상단 헤더 -->
        <!-- ===================================================== -->

        <Grid DockPanel.Dock="Top"
              Height="58"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <!-- 제목 -->

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📤"
                           FontSize="20"
                           Margin="0,0,8,0"/>

                <TextBlock Text="출고 엑셀 UP LOAD"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextBrush}"/>
                <TextBlock Text="- Frm4101" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>


            <!-- 버튼 -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">


                <!-- Excel -> Grid -->

                <Button Content="📗 Excel → Grid"
                        Width="130"
                        Height="40"
                        Margin="0,0,15,0"
                        Command="{Binding ExcelLoadCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 출고등록 -->

                <Button Content="📦 출고등록"
                        Width="110"
                        Height="40"
                        Margin="0,0,15,0"
                        Command="{Binding SaveCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 전체삭제 -->

                <Button Content="🗑 전체삭제"
                        Width="110"
                        Height="40"
                        Margin="0,0,15,0"
                        Command="{Binding ClearCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- Line 삭제 -->

                <Button Content="➖ 라인삭제"
                        Width="110"
                        Height="40"
                        Margin="0,0,15,0"
                        Command="{Binding DeleteRowCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 종료 -->

                <Button Content="⏻ 종료"
                        Width="100"
                        Height="40"
                        Command="{Binding EndCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- 시작 Line -->
        <!-- ===================================================== -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="100"/>

                    <ColumnDefinition Width="30"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <Border Grid.Column="0"
                        Background="#111111"
                        CornerRadius="3"
                        Padding="15,5"
                        Margin="0,0,10,0">

                    <TextBlock Text="시작 Line"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </Border>


                <TextBox Grid.Column="1"
                         Width="70"
                         HorizontalAlignment="Left"
                         Text="{Binding StartLine,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilterBox}"
                         FontWeight="Bold"/>


                <!-- 상태 -->

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusMessage}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextSubBrush}"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- DataGrid 영역 -->
        <!-- ===================================================== -->

        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10">

            <DockPanel LastChildFill="True">


                <!-- Grid Header -->

                <Border DockPanel.Dock="Top"
                        Height="40"
                        Style="{StaticResource Header}"
                        CornerRadius="5"
                        Margin="0,0,0,8">

                    <Grid>

                        <TextBlock Text="출고 Excel Data"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextBrush}"/>


                        <TextBlock Text="{Binding Items.Count,
                                                StringFormat=총 {0:N0}건}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="0,0,15,0"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppTextSubBrush}"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- DataGrid -->
                <!-- ================================================= -->

                <DataGrid x:Name="DB_Table1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem,
                                                Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          HeadersVisibility="All"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserSortColumns="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          AutoGenerateColumns="False"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">


                    <!-- ================================================= -->
                    <!-- 행 번호 -->
                    <!-- ================================================= -->

                    <DataGrid.RowHeaderStyle>

                        <Style TargetType="DataGridRowHeader">

                            <Setter Property="Width"
                                    Value="55"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Center"/>

                            <Setter Property="VerticalContentAlignment"
                                    Value="Center"/>

                            <Setter Property="FontWeight"
                                    Value="Bold"/>

                        </Style>

                    </DataGrid.RowHeaderStyle>


                    <!-- ================================================= -->
                    <!-- Columns -->
                    <!-- ================================================= -->

                    <DataGrid.Columns>


                        <!-- NO -->

                        <DataGridTextColumn Header="NO"
                                            Binding="{Binding No}"
                                            Width="70"
                                            IsReadOnly="True"/>


                        <!-- 품목코드 -->

                        <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding ItemCode,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="170"/>


                        <!-- 품명 -->

                        <DataGridTextColumn Header="품 명"
                                            Binding="{Binding ItemName,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="260"/>


                        <!-- LOTNO -->

                        <DataGridTextColumn Header="LOTNO"
                                            Binding="{Binding LotNo,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="180"/>


                        <!-- 출고수량 -->

                        <DataGridTextColumn Header="출고수량"
                                            Binding="{Binding Qty,
                                                              StringFormat={}{0:N2},
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="130">


                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="HorizontalAlignment"
                                            Value="Right"/>

                                    <Setter Property="Margin"
                                            Value="0,0,10,0"/>

                                    <Setter Property="FontWeight"
                                            Value="Bold"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>


                            <DataGridTextColumn.EditingElementStyle>

                                <Style TargetType="TextBox">

                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Right"/>

                                    <Setter Property="Padding"
                                            Value="0,0,10,0"/>

                                </Style>

                            </DataGridTextColumn.EditingElementStyle>

                        </DataGridTextColumn>


                        <!-- 납품처 -->

                        <DataGridTextColumn Header="납품처"
                                            Binding="{Binding Customer,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="190"/>


                        <!-- BOXNO -->

                        <DataGridTextColumn Header="BOXNO"
                                            Binding="{Binding BoxNo,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="160"/>


                        <!-- 비고 -->

                        <DataGridTextColumn Header="비 고"
                                            Binding="{Binding Remark,
                                                              UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

    </DockPanel>

</UserControl>