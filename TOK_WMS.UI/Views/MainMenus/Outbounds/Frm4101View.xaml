<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
    x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4101View"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource AppTextBrush}"
    FontFamily="{StaticResource AppFont}"
    FontWeight="Medium"
    Loaded="UserControl_Loaded"
    x:Name="Root"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="OutboundCloseIconGeometry">M 5,5 L 19,19 M 19,5 L 5,19</Geometry>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top"
            Margin="0,0,0,16"
            x:Name="OutboundHeaderGrid"
            behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=OutboundToolbar}"
            behaviors:ResponsiveHeader.StackBelowWidth="1050">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenUploadIconGeometry}"
                        Style="{StaticResource ScreenToolbarIconStyle}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Stroke="{DynamicResource AppTextBrush}"/>
                </Border>
                <TextBlock Text="출고 엑셀 UP LOAD" VerticalAlignment="Center" Style="{StaticResource ScreenTitleTextStyle}"/>
                <TextBlock Text="Frm4101" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ScreenSubtitleTextStyle}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ItemHeight="50"
                x:Name="OutboundToolbar"
                Grid.Column="1">
                <Button Margin="8,0,0,0"
                    Command="{Binding ExcelLoadCommand}"
                    Style="{StaticResource ScreenExcelButtonStyle}"
                    AutomationProperties.Name="Excel → Grid">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenUploadIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"
                            Stroke="{StaticResource Frm3300ExcelAccentBrush}"/>
                        <TextBlock Text="Excel → Grid" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding SaveCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" AutomationProperties.Name="출고등록">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPackageIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="출고등록" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding ClearCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" AutomationProperties.Name="전체삭제">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenDeleteIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="전체삭제" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0"
                    Command="{Binding DeleteRowCommand}"
                    Style="{StaticResource ScreenSecondaryButtonStyle}"
                    AutomationProperties.Name="라인삭제">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenDeleteIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="라인삭제" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.Name="종료">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"/>
                        <TextBlock Text="종료" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource ScreenCardStyle}">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AppTextSubBrush}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,0"
                    DockPanel.Dock="Bottom"/>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,-8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="시작 행"
                            Foreground="{DynamicResource AppTextBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                        <TextBox Width="100"
                            Text="{Binding StartLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FilterBox}"
                            FontWeight="Bold"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Padding="8,2"
                            Margin="0"
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Border Style="{StaticResource ScreenCardStyle}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Top" Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="출고 Excel Data" Grid.Column="0" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{Binding Items.Count, StringFormat=총 {0:N0}건}"
                            HorizontalAlignment="Right"
                            Margin="0"
                            Grid.Column="2"
                            TextTrimming="CharacterEllipsis"
                            Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="DB_Table1"
                    ItemsSource="{Binding Items}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    Style="{StaticResource ScreenDataGridStyle}"
                    HeadersVisibility="Column"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    CanUserSortColumns="True"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="False"
                    AutoGenerateColumns="False"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    RowHeaderWidth="0"
                    BorderThickness="0"
                    GridLinesVisibility="None"
                    MinHeight="96">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="번호"
                            Binding="{Binding No}"
                            Width="70"
                            IsReadOnly="True"
                            ElementStyle="{StaticResource ScreenCellTextStyle}"
                            MinWidth="60"/>
                        <DataGridTextColumn Header="품목코드"
                            Binding="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}"
                            Width="170"
                            ElementStyle="{StaticResource ScreenCellTextStyle}"
                            MinWidth="90"/>
                        <DataGridTextColumn Header="품 명"
                            Binding="{Binding ItemName, UpdateSourceTrigger=PropertyChanged}"
                            Width="260"
                            ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                            MinWidth="180"/>
                        <DataGridTextColumn Header="LOTNO"
                            Binding="{Binding LotNo, UpdateSourceTrigger=PropertyChanged}"
                            Width="180"
                            ElementStyle="{StaticResource ScreenCellTextStyle}"
                            MinWidth="98"/>
                        <DataGridTextColumn Header="출고수량"
                            Binding="{Binding Qty, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}"
                            Width="130"
                            ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                            MinWidth="90">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                    <Setter Property="Padding" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="납품처"
                            Binding="{Binding Customer, UpdateSourceTrigger=PropertyChanged}"
                            Width="190"
                            ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                            MinWidth="180"/>
                        <DataGridTextColumn Header="BOXNO"
                            Binding="{Binding BoxNo, UpdateSourceTrigger=PropertyChanged}"
                            Width="160"
                            ElementStyle="{StaticResource ScreenCellTextStyle}"
                            MinWidth="98"/>
                        <DataGridTextColumn Header="비 고"
                            Binding="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                            Width="*"
                            ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                            MinWidth="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
