<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
    x:Class="TOK.WMS.UI.Views.MainMenus.Outbounds.Frm4500View"
    Background="{DynamicResource AppBackgroundBrush}"
    Foreground="{DynamicResource AppTextBrush}"
    FontFamily="{StaticResource AppFont}"
    FontWeight="Medium"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Geometry x:Key="OutboundCloseIconGeometry">M 5,5 L 19,19 M 19,5 L 5,19</Geometry>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top"
            Margin="0,0,0,16"
            x:Name="OutboundHeaderGrid"
            behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=OutboundToolbar}"
            behaviors:ResponsiveHeader.StackBelowWidth="850">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}"
                        Style="{StaticResource ScreenToolbarIconStyle}"
                        Focusable="False"
                        IsHitTestVisible="False"
                        Stroke="{DynamicResource AppTextBrush}"/>
                </Border>
                <TextBlock Text="출고 실적 현황" VerticalAlignment="Center" Style="{StaticResource ScreenTitleTextStyle}"/>
                <TextBlock Text="Frm4500" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ScreenSubtitleTextStyle}"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                ItemHeight="50"
                x:Name="OutboundToolbar"
                Grid.Column="1">
                <Button Grid.Column="1"
                    Command="{Binding ExcelCommand}"
                    CommandParameter="{Binding ElementName=ItemGrid}"
                    Style="{StaticResource ScreenExcelButtonStyle}"
                    Margin="8,0,0,0"
                    AutomationProperties.Name="엑셀">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenExcelIconGeometry}"
                            Style="{StaticResource ScreenToolbarIconStyle}"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Margin="0,0,8,0"
                            Stroke="{StaticResource Frm3300ExcelAccentBrush}"/>
                        <TextBlock Text="엑셀" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Margin="0,0,0,12" Style="{StaticResource ScreenCardStyle}">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}"
                    Margin="0,8,0,0"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AppTextSubBrush}"
                    TextWrapping="Wrap"
                    FontSize="13"
                    DockPanel.Dock="Bottom"/>
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,-8">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="출고일자:" Style="{StaticResource FilterLabel}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <DatePicker Height="36"
                            SelectedDate="{Binding FromDate, Mode=TwoWay}"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="150"
                            Style="{StaticResource ScreenFilterDatePickerStyle}"/>
                        <TextBlock Text="~" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <DatePicker Height="36"
                            SelectedDate="{Binding ToDate, Mode=TwoWay}"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="150"
                            Style="{StaticResource ScreenFilterDatePickerStyle}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품목코드:" Style="{StaticResource FilterLabel}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FilterBox}"
                            CharacterCasing="Upper"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Padding="8,2"
                            Width="210"
                            Margin="0"
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품 목 명:" Style="{StaticResource FilterLabel}" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FilterBox}"
                            Height="36"
                            FontSize="14"
                            VerticalContentAlignment="Center"
                            Padding="8,2"
                            Width="210"
                            Margin="0"
                            VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                    <Button Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,0,8" AutomationProperties.Name="조회">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource ScreenSearchIconGeometry}"
                                Style="{StaticResource ScreenToolbarIconStyle}"
                                Focusable="False"
                                IsHitTestVisible="False"
                                Margin="0,0,8,0"/>
                            <TextBlock Text="조회" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ScreenCardStyle}">
                <DockPanel>
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8" DockPanel.Dock="Top">
                        <Grid MinHeight="36" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="품목별" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}" Grid.Column="0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Margin="0">
                                <TextBlock Text="품목 수 : " TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                                <TextBlock Text="{Binding RecordCount, StringFormat={}{0:N0}}"
                                    Margin="0,0,20,0"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                                <TextBlock Text="중량 합계 : " TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                                <TextBlock Text="{Binding TotalQty, StringFormat={}{0:N2}}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="ItemGrid"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        Style="{StaticResource ScreenDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        HeadersVisibility="Column"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        GridLinesVisibility="None"
                        MinHeight="96">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding StkCode}" Width="220" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="품 목 명"
                                Binding="{Binding MastName}"
                                Width="*"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="180"/>
                            <DataGridTextColumn Header="중량 합계"
                                Binding="{Binding StkTqty, StringFormat={}{0:N2}}"
                                Width="170"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ScreenCellStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource ScreenCardStyle}">
                <DockPanel>
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8" DockPanel.Dock="Top">
                        <Grid MinHeight="36" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="LOT-NO별" Grid.Column="0" TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleTextStyle}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2" Margin="0">
                                <TextBlock Text="LOT 수 : " TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                                <TextBlock Text="{Binding LotRecordCount, StringFormat={}{0:N0}}"
                                    Margin="0,0,20,0"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                                <TextBlock Text="중량 합계 : " TextTrimming="CharacterEllipsis" Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                                <TextBlock Text="{Binding LotTotalQty, StringFormat={}{0:N2}}"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource SectionTitleMetadataTextStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataGrid x:Name="LotGrid"
                        ItemsSource="{Binding LotItems}"
                        SelectedItem="{Binding SelectedLotItem, Mode=TwoWay}"
                        Style="{StaticResource ScreenDataGridStyle}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserAddRows="False"
                        CanUserSortColumns="True"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        HeadersVisibility="Column"
                        RowHeaderWidth="0"
                        BorderThickness="0"
                        GridLinesVisibility="None"
                        MinHeight="96">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding StkCode}" Width="220" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="품 목 명"
                                Binding="{Binding MastName}"
                                Width="*"
                                ElementStyle="{StaticResource ScreenLeftCellTextStyle}"
                                MinWidth="180"/>
                            <DataGridTextColumn Header="LOT NO" Binding="{Binding StkLotno}" Width="260" ElementStyle="{StaticResource ScreenCellTextStyle}" MinWidth="98"/>
                            <DataGridTextColumn Header="중량 합계"
                                Binding="{Binding StkTqty, StringFormat={}{0:N2}}"
                                Width="170"
                                ElementStyle="{StaticResource ScreenRightCellTextStyle}"
                                MinWidth="90">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ScreenCellStyle}">
                                        <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
