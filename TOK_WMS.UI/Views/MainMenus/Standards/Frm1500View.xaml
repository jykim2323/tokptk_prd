<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" x:Class="TOK.WMS.UI.Views.MainMenus.Standards.Frm1500View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" UseLayoutRounding="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- ===================================================== -->
      <!-- Label -->
      <!-- ===================================================== -->
      <Style x:Key="FilterLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
      </Style>
      <!-- ===================================================== -->
      <!-- TextBox -->
      <!-- ===================================================== -->
      <Style x:Key="FilterBox" TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <!-- ===================================================== -->
      <!-- CRUD Button -->
      <!-- ===================================================== -->
      </ResourceDictionary>
  </UserControl.Resources>
  <!-- ========================================================= -->
  <!-- Loaded -->
  <!-- ========================================================= -->
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <DockPanel Margin="16">
    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ScreenToolbar}" behaviors:ResponsiveHeader.StackBelowWidth="900">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
          <Path Data="{StaticResource ScreenSettingsIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Focusable="False" IsHitTestVisible="False"/>
        </Border>
        <TextBlock Text="구분코드 마스터 관리" VerticalAlignment="Center" Style="{StaticResource ScreenTitleTextStyle}"/>
        <TextBlock Text="Frm1500" VerticalAlignment="Center" Style="{StaticResource ScreenSubtitleTextStyle}" Margin="12,0,0,0"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemHeight="50" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="ScreenToolbar">
        <TextBlock Text="{Binding StatusMessage}" Margin="0,0,20,0" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}" FontSize="12" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
        <Button Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="조회">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
            <TextBlock Text="조회" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="종료">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
            <TextBlock Text="종료" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </Grid>
    <!-- ===================================================== -->
    <!-- BODY -->
    <!-- ===================================================== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid behaviors:AdaptiveColumns.Enabled="True" behaviors:AdaptiveColumns.StackBelowWidth="1050" behaviors:AdaptiveColumns.StackedItemHeight="420">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- ================================================= -->
        <!-- GUBN 1 -->
        <!-- ================================================= -->
        <Border Grid.Column="0" Style="{StaticResource ScreenCardStyle}">
          <DockPanel>
            <!-- Header -->
            <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,12" DockPanel.Dock="Top">
              <TextBlock Text="위험물 - 구분#1" Style="{StaticResource SectionTitleTextStyle}"/>
            </Border>
            <!-- 입력 -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource ScreenCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="42"/>
                  <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="구분#1" Style="{StaticResource FilterLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gubn1Code,                                                     Mode=TwoWay,                                                     UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Style="{StaticResource FilterBox}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="구분명" Style="{StaticResource FilterLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gubn1Name,                                                     Mode=TwoWay,                                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
              </Grid>
            </Border>
            <!-- Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button Command="{Binding InsertGubn1Command}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="등록">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenPlusIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="등록" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding UpdateGubn1Command}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="수정">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="수정" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding DeleteGubn1Command}" Style="{StaticResource ScreenDangerButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="삭제">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="삭제" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <!-- Grid -->
            <DataGrid ItemsSource="{Binding Gubn1Items}" SelectedItem="{Binding SelectedGubn1,                                                      Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="구분" Binding="{Binding Gubn1Code}" Width="90" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="90"/>
                <DataGridTextColumn Header="구 분 명" Binding="{Binding Gubn1Name}" Width="*" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <!-- ================================================= -->
        <!-- GUBN 2 -->
        <!-- ================================================= -->
        <Border Grid.Column="2" Style="{StaticResource ScreenCardStyle}">
          <DockPanel>
            <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,12" DockPanel.Dock="Top">
              <TextBlock Text="석유류 - 구분#2" Style="{StaticResource SectionTitleTextStyle}"/>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource ScreenCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="42"/>
                  <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="구분#2" Style="{StaticResource FilterLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gubn2Code,                                                     Mode=TwoWay,                                                     UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Style="{StaticResource FilterBox}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="구분명" Style="{StaticResource FilterLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gubn2Name,                                                     Mode=TwoWay,                                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
              </Grid>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button Command="{Binding InsertGubn2Command}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="등록">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenPlusIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="등록" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding UpdateGubn2Command}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="수정">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="수정" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding DeleteGubn2Command}" Style="{StaticResource ScreenDangerButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="삭제">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="삭제" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Gubn2Items}" SelectedItem="{Binding SelectedGubn2,                                                      Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="구분" Binding="{Binding Gubn2Code}" Width="90" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="90"/>
                <DataGridTextColumn Header="구 분 명" Binding="{Binding Gubn2Name}" Width="*" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
        <!-- ================================================= -->
        <!-- GUBN 3 -->
        <!-- ================================================= -->
        <Border Grid.Column="4" Style="{StaticResource ScreenCardStyle}">
          <DockPanel>
            <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,12" DockPanel.Dock="Top">
              <TextBlock Text="수용성 - 구분#3" Style="{StaticResource SectionTitleTextStyle}"/>
            </Border>
            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Style="{StaticResource ScreenCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="42"/>
                  <RowDefinition Height="42"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="구분#3" Style="{StaticResource FilterLabel}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Gubn3Code,                                                     Mode=TwoWay,                                                     UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" Style="{StaticResource FilterBox}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="구분명" Style="{StaticResource FilterLabel}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gubn3Name,                                                     Mode=TwoWay,                                                     UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FilterBox}"/>
              </Grid>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
              <Button Command="{Binding InsertGubn3Command}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="등록">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenPlusIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="등록" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding UpdateGubn3Command}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="수정">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="수정" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button Command="{Binding DeleteGubn3Command}" Style="{StaticResource ScreenDangerButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="삭제">
                <StackPanel Orientation="Horizontal">
                  <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                  <TextBlock Text="삭제" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Gubn3Items}" SelectedItem="{Binding SelectedGubn3,                                                      Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" SelectionMode="Single" SelectionUnit="FullRow" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="구분" Binding="{Binding Gubn3Code}" Width="90" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="90"/>
                <DataGridTextColumn Header="구 분 명" Binding="{Binding Gubn3Name}" Width="*" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" MinWidth="90"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
