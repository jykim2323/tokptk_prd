<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Standards.Frm1100View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium">

    <UserControl.Resources>

        <BooleanToVisibilityConverter
            x:Key="BoolToVisibility"/>


        <Style x:Key="FilterLabel"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Margin"
                    Value="0,0,8,0"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

        </Style>


        <Style x:Key="FilterBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

        </Style>

    </UserControl.Resources>


    <i:Interaction.Triggers>

        <i:EventTrigger EventName="Loaded">

            <i:InvokeCommandAction
                Command="{Binding LoadedCommand}"/>

        </i:EventTrigger>

    </i:Interaction.Triggers>


    <DockPanel Margin="12">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid DockPanel.Dock="Top"
              Height="55"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📊"
                           FontSize="20"
                           Margin="0,0,8,0"/>


                <TextBlock Text="품목 코드 관리"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="- Frm1100" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>


            <!-- 버튼 -->

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">


                <!-- Excel -->

                <Button Content="📊 엑셀"
                        Width="95"
                        Height="38"
                        Margin="0,0,12,0"
                        Command="{Binding ExcelCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="ForestGreen"
                        Foreground="White"/>


                <!-- 등록 -->

                <Button Content="➕ 등록"
                        Width="95"
                        Height="38"
                        Margin="0,0,12,0"
                        Command="{Binding InsertCommand}"
                        Visibility="{Binding IsAdmin,
                                     Converter={StaticResource BoolToVisibility}}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 수정 -->

                <Button Content="✏ 수정"
                        Width="95"
                        Height="38"
                        Margin="0,0,12,0"
                        Command="{Binding UpdateCommand}"
                        Visibility="{Binding IsAdmin,
                                     Converter={StaticResource BoolToVisibility}}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 삭제 -->

                <Button Content="🗑 삭제"
                        Width="95"
                        Height="38"
                        Command="{Binding DeleteCommand}"
                        Visibility="{Binding IsAdmin,
                                     Converter={StaticResource BoolToVisibility}}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- 검색 -->
        <!-- ===================================================== -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="320"/>

                    <ColumnDefinition Width="15"/>

                    <ColumnDefinition Width="95"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <TextBlock Grid.Column="0"
                           Text="품목 코드:"
                           Style="{StaticResource FilterLabel}"/>


                <TextBox Grid.Column="1"
                         Text="{Binding ItemCode,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FilterBox}"
                         CharacterCasing="Upper">

                    <TextBox.InputBindings>

                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>

                    </TextBox.InputBindings>

                </TextBox>


                <Button Grid.Column="3"
                        Content="🔍 조회"
                        Height="34"
                        Command="{Binding SearchCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <TextBlock Grid.Column="5"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextSubBrush}"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- Grid -->
        <!-- ===================================================== -->

        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8">

            <DockPanel>


                <Grid DockPanel.Dock="Top"
                      Height="40"
                      Margin="0,0,0,7">

                    <TextBlock Text="📋 품목 코드 현황"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>


                    <TextBlock Text="{Binding RecordCount,
                                              StringFormat=조회건수 : {0:N0}건}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextSubBrush}"/>

                </Grid>


                <DataGrid x:Name="DB_Table1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem,
                                                 Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>


                        <DataGridTextColumn Header="바코드"
                                            Binding="{Binding MastBcode}"
                                            Width="180"/>


                        <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding MastCode}"
                                            Width="175"/>


                        <DataGridTextColumn Header="품 목 명"
                                            Binding="{Binding MastName}"
                                            Width="*"/>


                        <DataGridTextColumn Header="단위"
                                            Binding="{Binding MastUnit}"
                                            Width="80"/>


                        <DataGridTextColumn Header="단위중량"
                                            Binding="{Binding MastWeight,
                                            StringFormat={}{0:N2}}"
                                            Width="110"/>


                        <DataGridTextColumn Header="구분#1 명"
                                            Binding="{Binding Gubn1Name}"
                                            Width="160"/>


                        <DataGridTextColumn Header="구분#2 명"
                                            Binding="{Binding Gubn2Name}"
                                            Width="160"/>


                        <DataGridTextColumn Header="구분#3 명"
                                            Binding="{Binding Gubn3Name}"
                                            Width="160"/>


                        <DataGridTextColumn Header="추가 정보"
                                            Binding="{Binding MastRef1}"
                                            Width="200"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

    </DockPanel>

</UserControl>