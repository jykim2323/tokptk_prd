<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" x:Class="TOK.WMS.UI.Views.MainMenus.Standards.SFrm1100View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" WindowStyle="None" ResizeMode="NoResize" Width="760" Height="672" UseLayoutRounding="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="DetailLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
      </Style>
      <Style x:Key="DetailInputBox" TargetType="TextBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True">
            <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="DetailComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="36"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="FontSize" Value="14"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <DockPanel Margin="16">
    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ScreenToolbar}" behaviors:ResponsiveHeader.StackBelowWidth="900">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
          <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Focusable="False" IsHitTestVisible="False"/>
        </Border>
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Style="{StaticResource ScreenTitleTextStyle}"/>
        <TextBlock Text="SFrm1100" VerticalAlignment="Center" Style="{StaticResource ScreenSubtitleTextStyle}" Margin="12,0,0,0"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemHeight="50" HorizontalAlignment="Right" VerticalAlignment="Center" x:Name="ScreenToolbar">
        <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="종료">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
            <TextBlock Text="종료" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </Grid>
    <!-- ===================================================== -->
    <!-- BODY -->
    <!-- ===================================================== -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource ScreenCardStyle}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="60"/>
          </Grid.RowDefinitions>
          <!-- 품목코드 -->
          <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="품목코드" Style="{StaticResource DetailLabel}"/>
          </Border>
          <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding MastCode,                                         Mode=TwoWay,                                         UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCodeReadOnly}" CharacterCasing="Upper" Style="{StaticResource DetailInputBox}" Margin="0,4,160,4"/>
          <!-- 바코드 -->
          <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="바코드" Style="{StaticResource DetailLabel}"/>
          </Border>
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MastBcode,                                         Mode=TwoWay,                                         UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditReadOnly}" CharacterCasing="Upper" Style="{StaticResource DetailInputBox}" Margin="0,4,160,4"/>
          <!-- 품목명 -->
          <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="품목명" Style="{StaticResource DetailLabel}"/>
          </Border>
          <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding MastName,                                         Mode=TwoWay,                                         UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditReadOnly}" Style="{StaticResource DetailInputBox}" Margin="0,4"/>
          <!-- 포장단위 -->
          <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="포장단위" Style="{StaticResource DetailLabel}"/>
          </Border>
          <ComboBox Grid.Row="3" Grid.Column="2" Width="220" HorizontalAlignment="Left" IsEditable="True" Text="{Binding MastUnit,                                          Mode=TwoWay,                                          UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScreenFilterComboBoxStyle}" Margin="0,4"/>
          <!-- 단위중량 -->
          <Border Grid.Row="4" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="단위중량" Style="{StaticResource DetailLabel}"/>
          </Border>
          <TextBox Grid.Row="4" Grid.Column="2" Width="250" HorizontalAlignment="Left" Text="{Binding MastWeight,                                         Mode=TwoWay,                                         UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditReadOnly}" Style="{StaticResource DetailInputBox}" Margin="0,4"/>
          <!-- 위험물 -->
          <Border Grid.Row="5" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="위험물" Style="{StaticResource DetailLabel}"/>
          </Border>
          <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding Gubn1Items}" SelectedItem="{Binding SelectedGubn1,                                                Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ScreenFilterComboBoxStyle}" Margin="0,4"/>
          <!-- 석유류 -->
          <Border Grid.Row="6" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="석유류" Style="{StaticResource DetailLabel}"/>
          </Border>
          <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding Gubn2Items}" SelectedItem="{Binding SelectedGubn2,                                                Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ScreenFilterComboBoxStyle}" Margin="0,4"/>
          <!-- 수용성 -->
          <Border Grid.Row="7" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="수용성" Style="{StaticResource DetailLabel}"/>
          </Border>
          <ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding Gubn3Items}" SelectedItem="{Binding SelectedGubn3,                                                Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ScreenFilterComboBoxStyle}" Margin="0,4"/>
          <!-- 추가 정보 -->
          <Border Grid.Row="8" Grid.Column="0" Background="{DynamicResource AppSurface2Brush}" Margin="0,4" CornerRadius="4">
            <TextBlock Text="추가 정보" Style="{StaticResource DetailLabel}"/>
          </Border>
          <TextBox Grid.Row="8" Grid.Column="2" Text="{Binding MastRef1,                                         Mode=TwoWay,                                         UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditReadOnly}" Style="{StaticResource DetailInputBox}" Margin="0,4"/>
          <!-- 확정 -->
          <StackPanel Grid.Row="9" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="0,0,20,0" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}"/>
            <Button Command="{Binding ConfirmCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="0,0,8,8" AutomationProperties.Name="확정">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource ScreenConfirmIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                <TextBlock Text="확정" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
