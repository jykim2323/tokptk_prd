<Window x:Class="TOK.WMS.UI.Views.MainMenus.Standards.MastDispView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontWeight="Medium"
        WindowStyle="None"
        ResizeMode="CanResize"
        Width="1200"
        Height="720"
        MinWidth="850"
        MinHeight="550">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- 검색 Input -->
        <!-- ===================================================== -->

        <Style x:Key="FilterBox"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="34"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="{DynamicResource InputBrush}"/>

            <Setter Property="Foreground"
                    Value="{DynamicResource AppTextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{DynamicResource InputBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>


            <Style.Triggers>

                <Trigger Property="IsKeyboardFocusWithin"
                         Value="True">

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource BtnPrimaryBrush}"/>

                    <Setter Property="BorderThickness"
                            Value="2"/>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- Loaded -->
    <!-- ========================================================= -->

    <i:Interaction.Triggers>

        <i:EventTrigger EventName="Loaded">

            <i:InvokeCommandAction
                Command="{Binding LoadedCommand}"/>

        </i:EventTrigger>

    </i:Interaction.Triggers>


    <DockPanel Margin="12">


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid DockPanel.Dock="Top"
              Height="55"
              Margin="0,0,0,8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="📊"
                           FontSize="20"
                           Margin="0,0,8,0"/>


                <TextBlock Text="품목 코드 관리"
                           FontSize="20"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <TextBlock Text="- MastDisp" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>


            <Button Grid.Column="1"
                    Content="❌ 종료"
                    Width="95"
                    Height="38"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0"
                    Background="{DynamicResource BtnStadardBrush}"
                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- 검색 -->
        <!-- ===================================================== -->

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="12"
                Margin="0,0,0,8">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="270"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="95"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="105"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- 품목코드 -->

                <TextBlock Grid.Column="0"
                           Text="품목코드"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Bold"/>


                <TextBox Grid.Column="1"
                         Text="{Binding SearchText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                         CharacterCasing="Upper"
                         Style="{StaticResource FilterBox}">

                    <TextBox.InputBindings>

                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchCommand}"/>

                    </TextBox.InputBindings>

                </TextBox>


                <!-- 검색 -->

                <Button Grid.Column="3"
                        Content="🔍 검색"
                        Height="34"
                        Command="{Binding SearchCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <!-- 전체보기 -->

                <Button Grid.Column="5"
                        Content="🔄 전체보기"
                        Height="34"
                        Command="{Binding AllSearchCommand}"
                        FontWeight="Bold"
                        Cursor="Hand"
                        BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}"
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>


                <TextBlock Grid.Column="7"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AppTextSubBrush}"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- GRID -->
        <!-- ===================================================== -->

        <Border Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8">

            <DockPanel>


                <Grid DockPanel.Dock="Top"
                      Background="{DynamicResource HeaderBrush}"
                      Height="40"
                      Margin="0,0,0,7">

                    <TextBlock Text="📋 품목 목록"
                               Foreground="{DynamicResource AppTextOnPrimBrush}"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Bold"/>


                    <TextBlock Text="{Binding RecordCount,
                                              StringFormat=조회건수 : {0:N0}건}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextOnPrimBrush}"/>

                </Grid>


                <DataGrid x:Name="DB_Table1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem,
                                                 Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ScrollViewer.VerticalScrollBarVisibility="Visible"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">


                    <!-- ========================================= -->
                    <!-- Delphi DBGrid1CellClick -->
                    <!-- 행 클릭 → 선택 후 Window Close -->
                    <!-- ========================================= -->

                    <i:Interaction.Triggers>

                        <i:EventTrigger EventName="PreviewMouseLeftButtonUp">

                            <i:InvokeCommandAction
                                Command="{Binding SelectItemCommand}"
                                CommandParameter="{Binding SelectedItem}"/>

                        </i:EventTrigger>

                    </i:Interaction.Triggers>


                    <DataGrid.Columns>


                        <!-- 품목코드 -->

                        <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding MastCode}"
                                            Width="180"/>


                        <!-- 품목명 -->

                        <DataGridTextColumn Header="품 목 명"
                                            Binding="{Binding MastName}"
                                            Width="240"
                                            MinWidth="180"/>


                        <!-- 단위 -->

                        <DataGridTextColumn Header="단위"
                                            Binding="{Binding MastUnit}"
                                            Width="90"/>


                        <!-- 위험성 -->

                        <DataGridTextColumn Header="위험성"
                                            Binding="{Binding Gubn1Name}"
                                            Width="150"/>


                        <!-- 석유류 -->

                        <DataGridTextColumn Header="석유류"
                                            Binding="{Binding Gubn2Name}"
                                            Width="165"/>


                        <!-- 수용성 -->

                        <DataGridTextColumn Header="수용성"
                                            Binding="{Binding Gubn3Name}"
                                            Width="145"/>


                        <!-- 단위중량 -->

                        <DataGridTextColumn Header="단위중량"
                                            Binding="{Binding MastWeight,
                                            StringFormat={}{0:N2}}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>

        </Border>

    </DockPanel>

</Window>
