<Window x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.SFrm6910View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
        mc:Ignorable="d"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontWeight="Medium"
        WindowStyle="None"
        Height="700"
        Width="1000"
        MinHeight="600"
        MinWidth="850">

    <Window.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Header" TargetType="Border">
            <Setter Property="Background" Value="#ebf4fc"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2,2,2,2"/>
        </Style>

        <Style x:Key="DetailInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,0,5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
             Value="{DynamicResource BtnPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- ========================================================= -->
        <!-- 헤더 -->
        <!-- ========================================================= -->
        <Grid DockPanel.Dock="Top"
          Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                <TextBlock Text="📦"
                       FontSize="18"
                       Margin="0,0,5,0"
                       VerticalAlignment="Center"/>

                <TextBlock Text="파렛트 합짐"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{DynamicResource AppTextBrush}"
                       VerticalAlignment="Center"/>
                <TextBlock Text="- SFrm6910" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            </StackPanel>

            <Button Grid.Column="1"
                Content="❌ 종료"
                Width="85"
                Height="35"
                FontWeight="Bold"
                Cursor="Hand"
                BorderThickness="0"
                Background="{DynamicResource BtnStadardBrush}"
                Foreground="{DynamicResource BtnPrimaryTextBrush}"
                Command="{Binding CloseCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

        </Grid>


        <!-- ========================================================= -->
        <!-- 메인 -->
        <!-- ========================================================= -->
        <Grid>

            <Grid.RowDefinitions>
                <!-- 상단 PLT -->
                <RowDefinition Height="*"/>

                <!-- 이동버튼 -->
                <RowDefinition Height="55"/>

                <!-- 하단 PLT -->
                <RowDefinition Height="*"/>

                <!-- 확정버튼 -->
                <RowDefinition Height="55"/>
            </Grid.RowDefinitions>


            <!-- ===================================================== -->
            <!-- 상단 파렛트 -->
            <!-- ===================================================== -->
            <Border Grid.Row="0"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- PLT 번호 -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <TextBlock Text="PLT-NO"
                               Width="100"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextBrush}"/>

                        <TextBox Width="230"
                             Height="34"
                             IsReadOnly="True"
                             CharacterCasing="Upper"
                             Background="LightYellow"
                             Text="{Binding LeftPltNo}"
                             Style="{StaticResource DetailInputBox}"/>

                    </StackPanel>


                    <!-- 상단 Grid -->
                    <DataGrid Grid.Row="1"
                          ItemsSource="{Binding LeftItems}"
                          SelectedItem="{Binding SelectedLeftItem, Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="All"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding SubkCode}"
                                            Width="130"/>

                            <DataGridTextColumn Header="품목명"
                                            Binding="{Binding MastName}"
                                            Width="200"/>

                            <DataGridTextColumn Header="LOT-NO"
                                            Binding="{Binding SubkLotno}"
                                            Width="120"/>

                            <DataGridTextColumn Header="중량"
                                            Binding="{Binding SubkWgt,
                                                      StringFormat={}{0:N2}}"
                                            Width="90"/>

                            <DataGridTextColumn Header="BOX-NO"
                                            Binding="{Binding SubkBoxno}"
                                            Width="100"/>

                            <DataGridTextColumn Header="비고"
                                            Binding="{Binding SubkRemark}"
                                            Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- 이동 버튼 -->
            <!-- ===================================================== -->
            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <!-- 상단 → 하단 -->
                <Button Content="▼"
                    Width="55"
                    Height="35"
                    Margin="10,0"
                    FontSize="18"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Command="{Binding MoveToRightCommand}"
                    Background="{DynamicResource BtnStadardBrush}"
                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <!-- 하단 → 상단 -->
                <Button Content="▲"
                    Width="55"
                    Height="35"
                    Margin="10,0"
                    FontSize="18"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Command="{Binding MoveToLeftCommand}"
                    Background="{DynamicResource BtnStadardBrush}"
                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

            </StackPanel>


            <!-- ===================================================== -->
            <!-- 하단 파렛트 -->
            <!-- ===================================================== -->
            <Border Grid.Row="2"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="3"
                Padding="8">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- PLT 번호 -->
                    <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                        <TextBlock Text="PLT-NO"
                               Width="100"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextBrush}"/>

                        <TextBox Width="230"
                             Height="34"
                             IsReadOnly="True"
                             CharacterCasing="Upper"
                             Background="LightYellow"
                             Text="{Binding RightPltNo}"
                             Style="{StaticResource DetailInputBox}"/>

                    </StackPanel>


                    <!-- 하단 Grid -->
                    <DataGrid Grid.Row="1"
                          ItemsSource="{Binding RightItems}"
                          SelectedItem="{Binding SelectedRightItem, Mode=TwoWay}"
                          Style="{StaticResource ListDataGridStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="All"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="품목코드"
                                            Binding="{Binding SubkCode}"
                                            Width="130"/>

                            <DataGridTextColumn Header="품목명"
                                            Binding="{Binding MastName}"
                                            Width="200"/>

                            <DataGridTextColumn Header="LOT-NO"
                                            Binding="{Binding SubkLotno}"
                                            Width="120"/>

                            <DataGridTextColumn Header="중량"
                                            Binding="{Binding SubkWgt,
                                                      StringFormat={}{0:N2}}"
                                            Width="90"/>

                            <DataGridTextColumn Header="BOX-NO"
                                            Binding="{Binding SubkBoxno}"
                                            Width="100"/>

                            <DataGridTextColumn Header="비고"
                                            Binding="{Binding SubkRemark}"
                                            Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>


            <!-- ===================================================== -->
            <!-- 확정 -->
            <!-- ===================================================== -->
            <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

                <Button Content="💾 확정"
                    Width="100"
                    Height="38"
                    Margin="0,5,5,0"
                    FontWeight="Bold"
                    Cursor="Hand"
                    BorderThickness="0"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource BtnPrimaryBrush}"
                    Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

            </StackPanel>

        </Grid>

    </DockPanel>
</Window>
