<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.SFrm6910View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" WindowStyle="None" Height="700" Width="1000" MinHeight="600" MinWidth="850" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="DetailInputBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Header" TargetType="Border" BasedOn="{StaticResource ScreenSectionTitleStyle}" />
            <Style x:Key="DetailLabelCell" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" />
                </Border>
                <TextBlock Text="파렛트 합짐" Style="{StaticResource ScreenTitleTextStyle}" />
                <TextBlock Text="SFrm6910" Style="{StaticResource ScreenSubtitleTextStyle}" Margin="12,0,0,0" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center" x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" ItemHeight="50">
                <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="종료" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <WrapPanel VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Margin="8,0,0,0" Command="{Binding SaveCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource ScreenConfirmIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                    <TextBlock Text="확정" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ScreenCardStyle}" Grid.Row="0">
                <DockPanel LastChildFill="True">
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="이동 전 재고" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center" DockPanel.Dock="Top">
                            <TextBlock Text="원본 PLT-NO:" Style="{StaticResource FilterLabel}" />
                            <TextBox Width="240" Height="36" IsReadOnly="True" CharacterCasing="Upper" Text="{Binding LeftPltNo}" Style="{StaticResource DetailInputBox}" Margin="0" FontSize="14" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding LeftItems}" SelectedItem="{Binding SelectedLeftItem, Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" ColumnWidth="SizeToHeader" BorderThickness="0" MinHeight="100">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding MastName}" Width="220" MinWidth="220" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                                <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                                <DataGridTextColumn Header="중량" Binding="{Binding SubkWgt,                                                       StringFormat={}{0:N2}}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                                <DataGridTextColumn Header="BOX-NO" Binding="{Binding SubkBoxno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                                <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" MinWidth="180" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource ScreenCardStyle}" Grid.Row="2">
                <DockPanel LastChildFill="True">
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="이동 대상 재고" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center" DockPanel.Dock="Top">
                            <TextBlock Text="대상 PLT-NO:" Style="{StaticResource FilterLabel}" />
                            <TextBox Width="240" Height="36" IsReadOnly="True" CharacterCasing="Upper" Text="{Binding RightPltNo}" Style="{StaticResource DetailInputBox}" Margin="0" FontSize="14" />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding RightItems}" SelectedItem="{Binding SelectedRightItem, Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" ColumnWidth="SizeToHeader" BorderThickness="0" MinHeight="100">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                                <DataGridTextColumn Header="품목명" Binding="{Binding MastName}" Width="220" MinWidth="220" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                                <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                                <DataGridTextColumn Header="중량" Binding="{Binding SubkWgt,                                                       StringFormat={}{0:N2}}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                                <DataGridTextColumn Header="BOX-NO" Binding="{Binding SubkBoxno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                                <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" MinWidth="180" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </Border>
            <WrapPanel VerticalAlignment="Center" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,8">
                <Button Margin="8,0,0,0" Command="{Binding MoveToRightCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenDownloadIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="아래로 이동" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding MoveToLeftCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenUploadIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="위로 이동" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
