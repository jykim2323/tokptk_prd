<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:conv="clr-namespace:TOK.WMS.UI.Converters" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.Frm6550View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" Loaded="UserControl_Loaded" FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:LocaWhFormatConverter x:Key="LocaWhFormatConverter" />
            <conv:StokWhFlagConverter x:Key="StokWhFlagConverter" />
            <conv:OnlyTimeFormatConverter x:Key="OnlyTimeFormatConverter" />
            <conv:LocaFormatConverter x:Key="LocaFormatConverter" />
            <conv:LstkFlagConverter x:Key="LstkFlagConverter" />
            <conv:SubkFlagConverter x:Key="SubkFlagConverter" />
            <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
            <conv:RadioButtonConverter x:Key="RadioButtonConverter" />
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="DetailInputBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Header" TargetType="Border" BasedOn="{StaticResource ScreenSectionTitleStyle}" />
            <Style x:Key="DetailLabelCell" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" />
                </Border>
                <TextBlock Text="수/자동 재고 집계" Style="{StaticResource ScreenTitleTextStyle}" />
                <TextBlock Text="Frm6550" Style="{StaticResource ScreenSubtitleTextStyle}" Margin="12,0,0,0" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center" x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" ItemHeight="50">
                <Button Command="{Binding ExportExcelCommand}" CommandParameter="{Binding ElementName=DB_Table1}" Margin="8,0,0,0" Style="{StaticResource ScreenExcelButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenExcelIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{StaticResource Frm3300ExcelAccentBrush}" />
                        <TextBlock Text="엑셀" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding PrintCommand}" Margin="8,0,0,0" Style="{StaticResource ScreenSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenPrinterIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="인쇄" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Margin="8,0,0,0" Style="{StaticResource ScreenSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="종료" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border Style="{StaticResource ScreenCardStyle}" Margin="0,0,0,16" behaviors:EnterKey.Command="{Binding SearchCommand}" Grid.Row="1">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="마감일자:" Style="{StaticResource FilterLabel}" />
                        <DatePicker Width="150" Margin="0" FontSize="14" SelectedDate="{Binding SelectedInDate,                                             Mode=TwoWay,                                             UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Style="{StaticResource ScreenFilterDatePickerStyle}" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품목코드:" Style="{StaticResource FilterLabel}" />
                        <TextBox Width="200" Margin="0" Text="{Binding StokItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" FontSize="14" Height="36" />
                    </StackPanel>
                    <Button Command="{Binding ItemSearchCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                            <TextBlock Text="품목 조회" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="품목명:" Style="{StaticResource FilterLabel}" />
                        <TextBox Width="240" Margin="0" Text="{Binding MastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" FontSize="14" Height="36" />
                    </StackPanel>
                    <Button Command="{Binding SearchCommand}" Margin="8,0,0,0" Style="{StaticResource ScreenPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                            <TextBlock Text="조회" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="위험물:" Style="{StaticResource FilterLabel}" />
                        <ComboBox Width="170" Height="36" ItemsSource="{Binding DangerousTypes}" SelectedItem="{Binding SelectedDangerousType, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0" Style="{StaticResource ScreenFilterComboBoxStyle}" FontSize="14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="석유류:" Style="{StaticResource FilterLabel}" />
                        <ComboBox Width="170" Height="36" ItemsSource="{Binding PetroleumTypes}" SelectedItem="{Binding SelectedPetroleumType, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0" Style="{StaticResource ScreenFilterComboBoxStyle}" FontSize="14" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                        <TextBlock Text="수용성:" Style="{StaticResource FilterLabel}" />
                        <ComboBox Width="170" Height="36" ItemsSource="{Binding SolubilityTypes}" SelectedItem="{Binding SelectedSolubilityType, Mode=TwoWay}" DisplayMemberPath="Name" Margin="0" Style="{StaticResource ScreenFilterComboBoxStyle}" FontSize="14" />
                    </StackPanel>
                </WrapPanel>
                <WrapPanel VerticalAlignment="Center">
                    <RadioButton Content="수동창고" VerticalAlignment="Center" Margin="0,0,20,8" GroupName="WhGroup" IsChecked="{Binding StokWhM,Mode=TwoWay}" FontSize="14" Foreground="{DynamicResource AppTextBrush}" />
                    <RadioButton Content="생산동자동창고" VerticalAlignment="Center" Margin="0,0,20,8" GroupName="WhGroup" IsChecked="{Binding StokWhS,Mode=TwoWay}" FontSize="14" Foreground="{DynamicResource AppTextBrush}" />
                    <RadioButton Content="외부동자동창고" VerticalAlignment="Center" GroupName="WhGroup" Margin="0,0,20,8" IsChecked="{Binding StokWhW,Mode=TwoWay}" FontSize="14" Foreground="{DynamicResource AppTextBrush}" />
                    <RadioButton Content="전체" x:Name="rbAll" VerticalAlignment="Center" GroupName="WhGroup" IsChecked="{Binding StokWhA,Mode=TwoWay}" Margin="0,0,20,8" FontSize="14" Foreground="{DynamicResource AppTextBrush}" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource ScreenCardStyle}" Grid.Row="2">
            <DockPanel LastChildFill="True">
                <Border Style="{StaticResource ScreenSectionTitleStyle}" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="재고 현황" Style="{StaticResource SectionTitleTextStyle}" />
                </Border>
                <DataGrid x:Name="DB_Table1" ItemsSource="{Binding Items}" Style="{StaticResource ScreenDataGridStyle}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" HeadersVisibility="Column" SelectionMode="Extended" ColumnWidth="SizeToHeader" LoadingRow="DataGrid_LoadingRow" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" BorderThickness="0" MinHeight="100">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="품목코드" Binding="{Binding StokItem}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="220" MinWidth="220" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                        <DataGridTextColumn Header="생산동" Binding="{Binding StokSqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="외부동" Binding="{Binding StokWqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="수동창고" Binding="{Binding StokMqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="합계" Binding="{Binding StokTqty}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="위험물" Binding="{Binding Gubn1Name}" Width="140" MinWidth="140" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="석유류" Binding="{Binding Gubn2Name}" Width="140" MinWidth="140" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="수용성" Binding="{Binding Gubn3Name}" Width="140" MinWidth="140" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="창고A" Binding="{Binding StokAqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="창고B" Binding="{Binding StokBqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="창고C" Binding="{Binding StokCqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="창고D" Binding="{Binding StokDqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                        <DataGridTextColumn Header="창고E" Binding="{Binding StokEqty}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
