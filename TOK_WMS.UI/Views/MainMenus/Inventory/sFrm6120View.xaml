<Window x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.SFrm6120View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
        mc:Ignorable="d"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{StaticResource AppFont}"
        FontWeight="Medium"
        WindowStyle="None"
        Height="550" Width="1250">

    <Window.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Header" TargetType="Border">
            <Setter Property="Background" Value="#ebf4fc"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2,2,2,2"/>
        </Style>

        <Style x:Key="DetailInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,0,5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
             Value="{DynamicResource BtnPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,10,0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
               Text="📦"
               FontSize="18"
               Margin="0,5,3,5"
               VerticalAlignment="Center"/>

            <TextBlock Grid.Column="1"
               Text="셀 재고 등록"
               FontSize="18"
               FontWeight="Bold"
               Foreground="{DynamicResource AppTextBrush}"
               VerticalAlignment="Center"/>


            <TextBlock Grid.Column="2" Text="- SFrm6120" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

            <Button Grid.Column="3"
            Content="❌  종료"
            Width="85"
            FontWeight="Bold"
            Cursor="Hand"
            BorderThickness="0"
            HorizontalAlignment="Right"
            Background="{DynamicResource BtnStadardBrush}"
            Foreground="{DynamicResource BtnPrimaryTextBrush}"
            Command="{Binding CloseCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center"
             FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}"/>
        </Grid>

        <Border DockPanel.Dock="Top" BorderThickness="1" BorderBrush="#58A6FF" CornerRadius="2" Padding="12,10" Margin="0,10,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="10" >
                        <TextBlock Text="저장 위치:" FontSize="15" Margin="0,0,13,0" Style="{StaticResource FilterLabel}"/>
                        <TextBox Width="400" IsReadOnly="True" Background="LightYellow" behaviors:LocaMask.Value="{Binding LstkLoca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Margin="10" behaviors:EnterKey.Command="{Binding PltcheckCommand}">
                        <TextBlock Text="PLT-NO:" FontSize="15" Margin="0,0,13,0" Style="{StaticResource FilterLabel}"/>
                        <TextBox Width="400" Margin="14,0,0,0" CharacterCasing="Upper" Text="{Binding LstkPltno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text=" 상 태:" FontSize="15" Margin="0,0,13,0" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Width="400"
                                    Height="34"
                                    Margin="33,0,0,0"
                                    SelectedValue="{Binding LstkFlag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Tag"
                                    FontSize="16"
                                    VerticalContentAlignment="Center">

                            <ComboBoxItem Content="0 - 비어 있음" Tag="0"/>
                            <ComboBoxItem Content="1 - 제품 있음" Tag="1"/>
                            <ComboBoxItem Content="X - 입고 예약" Tag="X"/>
                            <ComboBoxItem Content="Y - 출고 예약" Tag="Y"/>
                            <ComboBoxItem Content="W - 이중 입고" Tag="W"/>
                            <ComboBoxItem Content="E - 공출고" Tag="E"/>
                            <ComboBoxItem Content="N - 사용 금지" Tag="N"/>

                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="3">
                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="입고일자:"
                                   FontSize="15"
                                   Margin="0,0,13,0"
                                   Style="{StaticResource FilterLabel}"/>
                        <DatePicker Width="400"
                                    Margin="13,0,0,0"
                                    FontSize="20"
                                    SelectedDate="{Binding SelectedInDate,
                                                   Mode=TwoWay,
                                                   UpdateSourceTrigger=PropertyChanged}"
                                    SelectedDateFormat="Short"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                                Text="입고시간:"
                                FontSize="15"
                                Margin="10,0,13,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource FilterLabel}"/>

                    <TextBox Grid.Column="1"
                                Width="398"
                                Margin="12,5,0,0"
                                HorizontalAlignment="Left"
                                Text="{Binding LstkIntime,
                                               Mode=TwoWay,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource DetailInputBox}" Grid.ColumnSpan="2"/>

                    <Button Grid.Column="3"
                             Content="💾  확정"
                             Width="85"
                             Command="{Binding ConfirmedCommand}"
                             FontWeight="Bold"
                             Cursor="Hand"
                             BorderThickness="0"
                             HorizontalAlignment="Right"
                             Background="{DynamicResource BtnPrimaryBrush}"
                             Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                </Grid>
                <Grid Grid.Row="5"  Margin="0,0,0,0">
                    <Border  Background="{DynamicResource AppSurfaceBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}"
                             BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,10,0,8">
                        <DockPanel LastChildFill="True">
                            <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                            <DataGrid x:Name="DB_Table2" ItemsSource="{Binding SubkItems}"
                                        Style="{StaticResource ListDataGridStyle}"
                                        HeadersVisibility="All"
                                        SelectionMode="Extended"
                                        ColumnWidth="Auto"
                                        CanUserSortColumns="True"
                                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto">

                                <DataGrid.RowHeaderStyle>
                                    <Style TargetType="DataGridRowHeader">
                                        <Setter Property="Content" Value=""/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                                <Setter Property="Content" Value="▶"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="재고위치" Binding="{Binding SubkLoca}" Width="200" />
                                    <DataGridTextColumn Header="PLT-NO" Binding="{Binding SubkPltno}" Width="260" />
                                    <DataGridTextColumn Header="상태" Binding="{Binding SubkFlag}" Width="80" />
                                    <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="100" />
                                    <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="AUTO" />
                                    <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="AUTO" />
                                    <DataGridTextColumn Header="재고중량" Binding="{Binding SubkWgt}" Width="AUTO" />
                                    <DataGridTextColumn Header="예약중량" Binding="{Binding SubkRwgt}" Width="AUTO" />
                                    <DataGridTextColumn Header="Box-No" Binding="{Binding SubkBoxno}" Width="AUTO" />
                                    <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>
</Window>
