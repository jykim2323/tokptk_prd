<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.SFrm6120View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" WindowStyle="None" Height="550" Width="1250" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="DetailInputBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Header" TargetType="Border" BasedOn="{StaticResource ScreenSectionTitleStyle}" />
            <Style x:Key="DetailLabelCell" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" />
                </Border>
                <TextBlock Text="셀 재고 등록" Style="{StaticResource ScreenTitleTextStyle}" />
                <TextBlock Text="SFrm6120" Style="{StaticResource ScreenSubtitleTextStyle}" Margin="12,0,0,0" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center" x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" ItemHeight="50">
                <Button Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="종료" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <WrapPanel VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Command="{Binding ConfirmedCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource ScreenConfirmIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                    <TextBlock Text="확정" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </WrapPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ScreenCardStyle}" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="270">
                    <UniformGrid Columns="2">
                        <Grid Margin="0,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="저장 위치:" Style="{StaticResource FilterLabel}" />
                            <TextBox IsReadOnly="True" behaviors:LocaMask.Value="{Binding LstkLoca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" Margin="0" FontSize="14" Height="36" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,16,8" behaviors:EnterKey.Command="{Binding PltcheckCommand}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PLT-NO:" Style="{StaticResource FilterLabel}" />
                            <TextBox Margin="0" CharacterCasing="Upper" Text="{Binding LstkPltno, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" FontSize="14" Height="36" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text=" 상 태:" Style="{StaticResource FilterLabel}" />
                            <ComboBox Height="36" Margin="0" SelectedValue="{Binding LstkFlag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" FontSize="14" Style="{StaticResource ScreenFilterComboBoxStyle}" Grid.Column="1">
                                <ComboBoxItem Content="0 - 비어 있음" Tag="0" />
                                <ComboBoxItem Content="1 - 제품 있음" Tag="1" />
                                <ComboBoxItem Content="X - 입고 예약" Tag="X" />
                                <ComboBoxItem Content="Y - 출고 예약" Tag="Y" />
                                <ComboBoxItem Content="W - 이중 입고" Tag="W" />
                                <ComboBoxItem Content="E - 공출고" Tag="E" />
                                <ComboBoxItem Content="N - 사용 금지" Tag="N" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="입고일자:" Style="{StaticResource FilterLabel}" />
                            <DatePicker Margin="0" FontSize="14" SelectedDate="{Binding SelectedInDate,                                                    Mode=TwoWay,                                                    UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Style="{StaticResource ScreenFilterDatePickerStyle}" Height="36" VerticalContentAlignment="Center" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="입고시간:" Style="{StaticResource FilterLabel}" />
                            <TextBox Margin="0" HorizontalAlignment="Left" Text="{Binding LstkIntime,                                                Mode=TwoWay,                                                UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" FontSize="14" Height="36" Grid.Column="1" />
                        </Grid>
                    </UniformGrid>
                </ScrollViewer>
            </Border>
            <Border Style="{StaticResource ScreenCardStyle}" Grid.Row="1">
                <DockPanel LastChildFill="True">
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="PLT 품목 현황" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <DataGrid x:Name="DB_Table2" ItemsSource="{Binding SubkItems}" Style="{StaticResource ScreenDataGridStyle}" HeadersVisibility="Column" SelectionMode="Extended" ColumnWidth="SizeToHeader" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" BorderThickness="0" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="재고위치" Binding="{Binding SubkLoca}" Width="140" MinWidth="140" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="PLT-NO" Binding="{Binding SubkPltno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="상태" Binding="{Binding SubkFlag}" Width="80" MinWidth="80" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="220" MinWidth="220" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                            <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="재고중량" Binding="{Binding SubkWgt}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                            <DataGridTextColumn Header="예약중량" Binding="{Binding SubkRwgt}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                            <DataGridTextColumn Header="Box-No" Binding="{Binding SubkBoxno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" MinWidth="180" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
