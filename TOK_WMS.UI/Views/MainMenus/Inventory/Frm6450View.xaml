<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.Frm6450View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:TOK.WMS.UI.Converters"
             xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium"
             Loaded="UserControl_Loaded">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:LocaWhFormatConverter x:Key="LocaWhFormatConverter"/>
        <conv:StokWhFlagConverter x:Key="StokWhFlagConverter"/>
        <conv:OnlyTimeFormatConverter x:Key="OnlyTimeFormatConverter"/>
        <conv:LocaFormatConverter x:Key="LocaFormatConverter"/>
        <conv:LstkFlagConverter x:Key="LstkFlagConverter"/>
        <conv:SubkFlagConverter x:Key="SubkFlagConverter"/>
        <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
        <conv:RadioButtonConverter x:Key="RadioButtonConverter"/>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Header" TargetType="Border">
            <Setter Property="Background" Value="#ebf4fc"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2,2,2,2"/>
        </Style>
        <Style x:Key="DetailInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,0,5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
                    Value="{DynamicResource BtnPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,10,0" >

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Height="60">
                <TextBlock Text="📦" FontSize="20" Margin="0,5,5,10" VerticalAlignment="Center"/>
                <TextBlock Text="수/자동 재고 현황" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

                <TextBlock Text="- Frm6450" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                <Button Width="90" HorizontalAlignment="Right" Content="📊 엑셀" Command="{Binding ExportExcelCommand}"  
                        Padding="16,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="5,0,10,5"
                        Background="ForestGreen" 
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Width="90" HorizontalAlignment="Right" Content="🖨️ 인쇄" Command="{Binding PrintCommand}"  
                        Padding="16,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="5,0,10,5"
                        Background="{DynamicResource BtnStadardBrush}" 
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Width="90" HorizontalAlignment="Right" Content="⏻ 종료" Command="{Binding ExitCommand}"  
                        Padding="16,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="5,0,10,5"
                        Background="{DynamicResource BtnStadardBrush}" 
                        Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
            </StackPanel>
            <!--<TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}"/>-->
        </Grid>

        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10"
                        behaviors:EnterKey.Command="{Binding ItemSearchCommand}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 조회기간 + 호기 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" 
                            BorderBrush="#58A6FF"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="10,10,5,10">
                                    <TextBlock Text="마감일자:"
                                            FontSize="15"
                                            Margin="0,0,13,0"
                                            Style="{StaticResource FilterLabel}"/>
                                    <DatePicker Width="120"
                                            Margin="5,0,0,0"
                                            FontSize="13"
                                            SelectedDate="{Binding SelectedInDate,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                            SelectedDateFormat="Short"/>
                                </StackPanel>
                                <Button Content="🔍 조회" Width="90" Command="{Binding SearchCommand}" HorizontalAlignment="Right" Margin="0,10,35,0"
                                        Padding="16,7" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" Margin="10,10,5,10">
                                    <TextBlock Text="품목코드:"
                                                FontSize="15"
                                                Margin="0,0,13,0"
                                                Style="{StaticResource FilterLabel}"/>
                                    <TextBox Width="200" Margin="1,0,0,0" Text="{Binding StokItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}"/>

                                    <Button Content="🔍" Width="30" Command="{Binding ItemSearchCommand}" 
                                        FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                        Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                                    <TextBlock Text="품목명:"
                                                FontSize="15"
                                                Margin="30,0,10,0"
                                                Style="{StaticResource FilterLabel}"/>
                                    <TextBox Width="250" Margin="1,0,30,0" Text="{Binding MastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" 
                            BorderBrush="#58A6FF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="10,5,10,50">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="수동창고" 
                                            VerticalAlignment="Center"
                                            Margin="10,0,20,0"
                                            GroupName="WhGroup"
                                            IsChecked="{Binding StokWhM,Mode=TwoWay}"/>
                            <RadioButton Content="생산동자동창고" 
                                            VerticalAlignment="Center"
                                            Margin="10,0,20,0"
                                            GroupName="WhGroup"
                                            IsChecked="{Binding StokWhS,Mode=TwoWay}"/>
                            <RadioButton Content="외부동자동창고" 
                                            VerticalAlignment="Center"
                                            GroupName="WhGroup"
                                            Margin="10,0,20,0"
                                            IsChecked="{Binding StokWhW,Mode=TwoWay}"/>
                            <RadioButton Content="전체" 
                                            x:Name="rbAll"
                                            VerticalAlignment="Center"
                                            GroupName="WhGroup"
                                            IsChecked="{Binding StokWhA,Mode=TwoWay}"
                                            Margin="0,0,30,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,10,0,10"/>
                </Grid>

                <!-- Row 1: 나머지 필터(좌) + 버튼(우) -->
                <Grid Grid.Row="2" Margin="10,25,10,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠️ 위험물:" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Width="230"
                                        Height="32"
                                        ItemsSource="{Binding DangerousTypes}"
                                        SelectedItem="{Binding SelectedDangerousType, Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        VerticalContentAlignment="Center"
                                        Padding="6,0"
                                        Margin="0,0,20,0"/>
                        <TextBlock Text="🛢️ 석유류:" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Width="230"
                                      Height="32"
                                      ItemsSource="{Binding PetroleumTypes}"
                                      SelectedItem="{Binding SelectedPetroleumType, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center"
                                      Margin="0,0,20,0"/>
                        <TextBlock Text="💧 수용성:" Style="{StaticResource FilterLabel}"/>
                        <ComboBox Width="230"
                                      Height="32"
                                      ItemsSource="{Binding SolubilityTypes}"
                                      SelectedItem="{Binding SelectedSolubilityType, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      VerticalContentAlignment="Center"
                                      Padding="6,0"
                                      Margin="0,0,20,0"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3">
                    <Border Height="1" Background="{DynamicResource AppBorderBrush}" Margin="0,10,0,10"/>
                </Grid>
                <Grid Grid.Row="4" Margin="10,5,10,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="총 합계:"  FontSize="13" FontWeight="Bold" Style="{StaticResource FilterLabel}"/>
                        <TextBox  Width="130" Height="35" IsReadOnly="True" Text="{Binding StokWgtTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}"/>

                        <TextBlock Text="전체 PLT 수량:"  FontSize="13" FontWeight="Bold" Style="{StaticResource FilterLabel}" Margin="40,0,0,0"/>
                        <TextBox  Width="130" Height="35" IsReadOnly="True" Text="{Binding StokPltTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Border Grid.Row="0" 
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,10,0,8">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Height="40" Style="{StaticResource Header}"
                                 BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,8">
                            <TextBlock Text="재고 현황" FontSize="15" FontWeight="Bold" 
                                            Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        </Border>

                        <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                        <DataGrid x:Name="DB_Table1" ItemsSource="{Binding Items}"
                                    Style="{StaticResource ListDataGridStyle}"
                                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                    HeadersVisibility="All"
                                    SelectionMode="Extended"
                                    ColumnWidth="Auto"
                                    LoadingRow="DataGrid_LoadingRow"
                                    CanUserSortColumns="True"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.RowHeaderStyle>
                                <Style TargetType="DataGridRowHeader">
                                    <Setter Property="Content" Value=""/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                                            <Setter Property="Content" Value="▶"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell"
                                  BasedOn="{StaticResource ListCellStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LstkFlag}" Value="Y">
                                            <Setter Property="Background" Value="Yellow"/>
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding LstkFlag}" Value="E">
                                            <Setter Property="Background" Value="Yellow"/>
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding LstkFlag}" Value="N">
                                            <Setter Property="Background" Value="Red"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="창고" Binding="{Binding StokWh, Converter={StaticResource StokWhFlagConverter}}" Width="70"  />
                                <DataGridTextColumn Header="품목코드" Binding="{Binding StokItem}" Width="200" />
                                <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="150" />
                                <DataGridTextColumn Header="LOT-NO" Binding="{Binding StokLotno}" Width="180" />
                                <DataGridTextColumn Header="저장위치" Binding="{Binding StokLoca, Converter={StaticResource LocaWhFormatConverter}}" Width="150" />
                                <DataGridTextColumn Header="상태" Binding="{Binding StokFlag, Converter={StaticResource LstkFlagConverter}}" Width="70" />
                                <DataGridTextColumn Header="재고수량" Binding="{Binding StokQty}" Width="100" />
                                <DataGridTextColumn Header="BOXNO" Binding="{Binding StokBoxno}" Width="AUTO" />
                                <DataGridTextColumn Header="비고" Binding="{Binding StokRemark}" Width="AUTO" />
                                <DataGridTextColumn Header="입고일자" Binding="{Binding StokIndate, Converter={StaticResource DateTimeFormatConverter}}" Width="AUTO" />
                                <DataGridTextColumn Header="입고시간" Binding="{Binding StokIntime, Converter={StaticResource OnlyTimeFormatConverter}}" Width="AUTO" />
                                <DataGridTextColumn Header="위험물" Binding="{Binding DangerousType}" Width="AUTO" />
                                <DataGridTextColumn Header="석유류" Binding="{Binding PetroleumType}" Width="AUTO" />
                                <DataGridTextColumn Header="수용성" Binding="{Binding SolubilityType}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
