<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:conv="clr-namespace:TOK.WMS.UI.Converters" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.Frm6100View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" Loaded="UserControl_Loaded" FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:LocaFormatConverter x:Key="LocaFormatConverter" />
            <conv:LstkFlagConverter x:Key="LstkFlagConverter" />
            <conv:SubkFlagConverter x:Key="SubkFlagConverter" />
            <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
            <conv:OnlyTimeFormatConverter x:Key="OnlyTimeFormatConverter" />
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            </Style>
            <Style x:Key="DetailInputBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox" BasedOn="{StaticResource ScreenFilterInputStyle}">
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Header" TargetType="Border" BasedOn="{StaticResource ScreenSectionTitleStyle}" />
            <Style x:Key="DetailLabelCell" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" />
                </Border>
                <TextBlock Text="재고 위치별 조회" Style="{StaticResource ScreenTitleTextStyle}" />
                <TextBlock Text="Frm6100" Style="{StaticResource ScreenSubtitleTextStyle}" Margin="12,0,0,0" />
            </StackPanel>
            <WrapPanel VerticalAlignment="Center" x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" ItemHeight="50">
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="종료" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border Style="{StaticResource ScreenCardStyle}" Margin="0,0,0,16" behaviors:EnterKey.Command="{Binding SearchCommand}" Grid.Row="1">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8" VerticalAlignment="Center">
                    <TextBlock Text="재고 위치:" Style="{StaticResource FilterLabel}" />
                    <TextBox x:Name="txtLoca" Width="220" behaviors:LocaMask.Value="{Binding SelectedItem.LstkLoca, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" Margin="0" FontSize="14" Height="36" />
                </StackPanel>
                <Button Margin="8,0,0,0" Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="조회" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ModifyCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table1}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="수정" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table1}" Style="{StaticResource ScreenSecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                        <TextBlock Text="삭제" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.05*" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource ScreenCardStyle}" Margin="0,0,0,8">
                <DockPanel LastChildFill="True">
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="재고 위치" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <WrapPanel VerticalAlignment="Center" ItemHeight="50" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Command="{Binding CellinsertCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table1}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource ScreenConfirmIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                                <TextBlock Text="셀 재고 등록" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CelladdCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table1}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource ScreenPlusIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                                <TextBlock Text="셀 재고 추가" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CellcancelCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table1}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                                <TextBlock Text="셀 재고 취소" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="8,0,16,8" VerticalAlignment="Center">
                            <TextBlock Text="파렛트당 중량:" Style="{StaticResource FilterLabel}" />
                            <TextBox Width="130" IsReadOnly="True" Text="{Binding SubkWgtTotal, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" Margin="0" FontSize="14" Height="36" />
                        </StackPanel>
                    </WrapPanel>
                    <DataGrid x:Name="DB_Table1" ItemsSource="{Binding Items}" Style="{StaticResource ScreenDataGridStyle}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" HeadersVisibility="Column" SelectionMode="Extended" ColumnWidth="SizeToHeader" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" BorderThickness="0" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="재고위치" Binding="{Binding LstkLoca, Converter={StaticResource LocaFormatConverter}}" MinWidth="140" Width="140" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="PLT-NO" Binding="{Binding LstkPltno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="상태" Binding="{Binding LstkFlag, Converter={StaticResource LstkFlagConverter}}" Width="80" MinWidth="80" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="입고일자" Binding="{Binding LstkIndate, Converter={StaticResource DateTimeFormatConverter}}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="입고시간" Binding="{Binding LstkIntime, Converter={StaticResource OnlyTimeFormatConverter}  }" Width="*" MinWidth="110" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        </DataGrid.Columns>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <i:InvokeCommandAction Command="{Binding SubkSearchCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table1}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource ScreenCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LstkFlag}" Value="Y">
                                        <Setter Property="Background" Value="Yellow" />
                                        <Setter Property="Foreground" Value="Red" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LstkFlag}" Value="E">
                                        <Setter Property="Background" Value="Yellow" />
                                        <Setter Property="Foreground" Value="Red" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LstkFlag}" Value="N">
                                        <Setter Property="Background" Value="Red" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource ScreenCardStyle}" Grid.Row="1" Margin="0,8,0,0">
                <DockPanel LastChildFill="True">
                    <Border Style="{StaticResource ScreenSectionTitleStyle}" DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="품목 현황" Style="{StaticResource SectionTitleTextStyle}" />
                    </Border>
                    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button Command="{Binding DeletePltNoCommand}" CommandParameter="{Binding SelectedItem, ElementName=DB_Table2}" Style="{StaticResource ScreenSecondaryButtonStyle}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" />
                                <TextBlock Text="삭제" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <DataGrid x:Name="DB_Table2" ItemsSource="{Binding SubkItems}" Style="{StaticResource ScreenDataGridStyle}" SelectedItem="{Binding SelectedSubkItem, Mode=TwoWay}" HeadersVisibility="Column" SelectionMode="Extended" ColumnWidth="SizeToHeader" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" BorderThickness="0" MinHeight="100">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="재고위치" Binding="{Binding SubkLoca}" Width="140" MinWidth="140" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="PLT-NO" Binding="{Binding SubkPltno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="상태" Binding="{Binding SubkFlag, Converter={StaticResource SubkFlagConverter}}" Width="80" MinWidth="80" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="220" MinWidth="220" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                            <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="재고중량" Binding="{Binding SubkWgt}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                            <DataGridTextColumn Header="예약중량" Binding="{Binding SubkRwgt}" Width="110" MinWidth="110" ElementStyle="{StaticResource ScreenRightCellTextStyle}" />
                            <DataGridTextColumn Header="Box-No" Binding="{Binding SubkBoxno}" Width="160" MinWidth="160" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                            <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" MinWidth="180" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
