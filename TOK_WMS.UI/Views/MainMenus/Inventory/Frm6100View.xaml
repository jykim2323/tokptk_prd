<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.Frm6100View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Header" TargetType="Border">
            <Setter Property="Background" Value="#ebf4fc"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2,2,2,2"/>
        </Style>

        <Style x:Key="DetailInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,0,5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
                    Value="{DynamicResource BtnPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <DockPanel Margin="12">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,10,0" >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="📥" FontSize="18" Margin="0,5,8,10" VerticalAlignment="Center"/>
                <TextBlock Text="핸드스캔 입고 등록" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

                <Button Content="🔍  조회" Width="90" Command="{Binding SearchCommand}" Margin="900,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Content="🗑️  삭제" Width="90" Command="{Binding SearchCommand}" Margin="20,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Content="⚠  완전삭제" Width="95" Command="{Binding SearchCommand}" Margin="20,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Content="⏻  종료" Width="90" Command="{Binding SearchCommand}" Margin="20,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}"/>
        </Grid>

        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" 
                BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,20,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 1: 나머지 필터(좌) + 버튼(우) -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                        <TextBlock Text="PLT NO:" Margin="0,0,13,0" Foreground="{DynamicResource BtnPrimaryBrush}" Style="{StaticResource FilterLabel}"/>
                        <TextBox Width="400"  Text="{Binding PltnoSrcEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding TrackingCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Content="✓  완료" Width="90" Command="{Binding SearchCommand}" Margin="600,6,0,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                        <TextBlock Text="제품 BCR:" Foreground="{DynamicResource BtnPrimaryBrush}" Style="{StaticResource FilterLabel}"/>
                        <TextBox Width="700" Text="{Binding itemBcrEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding TrackingCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Border BorderThickness="1" BorderBrush="#58A6FF" CornerRadius="2" Padding="0,10,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Margin="5,10,20,5">
                                    <TextBlock Text="품 명:" Style="{StaticResource FilterLabel}"/>
                                    <TextBox Width="350" Text="{Binding ItemEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                                    <TextBlock Text="BOX NO:" Margin="50,0,5,0" Style="{StaticResource FilterLabel}"/>
                                    <TextBox Width="230" Text="{Binding ItemEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                                <StackPanel Orientation="Horizontal" Margin="5,20,20,5">
                                    <TextBlock Text="품 번:" Style="{StaticResource FilterLabel}"/>
                                    <TextBox Width="350" Text="{Binding ItemEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                                    <TextBlock Text="중 량:" Margin="50,0,5,0" Style="{StaticResource FilterLabel}"/>
                                    <TextBox Width="230" Text="{Binding ItemEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </DockPanel>


</UserControl>
