<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Inventory.Frm6100View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Header" TargetType="Border">
            <Setter Property="Background" Value="#ebf4fc"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2,2,2,2"/>
        </Style>

        <Style x:Key="DetailInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,0,5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
                    Value="{DynamicResource BtnPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <DockPanel Margin="12">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,10,0" >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="📦" FontSize="18" Margin="0,5,8,10" VerticalAlignment="Center"/>
                <TextBlock Text="재고 위치별 조회" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>

                <Button Content="🔍  조회" Width="90" Command="{Binding SearchCommand}" Margin="900,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Content="🗑️  삭제" Width="90" Command="{Binding SearchCommand}" Margin="20,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Content="⚠  완전삭제" Width="95" Command="{Binding SearchCommand}" Margin="20,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                <Button Content="⏻  종료" Width="90" Command="{Binding SearchCommand}" Margin="20,5,10,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}"/>
        </Grid>

        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top" BorderThickness="1" BorderBrush="#58A6FF" CornerRadius="2" Padding="12,10" Margin="0,20,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#58A6FF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#58A6FF"
                                BorderThickness="1"
                                CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <TextBlock Text="재고 위치:" Margin="0,0,13,0" Style="{StaticResource FilterLabel}"/>
                                <TextBox Width="400" Text="{Binding PltnoSrcEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                                <Button Content="🔍 조회" Width="90" Margin="20,0,0,0" Command="{Binding SearchCommand}" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                        Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                            </StackPanel>
                        </Border>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,10,10,10">
                            <Button Content="✎ 수정" Width="90" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                    Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                            <Button Content="🗑️ 삭제" Width="90" Margin="10,0,0,0" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                    Background="{DynamicResource BtnStadardBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <Grid Grid.Row="1">
                    <Border Grid.Row="0" 
                             Background="{DynamicResource AppSurfaceBrush}"
                             BorderBrush="{DynamicResource AppBorderBrush}"
                             BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,10,0,8">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Top" Height="40" Style="{StaticResource Header}"
                                    BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,8">
                                <TextBlock Text="품목 조회" FontSize="18" FontWeight="Bold" 
                                            Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                            <DataGrid x:Name="MimastDB_Table" ItemsSource="{Binding Items}"
                                                 Style="{StaticResource ListDataGridStyle}"
                                                 SelectionMode="Extended"
                                                 ColumnWidth="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="*" Width="10" />
                                    <DataGridTextColumn Header="재고위치" Binding="{Binding LstkLoca}" Width="180" />
                                    <DataGridTextColumn Header="PLT-NO" Binding="{Binding LstkPltno}" Width="260" />
                                    <DataGridTextColumn Header="상태" Binding="{Binding LstkFlag}" Width="80" />
                                    <DataGridTextColumn Header="입고일자" Binding="{Binding LstkIndate}" Width="100" />
                                    <DataGridTextColumn Header="입고시간" Binding="{Binding LstkIntime}" Width="220" />
                                </DataGrid.Columns>
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction Command="{Binding MimastCellClickCommand}" CommandParameter="{Binding SelectedItem, ElementName=MimastDB_Table}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                    
                </Grid>
            </Grid>
        </Border>
    </DockPanel>


</UserControl>
