<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Controls.ConveyorSignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style x:Key="ConveyorChannelCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource ScSignalInnerPanelStyle}">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="280"/>
        </Style>

        <DataTemplate x:Key="ConveyorChannelValueTemplate">
            <Grid Margin="6">
                <ItemsControl ItemsSource="{Binding Bits}"
                              IsEnabled="{Binding CanSave}"
                              ItemTemplate="{StaticResource SignalBitRowTemplate}">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl"
                               BasedOn="{StaticResource SignalBitGridStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBitSignal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>

                <Border Padding="18"
                        IsEnabled="{Binding CanSave}"
                        Background="{DynamicResource AppSurfaceBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWordSignal}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel Width="210"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding ValueDescription}"
                                   Margin="0,0,0,10"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextBrush}"
                                   TextAlignment="Center"/>
                        <Border Height="42"
                                Background="#162C43"
                                BorderBrush="#5D89B7"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBox Text="{Binding RawBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="4"
                                     Padding="4,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontFamily="Consolas"
                                     FontSize="18"
                                     FontWeight="Bold"
                                     Foreground="#E9F4FF"
                                     CaretBrush="White"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                        <TextBlock Text="4자리 값"
                                   Margin="0,7,0,0"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource AppTextSubBrush}"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ConveyorReceiveChannelTemplate">
            <Border Style="{StaticResource ConveyorChannelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="10,0"
                            Background="{DynamicResource HeaderBrush}"
                            BorderBrush="#B8D0E3"
                            BorderThickness="0,0,0,1"
                            CornerRadius="5,5,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PLC → COM"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayBits}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ConveyorChannelValueTemplate}"/>

                    <Button Grid.Row="2"
                            Margin="6,1,6,6"
                            HorizontalAlignment="Stretch"
                            Content="수 정"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource ScSignalModifyButtonStyle}"
                            Command="{Binding DataContext.SaveGridCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ConveyorSendChannelTemplate">
            <Border Style="{StaticResource ConveyorChannelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="39"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="10,0"
                            Background="{DynamicResource HeaderBrush}"
                            BorderBrush="#C5D1DC"
                            BorderThickness="0,0,0,1"
                            CornerRadius="5,5,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="COM → PLC"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding DisplayName}"
                                           FontFamily="Consolas"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding DisplayBits}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ConveyorChannelValueTemplate}"/>

                    <Button Grid.Row="2"
                            Margin="6,1,6,6"
                            HorizontalAlignment="Stretch"
                            Content="수 정"
                            IsEnabled="{Binding CanSave}"
                            Style="{StaticResource ScSignalModifyButtonStyle}"
                            Command="{Binding DataContext.SaveGridCommand,
                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 화면 제목 및 연동 상태 -->
        <Border Grid.Row="0"
                Padding="16,10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="7"
                            Background="{DynamicResource AppSurface2Brush}"
                            Margin="0,0,10,0">
                        <TextBlock Text="🛠️"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AppAccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="컨베이어 신호 관리" FontSize="16" FontWeight="Bold"/>
                        <!--<TextBlock Text="CVC 전체의 PLC 수신·송신 Grid를 방향별로 12개씩 관리합니다."
                                   Margin="0,2,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppTextSubBrush}"/>-->
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="조회 중..."
                               Margin="0,0,12,0"
                               Foreground="#315F8B"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <CheckBox Content="자동 갱신"
                              IsChecked="{Binding IsAutoRefresh}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Foreground="{DynamicResource AppTextBrush}"/>

                    <Button Style="{StaticResource ScSignalRefreshButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="새로고침" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 하나의 CVC를 통신 방향별 탭으로 표시 -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
            <TabItem Header="PLC → COM"
                     Style="{StaticResource ScSignalTabItemStyle}">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            CornerRadius="5"
                            Background="{DynamicResource HeaderBrush}"
                            BorderBrush="#B8D0E3"
                            BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▼"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"
                                           FontSize="12"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="PLC → COM 수신 신호"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                            </StackPanel>
                            <TextBlock Text=""
                                       HorizontalAlignment="Right"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ReceiveGrids}"
                                      ItemTemplate="{StaticResource ConveyorReceiveChannelTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="COM → PLC"
                     Style="{StaticResource ScSignalTabItemStyle}">
                <Grid Margin="12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Margin="0,0,0,8"
                            Padding="12,8"
                            CornerRadius="5"
                            Background="{DynamicResource HeaderBrush}"
                            BorderBrush="#C5D1DC"
                            BorderThickness="1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▲"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"
                                           FontSize="12"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="COM → PLC 송신 신호"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                            </StackPanel>
                            <TextBlock Text=""
                                       HorizontalAlignment="Right"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SendGrids}"
                                      ItemTemplate="{StaticResource ConveyorSendChannelTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
