<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Controls.ConveyorSignalView" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="SignalBitRowTemplate">
                <Border Margin="2,2" Padding="6,4" BorderThickness="1" CornerRadius="4" ToolTip="{Binding Label}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#E3F5E9" />
                                    <Setter Property="BorderBrush" Value="#71BE8A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Label}" FontSize="14" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#173B25" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <CheckBox.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DataTemplate>
                        </CheckBox.ContentTemplate>
                    </CheckBox>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ScSignalWordCardTemplate">
                <Border Margin="2,3" Padding="10,8" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Channel}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                            <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" FontSize="12" Foreground="{DynamicResource AppTextSubBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="38" Background="#162C43" BorderBrush="#5D89B7" BorderThickness="1" CornerRadius="4">
                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Background="Transparent" BorderThickness="0" Padding="2,0" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="#E9F4FF" CaretBrush="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
            <Style x:Key="ConveyorChannelCardStyle" TargetType="Border" BasedOn="{StaticResource ScSignalInnerPanelStyle}">
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="380" />
                <Setter Property="Width" Value="352" />
            </Style>
            <DataTemplate x:Key="ConveyorChannelValueTemplate">
                <Grid Margin="6">
                    <ItemsControl ItemsSource="{Binding Bits}" IsEnabled="{Binding CanSave}" ItemTemplate="{StaticResource SignalBitRowTemplate}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl" BasedOn="{StaticResource SignalBitGridStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBitSignal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                    </ItemsControl>
                    <Border Padding="18" IsEnabled="{Binding CanSave}" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWordSignal}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="210" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ValueDescription}" Margin="0,0,0,10" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                            <Border Height="42" Background="#162C43" BorderBrush="#5D89B7" BorderThickness="1" CornerRadius="4">
                                <TextBox Text="{Binding RawBits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Padding="4,0" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#E9F4FF" CaretBrush="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                            </Border>
                            <TextBlock Text="4자리 값" Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource AppTextSubBrush}" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ConveyorReceiveChannelTemplate">
                <Border Style="{StaticResource ConveyorChannelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="54" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="PLC → COM" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSubBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas" Style="{StaticResource SectionTitleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DisplayBits}" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayBits}" />
                            </Grid>
                        </Border>
                        <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ConveyorChannelValueTemplate}" />
                        <Button Grid.Row="2" Margin="6,1,6,6" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSave}" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveGridCommand,                                 RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="수정">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                <TextBlock Text="수정" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ConveyorSendChannelTemplate">
                <Border Style="{StaticResource ConveyorChannelCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="54" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="COM → PLC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppTextSubBrush}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding DisplayName}" FontFamily="Consolas" Style="{StaticResource SectionTitleTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding DisplayBits}" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayBits}" />
                            </Grid>
                        </Border>
                        <ContentControl Grid.Row="1" Content="{Binding}" ContentTemplate="{StaticResource ConveyorChannelValueTemplate}" />
                        <Button Grid.Row="2" Margin="6,1,6,6" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSave}" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveGridCommand,                                 RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="수정">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                <TextBlock Text="수정" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenSettingsIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Margin="0" />
                </Border>
                <TextBlock Text="컨베이어 신호 관리" Style="{StaticResource ScreenTitleTextStyle}" />
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="50">
                <TextBlock Text="조회 중..." FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSubBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Content="자동 갱신" IsChecked="{Binding IsAutoRefresh}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" ToolTip="새로고침" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenRefreshIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="새로고침" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" ToolTip="종료" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="종료" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource AppTextBrush}">
            <TabItem Header="PLC → COM" Style="{StaticResource ScSignalTabItemStyle}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource ScreenSectionTitleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▼" Foreground="{DynamicResource AppTextSubBrush}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="PLC → COM 수신 신호" Style="{StaticResource SectionTitleTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding ReceiveGrids}" ItemTemplate="{StaticResource ConveyorReceiveChannelTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="COM → PLC" Style="{StaticResource ScSignalTabItemStyle}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource ScreenSectionTitleStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▲" Foreground="{DynamicResource AppTextSubBrush}" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="COM → PLC 송신 신호" Style="{StaticResource SectionTitleTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SendGrids}" ItemTemplate="{StaticResource ConveyorSendChannelTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>