<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Controls.ScSignalView" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="SignalBitRowTemplate">
                <Border Margin="2,2" Padding="6,4" BorderThickness="1" CornerRadius="4" ToolTip="{Binding Label}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Background" Value="#E3F5E9" />
                                    <Setter Property="BorderBrush" Value="#71BE8A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <CheckBox IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="{Binding Label}" FontSize="14" VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Foreground" Value="#173B25" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                        <CheckBox.ContentTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DataTemplate>
                        </CheckBox.ContentTemplate>
                    </CheckBox>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ScSignalWordCardTemplate">
                <Border Margin="2,3" Padding="10,8" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Channel}" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" />
                            <TextBlock Text="{Binding Description}" ToolTip="{Binding Description}" FontSize="12" Foreground="{DynamicResource AppTextSubBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="38" Background="#162C43" BorderBrush="#5D89B7" BorderThickness="1" CornerRadius="4">
                            <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Background="Transparent" BorderThickness="0" Padding="2,0" FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="#E9F4FF" CaretBrush="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="900">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenSettingsIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Margin="0" />
                </Border>
                <TextBlock Text="스태커 크레인 신호 관리" Style="{StaticResource ScreenTitleTextStyle}" />
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="50">
                <TextBlock Text="조회 중..." FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSubBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox Content="자동 갱신" IsChecked="{Binding IsAutoRefresh}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" ToolTip="새로고침" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenRefreshIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="새로고침" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" ToolTip="종료" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="종료" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="1" Grid.RowSpan="2" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0">
            <TabControl ItemsSource="{Binding Cranes}" SelectedItem="{Binding SelectedCrane, Mode=TwoWay}" ItemContainerStyle="{StaticResource ScSignalTabItemStyle}" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource AppTextBrush}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,12,0,0" MinWidth="1360">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Style="{StaticResource ScSignalSectionCardStyle}" MinHeight="390">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▼" Foreground="{DynamicResource AppTextSubBrush}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="수신 (PLC → COM)" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="신호 편집" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource ScSignalInnerPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="54" />
                                                    </Grid.RowDefinitions>
                                                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="[D5000]" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="COMMAND" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ReceiveRawCh01}" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiveRawCh01}" />
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ReceiveBits}" Style="{StaticResource SignalBitGridStyle}" ItemTemplate="{StaticResource SignalBitRowTemplate}" />
                                                    <Button Grid.Row="2" Margin="3,7,3,0" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="R_CH01" ToolTip="수정">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource ScSignalInnerPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="54" />
                                                    </Grid.RowDefinitions>
                                                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="[D5004]" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="COMMAND" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ReceiveRawCh06}" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReceiveRawCh06}" />
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ReceiveBits06}" Style="{StaticResource SignalBitGridStyle}" ItemTemplate="{StaticResource SignalBitRowTemplate}" />
                                                    <Button Grid.Row="2" Margin="3,7,3,0" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="R_CH06" ToolTip="수정">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource ScSignalInnerPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="54" />
                                                    </Grid.RowDefinitions>
                                                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                                                        <TextBlock Text="현재 위치 및 에러 코드" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ReceiveWords}" ItemTemplate="{StaticResource ScSignalWordCardTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <Button Grid.Row="2" Margin="3,7,3,0" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="R_WORDS" ToolTip="수정">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="2" Style="{StaticResource ScSignalSectionCardStyle}" MinHeight="390">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="38" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="▲" Foreground="{DynamicResource AppTextSubBrush}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="송신 (COM → PLC)" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="신호 편집" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.35*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="1.15*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="0.9*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource ScSignalInnerPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="54" />
                                                    </Grid.RowDefinitions>
                                                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="[D5100]" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="COMMAND" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SendRawCh01}" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SendRawCh01}" />
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SendBits}" Style="{StaticResource SignalBitGridStyle}" ItemTemplate="{StaticResource SignalBitRowTemplate}" />
                                                    <Button Grid.Row="2" Margin="3,7,3,0" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="S_CH01" ToolTip="수정">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="2" Style="{StaticResource ScSignalInnerPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="54" />
                                                    </Grid.RowDefinitions>
                                                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="12" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="[D5105]" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="COMMAND" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding SendRawCh06}" FontFamily="Consolas" Grid.Column="2" Style="{StaticResource SectionTitleMetadataTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SendRawCh06}" />
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SendBits06}" Style="{StaticResource SignalBitGridStyle}" ItemTemplate="{StaticResource SignalBitRowTemplate}" />
                                                    <Button Grid.Row="2" Margin="3,7,3,0" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="S_CH06" ToolTip="수정">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                            <Border Grid.Column="4" Style="{StaticResource ScSignalInnerPanelStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="54" />
                                                    </Grid.RowDefinitions>
                                                    <Border Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,8">
                                                        <TextBlock Text="FROM / TO 위치 지령" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SendWords}" ItemTemplate="{StaticResource ScSignalWordCardTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <Button Grid.Row="2" Margin="3,7,3,0" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="S_WORDS" ToolTip="수정">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>
    </Grid>
</UserControl>