<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Controls.ScSignalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 화면 제목 및 조회 -->
        <Border Grid.Row="0" Padding="16,10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,3,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="7"
                            Background="#E6F1FA" Margin="0,0,10,0">
                        <TextBlock Text="🛠️" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                   Foreground="#315F8B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="스태커 크레인 신호 관리" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="조회 중..." Margin="0,0,12,0"
                               Foreground="#315F8B" FontSize="11" VerticalAlignment="Center"
                               Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <CheckBox Content="자동 갱신" IsChecked="{Binding IsAutoRefresh}"
                              VerticalAlignment="Center" Margin="0,0,12,0"
                              Foreground="{DynamicResource AppTextBrush}"/>

                    <Button Style="{StaticResource ScSignalRefreshButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="새로고침" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1~7호기 선택 -->
        <Border Grid.Row="1" Grid.RowSpan="2"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1">
            <TabControl ItemsSource="{Binding Cranes}"
                        SelectedItem="{Binding SelectedCrane, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource ScSignalTabItemStyle}"
                        Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid Margin="12,10" MinHeight="610">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 수신: PLC → COM -->
                            <Border Grid.Row="0" Style="{StaticResource ScSignalSectionCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="6,6,0,0" Padding="12,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="▼" Foreground="{DynamicResource AppTextOnPrimBrush}" FontSize="12" Margin="0,0,7,0"/>
                                                <TextBlock Text="수신 (PLC → COM)" Foreground="{DynamicResource AppTextOnPrimBrush}"
                                                           FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="신호 편집" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextOnPrimBrush}" FontSize="10.5"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource ScSignalInnerPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="39"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="4,0,4,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="[D5000]" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="Bold" Foreground="#315F8B"/>
                                                        <TextBlock Text="  COMMAND" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ReceiveRawCh01}" HorizontalAlignment="Right"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource AppTextSubBrush}"/>
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ReceiveBits}"
                                                              Style="{StaticResource SignalBitGridStyle}"
                                                              ItemTemplate="{StaticResource SignalBitRowTemplate}"/>
                                                <Button Grid.Row="2" Content="수 정" Margin="3,7,3,0"
                                                        Style="{StaticResource ScSignalModifyButtonStyle}"
                                                        Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="R_CH01"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource ScSignalInnerPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="39"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="4,0,4,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="[D5004]" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="Bold" Foreground="#315F8B"/>
                                                        <TextBlock Text="  COMMAND" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ReceiveRawCh06}" HorizontalAlignment="Right"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource AppTextSubBrush}"/>
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ReceiveBits06}"
                                                              Style="{StaticResource SignalBitGridStyle}"
                                                              ItemTemplate="{StaticResource SignalBitRowTemplate}"/>
                                                <Button Grid.Row="2" Content="수 정" Margin="3,7,3,0"
                                                        Style="{StaticResource ScSignalModifyButtonStyle}"
                                                        Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="R_CH06"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="4" Style="{StaticResource ScSignalInnerPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="39"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="현재 위치 및 에러 코드" Margin="4,0,4,5"
                                                           FontSize="12" FontWeight="Bold"/>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ReceiveWords}"
                                                              ItemTemplate="{StaticResource ScSignalWordCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <Button Grid.Row="2" Content="수 정" Margin="3,7,3,0"
                                                        Style="{StaticResource ScSignalModifyButtonStyle}"
                                                        Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="R_WORDS"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 송신: COM → PLC -->
                            <Border Grid.Row="2" Style="{StaticResource ScSignalSectionCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="6,6,0,0" Padding="12,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="▲" Foreground="{DynamicResource AppTextOnPrimBrush}" FontSize="12" Margin="0,0,7,0"/>
                                                <TextBlock Text="송신 (COM → PLC)" Foreground="{DynamicResource AppTextOnPrimBrush}"
                                                           FontSize="12" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="신호 편집" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextOnPrimBrush}" FontSize="10.5"/>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="1" Margin="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.35*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="0.9*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Style="{StaticResource ScSignalInnerPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="39"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="4,0,4,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="[D5100]" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="Bold" Foreground="#8A5B32"/>
                                                        <TextBlock Text="  COMMAND" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SendRawCh01}" HorizontalAlignment="Right"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource AppTextSubBrush}"/>
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SendBits}"
                                                              Style="{StaticResource SignalBitGridStyle}"
                                                              ItemTemplate="{StaticResource SignalBitRowTemplate}"/>
                                                <Button Grid.Row="2" Content="수 정" Margin="3,7,3,0"
                                                        Style="{StaticResource ScSignalModifyButtonStyle}"
                                                        Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="S_CH01"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource ScSignalInnerPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="39"/>
                                                </Grid.RowDefinitions>
                                                <Grid Margin="4,0,4,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="[D5105]" FontFamily="Consolas"
                                                                   FontSize="12" FontWeight="Bold" Foreground="#8A5B32"/>
                                                        <TextBlock Text="  COMMAND" FontSize="12" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding SendRawCh06}" HorizontalAlignment="Right"
                                                               FontFamily="Consolas" FontSize="11"
                                                               Foreground="{DynamicResource AppTextSubBrush}"/>
                                                </Grid>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SendBits06}"
                                                              Style="{StaticResource SignalBitGridStyle}"
                                                              ItemTemplate="{StaticResource SignalBitRowTemplate}"/>
                                                <Button Grid.Row="2" Content="수 정" Margin="3,7,3,0"
                                                        Style="{StaticResource ScSignalModifyButtonStyle}"
                                                        Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="S_CH06"/>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="4" Style="{StaticResource ScSignalInnerPanelStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="39"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="FROM / TO 위치 지령" Margin="4,0,4,5"
                                                           FontSize="12" FontWeight="Bold"/>
                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding SendWords}"
                                                              ItemTemplate="{StaticResource ScSignalWordCardTemplate}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <Button Grid.Row="2" Content="수 정" Margin="3,7,3,0"
                                                        Style="{StaticResource ScSignalModifyButtonStyle}"
                                                        Command="{Binding DataContext.SaveChannelCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                        CommandParameter="S_WORDS"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Border>

        <!-- TabControl의 실제 본문은 선택된 탭 안에서 Grid.Row=2까지 확장됩니다. -->
    </Grid>
</UserControl>
