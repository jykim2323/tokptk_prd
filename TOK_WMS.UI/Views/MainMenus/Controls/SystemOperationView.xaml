<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Controls.SystemOperationView" Loaded="UserControl_Loaded" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SystemOperationModeRadioStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="36" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>
            <Style x:Key="SystemOperationFieldLabelStyle" TargetType="Border">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="#163272" />
                <Setter Property="BorderBrush" Value="#1C3555" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4,0,0,4" />
            </Style>
            <Style x:Key="SystemOperationValueTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="36" />
                <Setter Property="MinWidth" Value="105" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenSettingsIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Margin="0" />
                </Border>
                <TextBlock Text="시스템 운전 설정" Style="{StaticResource ScreenTitleTextStyle}" />
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="50">
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" ToolTip="조회" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="조회" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" ToolTip="종료" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="종료" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0">
                <ItemsControl ItemsSource="{Binding FloorSettings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ScreenCardStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,12">
                                        <Grid Grid.Row="0" Margin="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding DataContext.SaveFloorCommand,                                                     RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="수정" Grid.Column="2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                                    <TextBlock Text="수정" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Cranes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="4" Padding="12" MinHeight="157" Background="{DynamicResource AppSurface2Brush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Width="202">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                                            <Border Width="26" Height="26" Margin="0,0,7,0" CornerRadius="13" Background="#315F8B">
                                                                <TextBlock Text="{Binding CraneNo}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <RadioButton Content="입고가능" GroupName="{Binding GroupName}" IsChecked="{Binding IsInboundAvailable, Mode=TwoWay}" Foreground="{DynamicResource AppTextBrush}" Style="{StaticResource SystemOperationModeRadioStyle}" />
                                                        <RadioButton Content="출고가능" GroupName="{Binding GroupName}" IsChecked="{Binding IsOutboundAvailable, Mode=TwoWay}" Foreground="#159447" Style="{StaticResource SystemOperationModeRadioStyle}" />
                                                        <RadioButton Content="입출고가능" GroupName="{Binding GroupName}" IsChecked="{Binding IsBothAvailable, Mode=TwoWay}" Foreground="#2563EB" Style="{StaticResource SystemOperationModeRadioStyle}" />
                                                        <RadioButton Content="입출고금지" GroupName="{Binding GroupName}" IsChecked="{Binding IsDisabled, Mode=TwoWay}" Foreground="#E13232" Style="{StaticResource SystemOperationModeRadioStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,0,-12,0">
                    <Border Style="{StaticResource ScreenCardStyle}" Width="720" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,12">
                                <Grid Grid.Row="0" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="작업순번" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding SaveSequencesCommand}" ToolTip="수정" Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <WrapPanel Grid.Row="1">
                                <Grid Margin="4" Width="330">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SystemOperationFieldLabelStyle}">
                                        <TextBlock Text="입고순번" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBox Grid.Column="1" MaxLength="18" Style="{StaticResource SystemOperationValueTextBoxStyle}" Text="{Binding WorkSequences.InboundSequence,                                                 Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="4" Width="330">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SystemOperationFieldLabelStyle}">
                                        <TextBlock Text="재입고순번" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBox Grid.Column="1" MaxLength="18" Style="{StaticResource SystemOperationValueTextBoxStyle}" Text="{Binding WorkSequences.ReInboundSequence,                                                 Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="4" Width="330">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SystemOperationFieldLabelStyle}">
                                        <TextBlock Text="출고순번" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBox Grid.Column="1" MaxLength="18" Style="{StaticResource SystemOperationValueTextBoxStyle}" Text="{Binding WorkSequences.OutboundSequence,                                                 Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Margin="4" Width="330">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SystemOperationFieldLabelStyle}">
                                        <TextBlock Text="공파레트순번" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBox Grid.Column="1" MaxLength="18" Style="{StaticResource SystemOperationValueTextBoxStyle}" Text="{Binding WorkSequences.EmptyPalletSequence,                                                 Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ScreenCardStyle}" Width="340" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Style="{StaticResource ScreenSectionTitleStyle}" Margin="0,0,0,12">
                                <Grid Grid.Row="0" Margin="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="호기" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource ScreenSecondaryButtonStyle}" Command="{Binding SaveInboundCraneCommand}" ToolTip="수정" Grid.Column="2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource ScreenModifyIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                                            <TextBlock Text="수정" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="4" MaxWidth="330" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SystemOperationFieldLabelStyle}">
                                    <TextBlock Text="입고호기" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                                <TextBox Grid.Column="1" MaxLength="1" Style="{StaticResource SystemOperationValueTextBoxStyle}" Text="{Binding InboundCrane,                                             Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </Grid>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>