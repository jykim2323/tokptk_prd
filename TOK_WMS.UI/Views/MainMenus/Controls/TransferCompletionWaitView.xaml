<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Controls.TransferCompletionWaitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}">

    <UserControl.Resources>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FilterInputStyle" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 화면 제목 -->
        <Border Grid.Row="0" Padding="16,11"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,3,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" Margin="0,0,10,0"
                            CornerRadius="7" Background="#E8F1F8">
                        <TextBlock Text="🛠️" FontFamily="Consolas" FontSize="12"
                                   FontWeight="Bold" Foreground="#315F8B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="입출고 완료 대기" FontSize="16" FontWeight="Bold"/>
                        <!--<TextBlock Text="입·출고 작업 완료 후 처리 대기 중인 항목을 조회합니다."
                                   Margin="0,2,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppTextSubBrush}"/>-->
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource AppTextSubBrush}"/>
            </Grid>
        </Border>

        <!-- 조회 조건 -->
        <Border Grid.Row="1" Margin="12,10,12,0" Padding="12,10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Bottom" Margin="18,0,0,0">
                    <Button Content="조회" Command="{Binding SearchCommand}"
                            Background="{DynamicResource BtnPrimaryBrush}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="엑셀" Command="{Binding ExportExcelCommand}"
                            Background="#2C7A4B"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="관리자 강제 삭제" Command="{Binding DeleteSelectedCommand}"
                            Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource StatusErrorBrush}"
                            Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="입·출고 설비 완료 후 후속 처리를 기다리는 데이터입니다."
                               FontWeight="SemiBold"/>
                    <TextBlock Text="삭제하면 재고 및 완료 처리가 진행되지 않을 수 있으므로 관리자만 삭제할 수 있습니다."
                               Margin="0,3,0,0" FontSize="11"
                               Foreground="{DynamicResource StatusErrorBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 완료 대기 목록 -->
        <Border Grid.Row="2" Margin="12,10,12,12"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="TransferCompletionWaitGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Style="{StaticResource ListDataGridStyle}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="입출고 순번" Binding="{Binding Sequence}" Width="150"/>
                    <DataGridTextColumn Header="PLT-NO" Binding="{Binding PalletNo}" Width="140"/>
                    <DataGridTextColumn Header="저장위치" Binding="{Binding Location}" Width="160"/>
                    <DataGridTextColumn Header="작업구분" Binding="{Binding JobCode}" Width="110"/>
                    <DataGridTextColumn Header="일자" Binding="{Binding CompletionDate}" Width="130"/>
                    <DataGridTextColumn Header="시간" Binding="{Binding CompletionTime}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
