<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Controls.TransferCompletionWaitView" Loaded="UserControl_Loaded" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Margin="0" />
                </Border>
                <TextBlock Text="입출고 완료 대기" Style="{StaticResource ScreenTitleTextStyle}" />
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="50">
                <Button Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" ToolTip="조회" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="조회" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource ScreenExcelButtonStyle}" ToolTip="엑셀" Margin="8,0,0,0" CommandParameter="{Binding ElementName=TransferCompletionWaitGrid}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenExcelIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="엑셀" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ScreenDangerButtonStyle}" ToolTip="관리자 강제 삭제" Margin="8,0,0,0" Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="관리자 강제 삭제" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" ToolTip="종료" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="종료" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource ScreenCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ScreenSectionTitleStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="완료 대기 목록" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Style="{StaticResource SectionTitleMetadataTextStyle}" Grid.Column="2" />
                    </Grid>
                </Border>
                <DataGrid x:Name="TransferCompletionWaitGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" SelectionMode="Single" ToolTip="열 제목을 끌어 순서를 바꾸거나 경계를 끌어 너비를 조절할 수 있습니다." Grid.Row="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="입출고 순번" Binding="{Binding Sequence}" Width="150" MinWidth="150" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="PLT-NO" Binding="{Binding PalletNo}" Width="140" MinWidth="118" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="저장위치" Binding="{Binding Location}" Width="160" MinWidth="90" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="작업구분" Binding="{Binding JobCode}" Width="110" MinWidth="90" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="일자" Binding="{Binding CompletionDate}" Width="130" MinWidth="90" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="시간" Binding="{Binding CompletionTime}" Width="*" MinWidth="90" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>