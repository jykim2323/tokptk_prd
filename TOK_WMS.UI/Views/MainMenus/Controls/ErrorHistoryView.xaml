<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Controls.ErrorHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}">

    <UserControl.Resources>
        <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="FilterInputStyle" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 화면 제목 -->
        <Border Grid.Row="0"
                Padding="16,11"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,3,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" Margin="0,0,10,0"
                            CornerRadius="7" Background="#E8F1F8">
                        <TextBlock Text="🛠️" FontFamily="Consolas" FontSize="11"
                                   FontWeight="Bold" Foreground="#315F8B"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="에러 이력 현황" FontSize="16" FontWeight="Bold"/>
                        <!--<TextBlock Text="설비에서 발생한 에러 이력을 조건별로 조회합니다."
                                   Margin="0,2,0,0" FontSize="11"
                                   Foreground="{DynamicResource AppTextSubBrush}"/>-->
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}"
                           VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource AppTextSubBrush}"/>
            </Grid>
        </Border>

        <!-- 조회 조건 -->
        <Border Grid.Row="1" Margin="12,10,12,0" Padding="12,10"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Bottom" Margin="18,0,0,0">
                    <Button Content="조회" Command="{Binding SearchCommand}"
                            Background="{DynamicResource BtnPrimaryBrush}"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="엑셀" Command="{Binding ExportExcelCommand}"
                            Background="#2C7A4B"
                            Style="{StaticResource ActionButtonStyle}"/>
                    <Button Content="선택 삭제" Command="{Binding DeleteSelectedCommand}"
                            Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource StatusErrorBrush}"
                            Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock Text="조회기간" Style="{StaticResource FilterLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <DatePicker Width="132" SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                        Style="{StaticResource FilterInputStyle}"/>
                            <TextBlock Text="~" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSubBrush}"/>
                            <DatePicker Width="132" SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                        Style="{StaticResource FilterInputStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="호기" Style="{StaticResource FilterLabelStyle}"/>
                        <ComboBox Width="132"
                                  SelectedValue="{Binding SelectedCrane, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Style="{StaticResource FilterInputStyle}">
                            <ComboBoxItem Content="전체" Tag=""/>
                            <ComboBoxItem Content="1호기" Tag="1"/>
                            <ComboBoxItem Content="2호기" Tag="2"/>
                            <ComboBoxItem Content="3호기" Tag="3"/>
                            <ComboBoxItem Content="4호기" Tag="4"/>
                            <ComboBoxItem Content="5호기" Tag="5"/>
                            <ComboBoxItem Content="6호기" Tag="6"/>
                            <ComboBoxItem Content="7호기" Tag="7"/>
                        </ComboBox>
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 조회 결과 -->
        <Border Grid.Row="2" Margin="12,10,12,12"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="ErrorHistoryGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      Style="{StaticResource ListDataGridStyle}"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="발생일시" Binding="{Binding OccurredAt}" Width="180"/>
                    <DataGridTextColumn Header="호기" Binding="{Binding CraneNo}" Width="90"/>
                    <DataGridTextColumn Header="열-연-단" Binding="{Binding Location}" Width="150"/>
                    <DataGridTextColumn Header="에러내용" Binding="{Binding Description}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
