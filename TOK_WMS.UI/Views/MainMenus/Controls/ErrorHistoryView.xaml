<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TOK.WMS.UI.Views.MainMenus.Controls.ErrorHistoryView" Loaded="UserControl_Loaded" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/ManagementScreenStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FilterLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="800">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource ScreenTitleIconSurfaceStyle}">
                    <Path Data="{StaticResource ScreenPackageIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Stroke="{DynamicResource AppTextBrush}" Margin="0" />
                </Border>
                <TextBlock Text="에러 이력 현황" Style="{StaticResource ScreenTitleTextStyle}" />
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" ItemHeight="50">
                <Button Command="{Binding SearchCommand}" Style="{StaticResource ScreenPrimaryButtonStyle}" ToolTip="조회" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenSearchIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="조회" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource ScreenExcelButtonStyle}" ToolTip="엑셀" Margin="8,0,0,0" CommandParameter="{Binding ElementName=ErrorHistoryGrid}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenExcelIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="엑셀" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ScreenDangerButtonStyle}" ToolTip="선택 삭제" Margin="8,0,0,0" Visibility="{Binding CanDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenDeleteIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="선택 삭제" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CloseCommand}" Style="{StaticResource ScreenSecondaryButtonStyle}" ToolTip="종료" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ScreenPowerIconGeometry}" Style="{StaticResource ScreenToolbarIconStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="종료" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource ScreenCardStyle}" Margin="0,0,0,12">
            <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-8">
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="조회기간" Style="{StaticResource FilterLabelStyle}" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker Width="132" SelectedDate="{Binding StartDate, Mode=TwoWay}" Style="{StaticResource ScreenFilterDatePickerStyle}" />
                        <TextBlock Text="~" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextSubBrush}" />
                        <DatePicker Width="132" SelectedDate="{Binding EndDate, Mode=TwoWay}" Style="{StaticResource ScreenFilterDatePickerStyle}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,16,8">
                    <TextBlock Text="호기" Style="{StaticResource FilterLabelStyle}" />
                    <ComboBox Width="132" SelectedValue="{Binding SelectedCrane, Mode=TwoWay}" SelectedValuePath="Tag" Style="{StaticResource ScreenFilterComboBoxStyle}">
                        <ComboBoxItem Content="전체" Tag="" />
                        <ComboBoxItem Content="1호기" Tag="1" />
                        <ComboBoxItem Content="2호기" Tag="2" />
                        <ComboBoxItem Content="3호기" Tag="3" />
                        <ComboBoxItem Content="4호기" Tag="4" />
                        <ComboBoxItem Content="5호기" Tag="5" />
                        <ComboBoxItem Content="6호기" Tag="6" />
                        <ComboBoxItem Content="7호기" Tag="7" />
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource ScreenCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ScreenSectionTitleStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="에러 이력 목록" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" Style="{StaticResource SectionTitleMetadataTextStyle}" Grid.Column="2" />
                    </Grid>
                </Border>
                <DataGrid x:Name="ErrorHistoryGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" Style="{StaticResource ScreenDataGridStyle}" SelectionMode="Single" ToolTip="열 제목을 끌어 순서를 바꾸거나 경계를 끌어 너비를 조절할 수 있습니다." Grid.Row="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="발생일시" Binding="{Binding OccurredAt}" Width="180" MinWidth="90" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="호기" Binding="{Binding CraneNo}" Width="90" MinWidth="90" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="열-연-단" Binding="{Binding Location}" Width="150" MinWidth="103" ElementStyle="{StaticResource ScreenCellTextStyle}" />
                        <DataGridTextColumn Header="에러내용" Binding="{Binding Description}" Width="*" MinWidth="300" ElementStyle="{StaticResource ScreenLeftCellTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>