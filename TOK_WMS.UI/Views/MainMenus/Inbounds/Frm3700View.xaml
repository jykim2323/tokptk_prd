<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:conv="clr-namespace:TOK.WMS.UI.Converters" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" x:Class="TOK.WMS.UI.Views.MainMenus.Inbounds.Frm3700View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" Loaded="UserControl_Loaded" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/InboundScreenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:LocaFormatConverter x:Key="LocaFormatConverter"/>
            <conv:LstkFlagConverter x:Key="LstkFlagConverter"/>
            <conv:SubkFlagConverter x:Key="SubkFlagConverter"/>
            <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
            <conv:OnlyTimeFormatConverter x:Key="OnlyTimeFormatConverter"/>
            <conv:RadioButtonConverter x:Key="RadioButtonConverter"/>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox">
                <Setter Property="Width" Value="120"/>
                <Setter Property="Padding" Value="5,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="DetailLabelCell" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>
            <Style x:Key="Header" TargetType="Border" BasedOn="{StaticResource InboundSectionTitleStyle}"/>
            <Style x:Key="DetailInputBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="8,3,0,5"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Padding="10" CornerRadius="8" Background="{DynamicResource AppSurface2Brush}" Margin="0,0,12,0">
                    <Path Data="{StaticResource InboundPackageIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Width="20" Height="20" Stroke="{DynamicResource AppTextBrush}" Focusable="False" IsHitTestVisible="False"/>
                </Border>
                <TextBlock Text="입고 실적 현황" Style="{StaticResource InboundTitleTextStyle}"/>
                <TextBlock Text="Frm3700" Style="{StaticResource InboundSubtitleTextStyle}" Margin="12,0,0,0"/>
            </StackPanel>
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" x:Name="ToolbarPanel" Grid.Column="1" VerticalAlignment="Center">
                <Button HorizontalAlignment="Right" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" Style="{StaticResource InboundExcelButtonStyle}" AutomationProperties.Name="엑셀" CommandParameter="{Binding ElementName=DB_Table1}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InboundExcelIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False" Stroke="{StaticResource Frm3300ExcelAccentBrush}"/>
                        <TextBlock Text="엑셀" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource InboundSecondaryButtonStyle}" AutomationProperties.Name="인쇄" IsEnabled="False" ToolTip="현재 사용하지 않는 기능입니다." ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InboundPrinterIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="인쇄" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Right" Margin="0,0,8,0" Style="{StaticResource InboundSecondaryButtonStyle}" AutomationProperties.Name="삭제" IsEnabled="False" ToolTip="현재 사용하지 않는 기능입니다." ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InboundDeleteIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="삭제" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Right" Command="{Binding CloseCommand}" Margin="0,0,0,0" Style="{StaticResource InboundSecondaryButtonStyle}" AutomationProperties.Name="종료">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InboundPowerIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="종료" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>
        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16" behaviors:EnterKey.Command="{Binding SearchCommand}" Style="{StaticResource InboundCardStyle}">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="입고일자:" Style="{StaticResource FilterLabel}" FontSize="14" Margin="0,0,8,0"/>
                    <DatePicker Width="120" Margin="0" FontSize="14" SelectedDate="{Binding FromDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Height="36" VerticalContentAlignment="Center"/>
                    <TextBlock Text="~" Margin="8,0" VerticalAlignment="Center"/>
                    <DatePicker Width="120" Margin="0" FontSize="14" SelectedDate="{Binding ToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedDateFormat="Short" Height="36" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="품목코드:" Style="{StaticResource FilterLabel}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBox Width="200" Text="{Binding ItemCode}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper" Margin="0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                    <TextBlock Text="품목명:" Style="{StaticResource FilterLabel}" FontSize="14" Margin="0,0,8,0"/>
                    <TextBox Width="200" Text="{Binding ItemName}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper" Margin="0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" Command="{Binding SearchCommand}" Margin="0,0,0,8" Style="{StaticResource InboundPrimaryButtonStyle}" AutomationProperties.Name="조회">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InboundSearchIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="조회" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Border Grid.Row="0" Margin="0,10,0,8" Style="{StaticResource InboundCardStyle}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Height="36" Style="{StaticResource Header}" Margin="0,0,0,8">
                            <TextBlock Text="품목별" Style="{StaticResource SectionTitleTextStyle}"/>
                        </Border>
                        <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                        <DataGrid x:Name="DB_Table1" ItemsSource="{Binding Items}" Style="{StaticResource InboundDataGridStyle}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" HeadersVisibility="Column" SelectionMode="Extended" ColumnWidth="Auto" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" GridLinesVisibility="None">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InboundHeaderStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="DisplayIndex" Value="2">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Trigger>
                                        <Trigger Property="DisplayIndex" Value="-1">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource InboundCellStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="2">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="품목코드" Binding="{Binding StkCode}" Width="250" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                                <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="2*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="220"/>
                                <DataGridTextColumn Header="입고중량" Binding="{Binding StkTqty}" Width="130" ElementStyle="{StaticResource InboundRightCellTextStyle}" MinWidth="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <Border Grid.Row="0" Margin="0,10,0,8" Style="{StaticResource InboundCardStyle}">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Top" Height="36" Style="{StaticResource Header}" Margin="0,0,0,8">
                            <TextBlock Text="LOT-NO별" Style="{StaticResource SectionTitleTextStyle}"/>
                        </Border>
                        <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                        <DataGrid x:Name="DB_Table2" ItemsSource="{Binding LotItems}" Style="{StaticResource InboundDataGridStyle}" SelectedItem="{Binding SelectedLotItem, Mode=TwoWay}" HeadersVisibility="Column" SelectionMode="Extended" ColumnWidth="Auto" CanUserSortColumns="True" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" RowHeaderWidth="0" GridLinesVisibility="None">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InboundHeaderStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="DisplayIndex" Value="4">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Trigger>
                                        <Trigger Property="DisplayIndex" Value="-1">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource InboundCellStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="4">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="품목코드" Binding="{Binding StkCode}" Width="250" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                                <DataGridTextColumn Header="품 목 명" Binding="{Binding MastName}" Width="2*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="220"/>
                                <DataGridTextColumn Header="LOT-NO" Binding="{Binding StkLotno}" Width="200" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                                <DataGridTextColumn Header="입고중량" Binding="{Binding StkTqty}" Width="130" ElementStyle="{StaticResource InboundRightCellTextStyle}" MinWidth="100"/>
                                <DataGridTextColumn Header="비고" Width="*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="180"/>
                                <!-- 비고 컬럼은 데이터가 없으므로 바인딩하지 않음 -->
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
