<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:TOK.WMS.UI.Converters" x:Class="TOK.WMS.UI.Views.MainMenus.Inbounds.Frm3300View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" UseLayoutRounding="True" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/Frm3300Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:LocaFormatConverter x:Key="LocaFormatConverter"/>
            <conv:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
            <conv:OnlyTimeFormatConverter x:Key="OnlyTimeFormatConverter"/>

            <Style x:Key="Frm3300CellTextStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Style>
            <Style x:Key="Frm3300LeftTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Frm3300CellTextStyle}">
                <Setter Property="TextAlignment" Value="Left"/>
            </Style>
            <Style x:Key="Frm3300RightTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Frm3300CellTextStyle}">
                <Setter Property="TextAlignment" Value="Right"/>
            </Style>

            <Style x:Key="Frm3300CellStyle" TargetType="DataGridCell" BasedOn="{StaticResource ListCellStyle}">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <Border x:Name="SelectionAccent" Width="3" HorizontalAlignment="Left" Background="{DynamicResource AppPrimaryBrush}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                        <Condition Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="0"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="SelectionAccent" Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="14">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Frm3300ColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ListColumnHeaderStyle}">
                <Setter Property="Height" Value="38"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="DisplayIndex" Value="14">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Trigger>
                    <Trigger Property="DisplayIndex" Value="-1">
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <Grid x:Name="HeaderGrid" DockPanel.Dock="Top" Margin="0,0,0,16" SizeChanged="HeaderGrid_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="TitlePanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Padding="10" CornerRadius="8" Background="{DynamicResource AppSurface2Brush}" Margin="0,0,12,0">
                    <Path Data="{StaticResource Frm3300PackageIconGeometry}" Style="{StaticResource Frm3300ToolbarIconStyle}" Width="20" Height="20" Stroke="{DynamicResource AppTextBrush}" Focusable="False" IsHitTestVisible="False"/>
                </Border>
                <TextBlock Text="미입고 현황" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="Frm3300" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AppTextSubBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" Orientation="Horizontal" ItemHeight="50" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource Frm3300PrimaryButtonStyle}" Command="{Binding SearchCommand}" Margin="0,0,8,0" AutomationProperties.Name="조회">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Frm3300SearchIconGeometry}" Style="{StaticResource Frm3300ToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="조회" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Frm3300ExcelButtonStyle}" Command="{Binding ExportExcelCommand}" CommandParameter="{Binding ElementName=MimastDB_Table}" Margin="0,0,8,0" AutomationProperties.Name="엑셀">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Frm3300ExcelIconGeometry}" Style="{StaticResource Frm3300ToolbarIconStyle}" Stroke="{StaticResource Frm3300ExcelAccentBrush}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="엑셀" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Frm3300SecondaryButtonStyle}" Command="{Binding PrintCommand}" Margin="0,0,16,0" AutomationProperties.Name="인쇄">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Frm3300PrinterIconGeometry}" Style="{StaticResource Frm3300ToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="인쇄" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Frm3300SecondaryButtonStyle}" Command="{Binding DeleteCommand}" Margin="0,0,8,0" AutomationProperties.Name="삭제">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Frm3300DeleteIconGeometry}" Style="{StaticResource Frm3300ToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="삭제" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Frm3300SecondaryButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="종료">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Frm3300PowerIconGeometry}" Style="{StaticResource Frm3300ToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="종료" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Grid>

        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="36" Margin="0,0,0,8" Style="{StaticResource SectionTitleStyle}">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}">
                        <Run Text="미입고 현황 "/>
                        <Run Text="{Binding RowTotalCount, Mode=OneWay}"/>
                        <Run Text="건"/>
                    </TextBlock>
                </Border>
                <DataGrid x:Name="MimastDB_Table" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Style="{StaticResource ListDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None" RowHeight="36" FontSize="14" CellStyle="{StaticResource Frm3300CellStyle}" ColumnHeaderStyle="{StaticResource Frm3300ColumnHeaderStyle}" LoadingRow="DataGrid_LoadingRow" LayoutUpdated="DataGrid_LayoutUpdated" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="번호" Width="60" MinWidth="60" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=DataGridRow}}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="입고일자" Width="130" MinWidth="110" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptIndate, Converter={StaticResource DateTimeFormatConverter}}"/>
                        <DataGridTextColumn Header="입고시간" Width="110" MinWidth="100" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptStime, Converter={StaticResource OnlyTimeFormatConverter}}"/>
                        <DataGridTextColumn Header="호기" Width="64" MinWidth="60" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptHogi}"/>
                        <DataGridTextColumn Header="저장위치" Width="110" MinWidth="100" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptLoca, Converter={StaticResource LocaFormatConverter}}"/>
                        <DataGridTextColumn Header="PLT-NO" Width="140" MinWidth="130" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptPltno}"/>
                        <DataGridTextColumn Header="품목코드" Width="180" MinWidth="160" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptCode}"/>
                        <DataGridTextColumn Header="품목명" Width="2*" MinWidth="220" ElementStyle="{StaticResource Frm3300LeftTextStyle}" Binding="{Binding MastName}"/>
                        <DataGridTextColumn Header="LOT-NO" Width="180" MinWidth="160" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptLotno}"/>
                        <DataGridTextColumn Header="입고중량" Width="110" MinWidth="100" ElementStyle="{StaticResource Frm3300RightTextStyle}" Binding="{Binding InptWeight}"/>
                        <DataGridTextColumn Header="BOX-NO" Width="180" MinWidth="150" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptBoxno}"/>
                        <DataGridTextColumn Header="비고" Width="*" MinWidth="180" ElementStyle="{StaticResource Frm3300LeftTextStyle}" Binding="{Binding InptRemark}"/>
                        <DataGridTextColumn Header="입고순번" Width="170" MinWidth="150" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptIndex}"/>
                        <DataGridTextColumn Header="발행" Width="64" MinWidth="60" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptLabel}"/>
                        <DataGridTextColumn Header="사용자ID" Width="120" MinWidth="110" ElementStyle="{StaticResource Frm3300CellTextStyle}" Binding="{Binding InptId}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
