<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="http://schemas.microsoft.com/xaml/behaviors" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" x:Class="TOK.WMS.UI.Views.MainMenus.Inbounds.Frm3100View" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}" FontWeight="Medium" Loaded="UserControl_Loaded" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TOK.WMS.UI;component/Styles/InboundScreenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            </Style>
            <Style x:Key="FilterBox" TargetType="TextBox">
                <Setter Property="Width" Value="120"/>
                <Setter Property="Padding" Value="5,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="DetailLabelCell" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="12,0"/>
            </Style>
            <Style x:Key="Header" TargetType="Border" BasedOn="{StaticResource InboundSectionTitleStyle}"/>
            <Style x:Key="DetailInputBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="8,3,0,5"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource BtnPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="16">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16" behaviors:ResponsiveHeader.Toolbar="{Binding ElementName=ToolbarPanel}" behaviors:ResponsiveHeader.StackBelowWidth="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Padding="10" CornerRadius="8" Background="{DynamicResource AppSurface2Brush}" Margin="0,0,12,0">
                    <Path Data="{StaticResource InboundPackageIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Width="20" Height="20" Stroke="{DynamicResource AppTextBrush}" Focusable="False" IsHitTestVisible="False"/>
                </Border>
                <TextBlock Text="수동 입고 등록" Style="{StaticResource InboundTitleTextStyle}"/>
                <TextBlock Text="Frm3100" Style="{StaticResource InboundSubtitleTextStyle}" Margin="12,0,0,0"/>
            </StackPanel>
            <WrapPanel x:Name="ToolbarPanel" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource InboundSecondaryButtonStyle}" Command="{Binding CloseCommand}" AutomationProperties.Name="종료">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource InboundPowerIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                        <TextBlock Text="종료" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource AppTextSubBrush}" Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,16" Style="{StaticResource InboundCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Row 0: 조회기간 + 호기 -->
                <!-- Row 1: 나머지 필터(좌) + 버튼(우) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="품목코드:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="200" Text="{Binding ItemEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="품목명:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="200" Text="{Binding ItemNmEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="PLTNO:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="200" Text="{Binding PltnoSrcEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper" Margin="0">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding TrackingCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,8">
                            <TextBlock Text="바코드:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Text="{Binding BcrEdit}" Style="{StaticResource DetailInputBox}" Width="200" MaxLength="300" CharacterCasing="Upper" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6"/>
                    </WrapPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Command="{Binding SearchCommand}" Margin="0,0,10,10" Style="{StaticResource InboundPrimaryButtonStyle}" AutomationProperties.Name="조회">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource InboundSearchIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                                <TextBlock Text="조회" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Margin="0,10,0,8" Style="{StaticResource InboundCardStyle}">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Height="36" Style="{StaticResource Header}" Margin="0,0,0,8">
                        <TextBlock Text="품목 조회" Style="{StaticResource SectionTitleTextStyle}"/>
                    </Border>
                    <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                    <DataGrid x:Name="MimastDB_Table" ItemsSource="{Binding Items}" Style="{StaticResource InboundDataGridStyle}" SelectionMode="Extended" ColumnWidth="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InboundHeaderStyle}">
                                <Style.Triggers>
                                    <Trigger Property="DisplayIndex" Value="7">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Trigger>
                                    <Trigger Property="DisplayIndex" Value="-1">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource InboundCellStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="7">
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding MastCode}" Width="160" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                            <DataGridTextColumn Header="바코드" Binding="{Binding MastBcode}" Width="180" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="품목명" Binding="{Binding MastName}" Width="2*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="220"/>
                            <DataGridTextColumn Header="단위" Binding="{Binding MastUnit}" Width="80" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="60"/>
                            <DataGridTextColumn Header="중량" Binding="{Binding MastWeight}" Width="100" ElementStyle="{StaticResource InboundRightCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="구분1" Binding="{Binding Gubn1Name}" Width="220" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="구분2" Binding="{Binding Gubn2Name}" Width="230" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="90"/>
                            <DataGridTextColumn Header="구분3" Binding="{Binding Gubn3Name}" Width="*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="90"/>
                        </DataGrid.Columns>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding MimastCellClickCommand}" CommandParameter="{Binding SelectedItem, ElementName=MimastDB_Table}"/>
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DataGrid>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                <Grid x:Name="DetailWorkGrid" behaviors:ResponsiveWorkLayout.DetailWidth="480" behaviors:ResponsiveWorkLayout.StackBelowWidth="1100" behaviors:ResponsiveWorkLayout.Detail="{Binding ElementName=DetailCard}" behaviors:ResponsiveWorkLayout.Actions="{Binding ElementName=ActionCard}" behaviors:ResponsiveWorkLayout.Work="{Binding ElementName=WorkCard}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="0"/>
                        <RowDefinition Height="0"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource InboundCardStyle}" x:Name="DetailCard">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="36" Style="{StaticResource Header}" Margin="0,0,0,12">
                                <TextBlock Text="입고 상세 입력" Style="{StaticResource SectionTitleTextStyle}"/>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                        <RowDefinition Height="42"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="PLT-NO"/>
                                    </Border>
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="6,0,0,4" Text="{Binding PltnoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource DetailInputBox}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTrackingValid}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="품목코드"/>
                                    </Border>
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding ItnbrEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="품목명"/>
                                    </Border>
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding NameEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="중량"/>
                                    </Border>
                                    <TextBox x:Name="WeightTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding WeightEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="NumInput" CharacterCasing="Upper"/>
                                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="LOT-NO"/>
                                    </Border>
                                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding LotnoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="BOX-NO"/>
                                    </Border>
                                    <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding BoxNoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                        <TextBlock Style="{StaticResource FilterLabel}" Text="비고"/>
                                    </Border>
                                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding BigoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="0,0,0,8" x:Name="ActionCard">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="ActionPanel">
                            <Button x:Name="ConfirmBtn" Command="{Binding AddCommand}" Margin="0,0,0,12" Style="{StaticResource InboundPrimaryButtonStyle}" AutomationProperties.Name="추가">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource InboundPlusIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                                    <TextBlock Text="추가" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelSB" Command="{Binding CancelCommand}" Margin="0,0,0,0" Style="{StaticResource InboundSecondaryButtonStyle}" AutomationProperties.Name="취소">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource InboundDeleteIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                                    <TextBlock Text="취소" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="0" Style="{StaticResource InboundCardStyle}" x:Name="WorkCard">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Height="36" Style="{StaticResource Header}" Margin="0,0,0,12">
                                <TextBlock Text="입고 예정" Style="{StaticResource SectionTitleTextStyle}"/>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DataGrid x:Name="InResGrid" Grid.Row="0" ItemsSource="{Binding ReservationItems}" SelectedItem="{Binding SelectedResItem, Mode=TwoWay}" Style="{StaticResource InboundDataGridStyle}" SelectionMode="Extended" ColumnWidth="Auto" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource InboundHeaderStyle}">
                                            <Style.Triggers>
                                                <Trigger Property="DisplayIndex" Value="6">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                </Trigger>
                                                <Trigger Property="DisplayIndex" Value="-1">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource InboundCellStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource Self}}" Value="6">
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PLT-NO" Binding="{Binding SubkPltno}" Width="180" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="120"/>
                                        <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="180" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                                        <DataGridTextColumn Header="품목명" Binding="{Binding MastName}" Width="2*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="220"/>
                                        <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="160" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                                        <DataGridTextColumn Header="중량" Binding="{Binding SubkWgt}" Width="120" ElementStyle="{StaticResource InboundRightCellTextStyle}" MinWidth="90"/>
                                        <DataGridTextColumn Header="BOX-NO" Binding="{Binding SubkBoxno}" Width="180" ElementStyle="{StaticResource InboundCellTextStyle}" MinWidth="150"/>
                                        <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" ElementStyle="{StaticResource InboundLeftCellTextStyle}" MinWidth="180"/>
                                        <DataGridTextColumn Header="신규구분" Binding="{Binding SubkRowState}" Width="0" Visibility="Collapsed"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Border Grid.Row="1">
                                    <Button x:Name="ReservedSB" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Style="{StaticResource InboundPrimaryButtonStyle}" AutomationProperties.Name="입고확정">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource InboundConfirmIconGeometry}" Style="{StaticResource InboundToolbarIconStyle}" Margin="0,0,8,0" Focusable="False" IsHitTestVisible="False"/>
                                            <TextBlock Text="입고확정" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
