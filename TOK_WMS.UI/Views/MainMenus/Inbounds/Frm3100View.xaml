<UserControl x:Class="TOK.WMS.UI.Views.MainMenus.Inbounds.Frm3100View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Background="{DynamicResource AppBackgroundBrush}"
             Foreground="{DynamicResource AppTextBrush}"
             FontFamily="{StaticResource AppFont}"
             FontWeight="Medium"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style x:Key="FilterBox" TargetType="TextBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailLabelCell" TargetType="Border">
            <Setter Property="Background" Value="#F2F6FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <Style x:Key="Header" TargetType="Border">
            <Setter Property="Background" Value="#ebf4fc"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="2,2,2,2"/>
        </Style>

        <Style x:Key="DetailInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="8,3,0,5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush"
                    Value="{DynamicResource BtnPrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>


    <DockPanel Margin="12">
        <!-- 헤더 -->
        <Grid DockPanel.Dock="Top" Margin="0,0,10,0" >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="📥" FontSize="20" Margin="0,5,5,10" VerticalAlignment="Center"/>
                <TextBlock Text="수동 입고 등록" FontSize="20" FontWeight="Bold"
                    Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="- Frm3100" FontSize="12" FontWeight="Bold" Margin="10,0,0,0"
                    Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" VerticalAlignment="Center"
                FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextSubBrush}"/>
        </Grid>

        <!-- 검색 조건 -->
        <Border DockPanel.Dock="Top"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 조회기간 + 호기 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                </StackPanel>

                <!-- Row 1: 나머지 필터(좌) + 버튼(우) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                            <TextBlock Text="품목코드:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="220" Text="{Binding ItemEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,0,18,6">
                            <TextBlock Text="품목명:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="220" Text="{Binding ItemNmEdit}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,0,18,6">
                            <TextBlock Text="PLTNO:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="300" Text="{Binding PltnoSrcEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DetailInputBox}" CharacterCasing="Upper">
                                <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding TrackingCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="20,0,18,6">
                            <TextBlock Text="바코드:" Style="{StaticResource FilterLabel}"/>
                            <TextBox Text="{Binding BcrEdit}" Style="{StaticResource DetailInputBox}" Width="300" MaxLength="300" CharacterCasing="Upper"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                        </StackPanel>
                    </WrapPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="🔍 조회" Width="90" Command="{Binding SearchCommand}" Margin="0,0,10,10"
                            Padding="16,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                            Background="{DynamicResource BtnPrimaryBrush}" Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,10,0,8">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top" Height="40" Style="{StaticResource Header}"
                        BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,8">
                        <TextBlock Text="품목 조회" 
                            FontSize="18" FontWeight="Bold" 
                            Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <!-- 결과 그리드: 컬럼이 데이터 길이에 맞춰 자동 너비 -->
                    <DataGrid x:Name="MimastDB_Table" ItemsSource="{Binding Items}"
                         Style="{StaticResource ListDataGridStyle}"
                         SelectionMode="Extended"
                         ColumnWidth="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="품목코드" Binding="{Binding MastCode}" Width="160" />
                            <DataGridTextColumn Header="바코드" Binding="{Binding MastBcode}" Width="180" />
                            <DataGridTextColumn Header="품목명" Binding="{Binding MastName}" Width="260" />
                            <DataGridTextColumn Header="단위" Binding="{Binding MastUnit}" Width="80" />
                            <DataGridTextColumn Header="중량" Binding="{Binding MastWeight}" Width="100" />
                            <DataGridTextColumn Header="구분1" Binding="{Binding Gubn1Name}" Width="220" />
                            <DataGridTextColumn Header="구분2" Binding="{Binding Gubn2Name}" Width="230" />
                            <DataGridTextColumn Header="구분3" Binding="{Binding Gubn3Name}" Width="*" />
                        </DataGrid.Columns>
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="MouseDoubleClick">
                                <i:InvokeCommandAction Command="{Binding MimastCellClickCommand}" CommandParameter="{Binding SelectedItem, ElementName=MimastDB_Table}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" 
                     Padding="7,5" Margin="0,0,0,5">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Height="40" Style="{StaticResource Header}" Margin="0,20,0,8">
                            <TextBlock Text="입고 상세 입력" 
                                FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="42" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="PLT-NO" />
                            </Border>

                            <TextBox Grid.Row="0"  Grid.Column="1" Margin="6,0,0,4" Text="{Binding PltnoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource DetailInputBox}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTrackingValid}" Value="True">
                                                <Setter Property="Background" Value="LightGray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="품목코드" />
                            </Border>

                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding ItnbrEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" />

                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="품목명" />
                            </Border>

                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding NameEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" />

                            <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="중량" />
                            </Border>

                            <TextBox x:Name="WeightTextBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding WeightEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     PreviewTextInput="NumInput" CharacterCasing="Upper"/>

                            <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="LOT-NO" />
                            </Border>

                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding LotnoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>

                            <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="BOX-NO" />
                            </Border>

                            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding BoxNoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>

                            <Border Grid.Row="6" Grid.Column="0"  Style="{StaticResource DetailLabelCell}">
                                <TextBlock Style="{StaticResource FilterLabel}" Text="비고" />
                            </Border>

                            <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailInputBox}" Margin="6,0,0,4" Text="{Binding BigoEdit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Column="1"  Margin="0,0,0,8">
                    <StackPanel>
                        <Button x:Name="ConfirmBtn" Width="90" Content="➕ 추가" Command="{Binding AddCommand}"  Margin="0,150,0,0"
                            Padding="16,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                            Background="{DynamicResource BtnPrimaryBrush}" 
                            Foreground="{DynamicResource BtnPrimaryTextBrush}"/>

                        <Button x:Name="CancelSB" Width="90" Content="🗑 취소" Command="{Binding CancelCommand}" Margin="0,60,0,0"
                            Padding="16,6" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                            Background="{DynamicResource StatusIdleBrush}" 
                            Foreground="{DynamicResource BtnPrimaryTextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                     Padding="7,5" Margin="0,0,0,8">
                    <DockPanel>

                        <Border DockPanel.Dock="Top" Height="40" Style="{StaticResource Header}"  Margin="0,20,0,8">
                            <TextBlock Text="입고 예정" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="InResGrid"
                                Grid.Row="0"
                                ItemsSource="{Binding ReservationItems}"
                                SelectedItem="{Binding SelectedResItem, Mode=TwoWay}"
                                Style="{StaticResource ListDataGridStyle}"
                                SelectionMode="Extended"
                                ColumnWidth="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PLT-NO" Binding="{Binding SubkPltno}" Width="180" />
                                    <DataGridTextColumn Header="품목코드" Binding="{Binding SubkCode}" Width="180" />
                                    <DataGridTextColumn Header="품목명" Binding="{Binding MastName}" Width="200" />
                                    <DataGridTextColumn Header="LOT-NO" Binding="{Binding SubkLotno}" Width="160" />
                                    <DataGridTextColumn Header="중량" Binding="{Binding SubkWgt}" Width="120" />
                                    <DataGridTextColumn Header="BOX-NO" Binding="{Binding SubkBoxno}" Width="180" />
                                    <DataGridTextColumn Header="비고" Binding="{Binding SubkRemark}" Width="*" />
                                    <DataGridTextColumn Header="신규구분" Binding="{Binding SubkRowState}" Width="0" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1">
                                <Button x:Name="ReservedSB" Content="➕ 입고확정" Command="{Binding SaveCommand}" HorizontalAlignment="Right"
                                    Padding="16,8" FontWeight="Bold" Cursor="Hand" BorderThickness="0"
                                    Background="{DynamicResource BtnPrimaryBrush}" 
                                    Foreground="{DynamicResource BtnPrimaryTextBrush}" Width="115"/>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Border>

            </Grid>
        </Grid>
    </DockPanel>

</UserControl>
