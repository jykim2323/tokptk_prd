<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors" x:Class="TOK.WMS.UI.Views.Monitoring.Popups.RackCellDetailView" Title="셀 정보" Width="1460" Height="650" MinWidth="900" MinHeight="520" Style="{DynamicResource MonitoringPopupWindowStyle}" Foreground="{DynamicResource AppTextBrush}" FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource BtnPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryTextBrush}"/>
        </Style>

        <Style x:Key="CellActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,9" Background="{DynamicResource HeaderBrush}" CornerRadius="9" behaviors:PopupWindowBehavior.IsDragHandle="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="셀 정보" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource AppTextOnPrimBrush}" Text="T2 셀 상태와 품목별 재고를 관리합니다."/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="등록" Command="{Binding AddCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ToolbarButtonStyle}" Background="#44FFFFFF"/>
                    <Button Content="수정" Command="{Binding EditCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource ToolbarButtonStyle}" Background="#44FFFFFF"/>
                    <Button Content="삭제" Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarButtonStyle}" Background="#44FFFFFF"/>
                    <Button Content="조회" Command="{Binding SearchCommand}" Style="{StaticResource ToolbarButtonStyle}" Background="#44FFFFFF"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PopupCloseButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="저장위치 (열-연-단)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding DisplayLocation}" Style="{StaticResource ReadOnlyFieldStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="셀 상태" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding CellStatusName}" Style="{StaticResource ReadOnlyFieldStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button Command="{Binding ProhibitCommand}" Style="{StaticResource CellActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource StatusErrorBrush}"/>
                            <TextBlock Text="금지" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EnableCommand}" Style="{StaticResource CellActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource MonitoringBcrEnabledTextBrush}"/>
                            <TextBlock Text="사용" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SectionTitleStyle}" Grid.Row="2" Margin="2,11,2,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="셀 품목 재고" Style="{StaticResource SectionTitleTextStyle}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitleMetadataTextStyle}" Text="{Binding InventoryCount, StringFormat={}{0:N0}건}"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="5">
            <DataGrid ItemsSource="{Binding InventoryItems}" SelectedItem="{Binding SelectedInventoryItem, Mode=TwoWay}" Style="{StaticResource ListDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="상태" Binding="{Binding Flag}" Width="75"/>
                    <DataGridTextColumn Header="PLT-NO" Binding="{Binding PalletNo}" Width="145"/>
                    <DataGridTextColumn Header="품번코드" Binding="{Binding ItemCode}" Width="135"/>
                    <DataGridTextColumn Header="품번명" Binding="{Binding ItemName}" Width="185"/>
                    <DataGridTextColumn Header="LOT-NO" Binding="{Binding LotNo}" Width="135"/>
                    <DataGridTextColumn Header="재고수량" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="예약수량" Binding="{Binding ReservedQuantity, StringFormat={}{0:N2}}" Width="105"/>
                    <DataGridTextColumn Header="BOX-NO" Binding="{Binding BoxNo}" Width="125"/>
                    <DataGridTextColumn Header="비고" Binding="{Binding Remark}" Width="180"/>
                    <DataGridTextColumn Header="입고일자" Binding="{Binding InDate}" Width="105"/>
                    <DataGridTextColumn Header="입고시간" Binding="{Binding InTime}" Width="105"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="2,10,2,0">
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppTextSubBrush}" Text="{Binding StatusMessage}"/>
        </Grid>
    </Grid>
</Window>
