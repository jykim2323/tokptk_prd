<Window x:Class="TOK.WMS.UI.Views.Monitoring.Popups.StackerWorkView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
        Title="Stacker Crane 작업 관리"
        Width="640"
        Height="860"
        MinWidth="600"
        MinHeight="820"
        Style="{StaticResource MonitoringPopupWindowStyle}"
        Foreground="{DynamicResource AppTextBrush}">

    <Window.Resources>
        <Style x:Key="FieldLabelBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="#203A60"/>
            <Setter Property="BorderBrush" Value="#172C49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
        </Style>

        <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="ReadOnlyFieldStyle" TargetType="TextBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="{DynamicResource BtnStadardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryTextBrush}"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ToolbarButtonStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="2,0,2,9"
                Padding="13,8"
                Background="{DynamicResource HeaderBrush}"
                CornerRadius="8"
                behaviors:PopupWindowBehavior.IsDragHandle="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Stacker Crane 작업 관리"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                    <TextBlock Text="{Binding SelectedCraneNo, StringFormat={}{0}호기 현재 작업 상태}"
                               Margin="0,2,0,0"
                               FontSize="11.5"
                               Foreground="#EAF4FB"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource PopupCloseButtonStyle}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="{Binding CanInteract}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="10,7"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="2,0,9,0"
                           Text="처리 결과"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSubBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource AppTextSubBrush}"/>
                <Button Grid.Column="2"
                        Content="조회"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding CanInteract}"/>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="2"
                     Height="3"
                     Margin="0,6,0,0"
                     IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Border Grid.Row="3"
                Margin="0,8,0,7"
                Padding="9,7"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="SRC 호기" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Text="{Binding SelectedCraneNo, Mode=OneWay, StringFormat={}{0}}"
                             Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="진행상태" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Current.Cycle, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="자동/수동" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Current.Online, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="작업대기" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Current.Ready, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="지시응답" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Current.Acknowledged, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="Fork Center" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Current.Centered, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="Load 완료" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Current.LoadComplete, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="UnLoad 완료" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Current.UnloadComplete, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="8" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="PLT 유무" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Current.HasPallet, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="9" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="PLT NO" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding Current.PalletNo, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="10" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="위치" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding LocationDisplay, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="11" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="작업 순번" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="11" Grid.Column="1"
                             Text="{Binding Current.JobIndex, Mode=OneWay}"
                             ToolTip="{Binding Current.JobIndex}"
                             HorizontalScrollBarVisibility="Auto"
                             Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="12" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="현재위치" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding PositionDisplay, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="13" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="원점복귀" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding Current.Home, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="14" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="에러발생" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Current.Error, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="15" Grid.Column="0"
                            Height="31"
                            Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="에러내용" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="15" Grid.Column="1"
                             Height="31"
                             Text="{Binding Current.ErrorDescription, Mode=OneWay}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="{Binding Current.ErrorDescription}"
                             Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="16" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="높이" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding Current.Height, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>

                    <Border Grid.Row="17" Grid.Column="0" Style="{StaticResource FieldLabelBoxStyle}">
                        <TextBlock Text="스테이션" Style="{StaticResource FieldLabelTextStyle}"/>
                    </Border>
                    <TextBox Grid.Row="17" Grid.Column="1" Text="{Binding Current.WorkStation, Mode=OneWay}" Style="{StaticResource ReadOnlyFieldStyle}"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <UniformGrid Grid.Row="4" Columns="4" HorizontalAlignment="Center">
            <Button Content="재지시"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{DynamicResource AppAccentBrush}"
                    Command="{Binding ReissueCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    IsEnabled="{Binding CanInteract}"/>
            <Button Content="작업완료"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{DynamicResource BtnPrimaryBrush}"
                    Command="{Binding CompleteCommand}"
                    IsEnabled="{Binding CanInteract}"/>
            <Button Content="강제삭제"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="#B42318"
                    Command="{Binding ForceDeleteCommand}"
                    IsEnabled="{Binding CanInteract}"/>
            <Button Content="에러해제"
                    Style="{StaticResource ActionButtonStyle}"
                    Background="{DynamicResource BtnStadardBrush}"
                    Command="{Binding ClearErrorCommand}"
                    IsEnabled="{Binding CanInteract}"/>
        </UniformGrid>

        <TextBlock Grid.Row="5"
                   Margin="4,6,4,0"
                   Text="※ 설비 상태를 확인한 후 작업 버튼을 실행하세요."
                   TextAlignment="Center"
                   Foreground="{DynamicResource AppTextSubBrush}"
                   FontSize="11"/>
    </Grid>
</Window>
