<Window x:Class="TOK.WMS.UI.Views.Monitoring.Popups.RackInventoryEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
        Title="{Binding Title}"
        Width="900"
        Height="820"
        MinWidth="700"
        MinHeight="500"
        Style="{StaticResource MonitoringPopupWindowStyle}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
        </Style>
        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppSurface2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FlagInputStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,11"
                CornerRadius="9"
                Background="{DynamicResource HeaderBrush}"
                TextElement.Foreground="{DynamicResource AppTextOnPrimBrush}"
                behaviors:PopupWindowBehavior.IsDragHandle="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                <Button Grid.Column="1"
                        Content="✕"
                        Style="{StaticResource PopupCloseButtonStyle}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,10"
                Padding="18,12"
                CornerRadius="7"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <Grid IsEnabled="{Binding IsNotSaving}" Margin="0,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="저장위치" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             IsReadOnly="True"
                             Text="{Binding DisplayLocation, Mode=OneWay}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="1" Text="상태" Style="{StaticResource FieldLabelStyle}"/>
                    <ComboBox Grid.Row="1" Grid.Column="1"
                              ItemsSource="{Binding FlagOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedFlag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FlagInputStyle}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Text="PLT-NO" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1"
                             MaxLength="12"
                             CharacterCasing="Upper"
                             Text="{Binding PalletNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="3" Text="품번코드" Style="{StaticResource FieldLabelStyle}"/>
                    <Grid Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox MaxLength="18"
                                 CharacterCasing="Upper"
                                 IsReadOnly="{Binding IsEditing}"
                                 Text="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FieldInputStyle}"/>
                        <Button Grid.Column="1"
                                Width="40"
                                Height="36"
                                Margin="8,0,0,0"
                                Content="🔍"
                                ToolTip="품번 조회"
                                Command="{Binding ItemSearchCommand}"
                                Background="{DynamicResource AppSurface2Brush}"
                                Foreground="{DynamicResource AppTextBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand"/>
                    </Grid>

                    <TextBlock Grid.Row="4" Text="품번명" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="4" Grid.Column="1"
                             IsReadOnly="True"
                             Text="{Binding ItemName, Mode=OneWay}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="5" Text="LOT-NO" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="5" Grid.Column="1"
                             MaxLength="20"
                             IsReadOnly="{Binding IsEditing}"
                             Text="{Binding LotNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="6" Text="재고수량" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="6" Grid.Column="1"
                             MaxLength="8"
                             ToolTip="0~99999.99, 소수 둘째 자리까지"
                             Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="7" Text="예약수량" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="7" Grid.Column="1"
                             MaxLength="8"
                             ToolTip="재고수량 이하, 소수 둘째 자리까지"
                             Text="{Binding ReservedQuantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="8" Text="BOX-NO" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="8" Grid.Column="1"
                             MaxLength="30"
                             Text="{Binding BoxNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="9" Text="비고" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="9" Grid.Column="1"
                             MaxLength="30"
                             Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>

                    <TextBlock Grid.Row="10" Text="입고일자" Style="{StaticResource FieldLabelStyle}"/>
                    <DatePicker Grid.Row="10" Grid.Column="1"
                                Height="36"
                                MaxWidth="260"
                                HorizontalAlignment="Left"
                                SelectedDateFormat="Short"
                                SelectedDate="{Binding InDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Background="{DynamicResource InputBrush}"
                                Foreground="{DynamicResource AppTextBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}">
                        <DatePicker.Resources>
                            <Style TargetType="{x:Type DatePickerTextBox}">
                                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </DatePicker.Resources>
                        <DatePicker.CalendarStyle>
                            <Style TargetType="Calendar">
                                <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                            </Style>
                        </DatePicker.CalendarStyle>
                    </DatePicker>

                    <TextBlock Grid.Row="11" Text="입고시간" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="11" Grid.Column="1"
                             Width="160"
                             HorizontalAlignment="Left"
                             MaxLength="8"
                             ToolTip="HH:mm:ss"
                             Text="{Binding InTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FieldInputStyle}"/>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSubBrush}"/>
            <ProgressBar Grid.Column="1"
                         Width="130"
                         Height="5"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsSaving, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="확정"
                    Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource BtnPrimaryBrush}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="종료"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource BtnStadardBrush}"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
