<Window x:Class="TOK.WMS.UI.Views.Monitoring.Popups.TrackingInfoView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
        Title="트렉킹 정보"
        Width="720"
        Height="520"
        Style="{StaticResource MonitoringPopupWindowStyle}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSubBrush}"/>
        </Style>

        <Style x:Key="FieldInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="TrackInputStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,11"
                Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource AppAccentBrush}"
                BorderThickness="1"
                CornerRadius="9"
                TextElement.Foreground="{DynamicResource AppTextOnPrimBrush}"
                behaviors:PopupWindowBehavior.IsDragHandle="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="트렉킹 정보"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Margin="0,3,0,0"
                               Text="T2 콘베이어 구간의 현재 추적 정보를 조회하고 수정합니다."
                               FontSize="11"
                               Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           MaxWidth="260"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextOnPrimBrush}"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Style="{StaticResource PopupCloseButtonStyle}"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,12,0,12"
                Padding="18,16"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <Grid IsEnabled="{Binding IsNotBusy}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="구간 번호"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="TrackNoComboBox"
                          Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding TrackNumbers}"
                          SelectedItem="{Binding SelectedTrackNo, Mode=TwoWay}"
                          Style="{StaticResource TrackInputStyle}"
                          SelectionChanged="TrackNoComboBox_SelectionChanged"/>

                <TextBlock Grid.Row="0" Grid.Column="3"
                           Text="입/출고 순번"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="4"
                         MaxLength="20"
                         Text="{Binding Index, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Margin="0,10,0,0"
                           Text="저장위치"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Margin="0,10,0,0"
                         MaxLength="6"
                         ToolTip="숫자 6자리(BBYYLL)"
                         Text="{Binding Location, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="3"
                           Margin="0,10,0,0"
                           Text="구분"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="1" Grid.Column="4"
                         Margin="0,10,0,0"
                         MaxLength="1"
                         CharacterCasing="Upper"
                         Text="{Binding JobType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Margin="0,10,0,0"
                           Text="작업 위치"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Margin="0,10,0,0"
                         MaxLength="1"
                         Text="{Binding WorkStation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="3"
                           Margin="0,10,0,0"
                           Text="Flag"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="4"
                         Margin="0,10,0,0"
                         MaxLength="1"
                         CharacterCasing="Upper"
                         Text="{Binding Flag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,10,0,0"
                           Text="FROM"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="1"
                         Margin="0,10,0,0"
                         MaxLength="2"
                         Text="{Binding From, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="3"
                           Margin="0,10,0,0"
                           Text="TO"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="3" Grid.Column="4"
                         Margin="0,10,0,0"
                         MaxLength="2"
                         Text="{Binding To, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Margin="0,10,0,0"
                           Text="일자"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                         Margin="0,10,0,0"
                         MaxLength="8"
                         ToolTip="YYYYMMDD"
                         Text="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="3"
                           Margin="0,10,0,0"
                           Text="시간"
                           Style="{StaticResource FieldLabelStyle}"/>
                <TextBox Grid.Row="4" Grid.Column="4"
                         Margin="0,10,0,0"
                         MaxLength="6"
                         ToolTip="HHMMSS"
                         Text="{Binding Time, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FieldInputStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="12,9"
                Background="{DynamicResource AppSurface2Brush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="{Binding IsMoveTargetVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid IsEnabled="{Binding IsNotBusy}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Margin="0,0,12,0"
                           Text="이동할 구간"
                           Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="MoveTargetComboBox"
                          Grid.Column="1"
                          ItemsSource="{Binding TrackNumbers}"
                          SelectedItem="{Binding MoveTargetTrackNo, Mode=TwoWay}"
                          Style="{StaticResource TrackInputStyle}"
                          SelectionChanged="MoveTargetComboBox_SelectionChanged"/>
                <TextBlock Grid.Column="2"
                           Margin="12,0"
                           Text="대상 구간을 선택하면 이동 여부를 확인합니다."
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextSubBrush}"/>
                <Button Grid.Column="3"
                        Content="취소"
                        Command="{Binding CancelMoveCommand}"
                        Background="{DynamicResource BtnStadardBrush}"
                        Style="{StaticResource ActionButtonStyle}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="이동"
                        Command="{Binding BeginMoveCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Background="#4B6FA8"
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="조회"
                        Command="{Binding SearchCommand}"
                        IsEnabled="{Binding IsNotBusy}"
                        Background="{DynamicResource BtnPrimaryBrush}"
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="등록"
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="{Binding IsNotBusy}"
                        Background="#2C7A4B"
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="삭제"
                        Command="{Binding DeleteCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        IsEnabled="{Binding IsNotBusy}"
                        Background="{DynamicResource StatusErrorBrush}"
                        Style="{StaticResource ActionButtonStyle}"/>
                <Button Content="종료"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{DynamicResource BtnStadardBrush}"
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
