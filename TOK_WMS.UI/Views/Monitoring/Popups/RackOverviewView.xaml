<Window x:Class="TOK.WMS.UI.Views.Monitoring.Popups.RackOverviewView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:TOK.WMS.UI.Behaviors"
        mc:Ignorable="d"
        Title="랙 현황"
        Width="1460"
        Height="880"
        MinWidth="860"
        MinHeight="620"
        Style="{StaticResource MonitoringPopupWindowStyle}"
        Foreground="{DynamicResource AppTextBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{DynamicResource BtnPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnPrimaryTextBrush}"/>
        </Style>

        <Style x:Key="RackCellBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFF7ED"/>
            <Setter Property="TextElement.Foreground" Value="#172B4D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Flag}" Value="0">
                    <Setter Property="Background" Value="#F3F4F6"/>
                    <Setter Property="TextElement.Foreground" Value="#334155"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="1">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="X">
                    <Setter Property="Background" Value="#7CFC00"/>
                    <Setter Property="TextElement.Foreground" Value="#172B4D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="Y">
                    <Setter Property="Background" Value="#008080"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="W">
                    <Setter Property="Background" Value="#800080"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="D">
                    <Setter Property="Background" Value="#800080"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="E">
                    <Setter Property="Background" Value="#DC2626"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Flag}" Value="N">
                    <Setter Property="Background" Value="#111827"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter Property="Background" Value="#CBD5E1"/>
                    <Setter Property="TextElement.Foreground" Value="#64748B"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                    <Setter Property="Opacity" Value="0.52"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RackHeaderBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="74"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Background" Value="#203B6A"/>
            <Setter Property="BorderBrush" Value="#AFC5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="14,9"
                Background="{DynamicResource HeaderBrush}"
                CornerRadius="9"
                behaviors:PopupWindowBehavior.IsDragHandle="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▦" FontSize="25" Foreground="White" Margin="0,0,8,0"/>
                    <TextBlock Text="랙 현황" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Margin="12,5,0,0"
                               Foreground="#EAF4FB"
                               Text="셀을 더블클릭하면 상세 정보를 열 수 있습니다."/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="✕"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource PopupCloseButtonStyle}"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Padding="12,10"
                CornerRadius="5"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource AppSurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="열 선택"/>
                <ComboBox Grid.Column="1"
                          Height="34"
                          Margin="10,0,0,0"
                          Padding="8,3"
                          ItemsSource="{Binding BankOptions}"
                          SelectedItem="{Binding SelectedBank, Mode=TwoWay}"
                          Background="{DynamicResource InputBrush}"
                          BorderBrush="{DynamicResource InputBorderBrush}"/>
                <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Text="열"/>
                <TextBlock Grid.Column="3"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSubBrush}"
                           Text="{Binding StatusMessage}"/>
                <Button Grid.Column="4"
                        Content="조회"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ToolbarButtonStyle}"/>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="2" Margin="0,0,0,10" VerticalAlignment="Center">
            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="상태"/>
            <Border Width="14" Height="14" Background="#F3F4F6" BorderBrush="#94A3B8" BorderThickness="1"/>
            <TextBlock Margin="4,0,10,0" Text="빈 셀"/>
            <Border Width="14" Height="14" Background="#1565C0"/>
            <TextBlock Margin="4,0,10,0" Text="적재"/>
            <Border Width="14" Height="14" Background="#7CFC00"/>
            <TextBlock Margin="4,0,10,0" Text="입고예약"/>
            <Border Width="14" Height="14" Background="#008080"/>
            <TextBlock Margin="4,0,10,0" Text="출고예약"/>
            <Border Width="14" Height="14" Background="#800080"/>
            <TextBlock Margin="4,0,10,0" Text="이중격납"/>
            <Border Width="14" Height="14" Background="#DC2626"/>
            <TextBlock Margin="4,0,10,0" Text="공출고"/>
            <Border Width="14" Height="14" Background="#111827"/>
            <TextBlock Margin="4,0,10,0" Text="사용금지"/>
            <Border Width="14" Height="14" Background="#CBD5E1" Opacity="0.52"/>
            <TextBlock Margin="4,0,0,0" Text="제외 셀"/>
        </WrapPanel>

        <Border Grid.Row="3"
                Padding="8"
                CornerRadius="5"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                Background="{DynamicResource AppSurfaceBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="30" Margin="1.5"
                                Background="#203B6A" CornerRadius="3">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="White" FontWeight="Bold" Text="단 / 연"/>
                        </Border>
                        <ItemsControl ItemsSource="{Binding BayHeaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RackHeaderBorderStyle}">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   Text="{Binding Bay, StringFormat={}{0:00}연}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding LevelRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="50" Height="52" Margin="1.5"
                                            Background="#E8EEF8"
                                            BorderBrush="#AFC5E5"
                                            BorderThickness="1"
                                            CornerRadius="3">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#17345C"
                                                   FontWeight="Bold"
                                                   Text="{Binding Level, StringFormat={}{0:00}단}"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource RackCellBorderStyle}"
                                                        MouseLeftButtonDown="RackCell_MouseLeftButtonDown">
                                                    <Border.ToolTip>
                                                        <StackPanel>
                                                            <TextBlock FontWeight="Bold" Text="{Binding DisplayLocation}"/>
                                                            <TextBlock Text="{Binding StatusName}"/>
                                                            <TextBlock Text="{Binding PalletNo, StringFormat='PLT-NO: {0}'}"/>
                                                            <TextBlock Text="{Binding InDate, StringFormat='입고일자: {0}'}"/>
                                                            <TextBlock Text="{Binding InTime, StringFormat='입고시간: {0}'}"/>
                                                        </StackPanel>
                                                    </Border.ToolTip>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Text="{Binding DisplayLocation}"/>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding StatusName}"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSubBrush}"
                       Text="회색으로 표시된 위치는 T2MILSTK에 존재하지 않는 제외 셀입니다."/>
            <ProgressBar Width="170"
                         Height="5"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>
